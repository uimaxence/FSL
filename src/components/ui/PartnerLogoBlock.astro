---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import fallbackImage from "../../assets/histoire-3.jpg";

interface Props {
  name: string;
  href?: string;          // page interne (Fenêtres sur Loir × partenaire)
  externalUrl?: string;   // site officiel du partenaire (bouton "Découvrir")
  tagline?: string;
  logo?: ImageMetadata;
  accentColor?: string;   // couleur dominante du logo pour l'effet ambilight
  class?: string;
}

const {
  name,
  href,
  externalUrl,
  tagline,
  logo,
  accentColor = "var(--color-accent)",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "partner-card group relative rounded-xl ring-1 ring-[var(--color-border)] bg-white p-5 transition-transform duration-300 hover:-translate-y-0.5",
    className,
  ]}
  style={`--ambilight: ${accentColor};`}
>
  {href && (
    <a
      href={href}
      class="absolute inset-0 z-0 rounded-xl"
      aria-label={`Voir notre page partenaire ${name}`}
    ></a>
  )}

  <div class="relative z-[1] pointer-events-none flex flex-col items-center gap-3 text-center">
    {logo ? (
      <div class="w-24 h-24 flex items-center justify-center">
        <Image
          src={logo}
          alt={`Logo ${name} partenaire de Fenêtres sur Loir`}
          widths={[96, 192]}
          sizes="96px"
          loading="lazy"
          decoding="async"
          format="webp"
          quality={90}
          class="max-w-full max-h-full object-contain"
        />
      </div>
    ) : (
      <div class="w-24 h-24 rounded-lg overflow-hidden ring-1 ring-[var(--color-border)]">
        <Image
          src={fallbackImage}
          alt={`Logo ${name} partenaire de Fenêtres sur Loir`}
          widths={[96, 192]}
          sizes="96px"
          loading="lazy"
          decoding="async"
          format="webp"
          quality={82}
          class="w-full h-full object-cover"
        />
      </div>
    )}
    <div>
      <p class="text-sm font-semibold text-[var(--color-fg)]">{name}</p>
      {tagline && <p class="text-xs text-[var(--color-muted)] mt-0.5">{tagline}</p>}
    </div>
  </div>

  {externalUrl && (
    <a
      href={externalUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="discover-btn relative z-[2] mt-4 inline-flex items-center justify-center gap-1.5 w-full rounded-full px-4 py-2 text-xs font-semibold text-[var(--color-fg)] ring-1 ring-[var(--color-border)] transition-all"
      aria-label={`Découvrir le site de ${name} (nouvel onglet)`}
    >
      Découvrir
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="7" y1="17" x2="17" y2="7"/>
        <polyline points="7 7 17 7 17 17"/>
      </svg>
    </a>
  )}
</div>

<style>
  .partner-card {
    transition: box-shadow 0.3s ease, transform 0.2s ease;
  }
  .partner-card:hover {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--ambilight) 30%, transparent),
      0 18px 50px -12px color-mix(in srgb, var(--ambilight) 38%, transparent);
  }
  .partner-card:hover .discover-btn {
    color: var(--ambilight);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ambilight) 55%, transparent);
  }
</style>
