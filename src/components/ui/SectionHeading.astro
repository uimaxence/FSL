---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = "left",
  class: className = "",
} = Astro.props;

const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---

<div class={`max-w-3xl ${alignClass} ${className}`}>
  {eyebrow && (
    <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-[var(--color-accent)] uppercase">
      {eyebrow}
    </p>
  )}
  <h2 set:html={title} />
  {subtitle && (
    <p class="mt-4 text-base sm:text-lg text-[var(--color-muted)] leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
