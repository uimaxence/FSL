---
type Ratio = "16-9" | "4-3" | "1-1" | "3-4" | "video" | "auto";
type Kind = "image" | "video" | "logo";

interface Props {
  label?: string;
  ratio?: Ratio;
  kind?: Kind;
  class?: string;
  rounded?: boolean | "full";
  circle?: boolean;
}

const {
  label = "Image à venir",
  ratio = "16-9",
  kind = "image",
  class: className = "",
  rounded = true,
  circle = false,
} = Astro.props;

const ratioMap: Record<Ratio, string> = {
  "16-9": "aspect-video",
  "4-3": "aspect-[4/3]",
  "1-1": "aspect-square",
  "3-4": "aspect-[3/4]",
  video: "aspect-video",
  auto: "",
};

const ratioClass = ratioMap[ratio];

const radius = circle
  ? "rounded-full"
  : rounded === "full"
    ? "rounded-full"
    : rounded
      ? "rounded-xl"
      : "";

const icon = kind === "video" ? "🎥" : kind === "logo" ? "🏷️" : "📷";
---

<div
  class:list={[
    "placeholder",
    `placeholder--ratio-${ratio}`,
    `placeholder--${kind}`,
    "relative flex items-center justify-center overflow-hidden",
    "bg-[#e5e7eb] border border-dashed border-[#9ca3af]",
    ratioClass,
    radius,
    className,
  ]}
  role="img"
  aria-label={label}
>
  <div class="flex flex-col items-center gap-2 px-4 text-center">
    <span aria-hidden="true" class="text-2xl leading-none select-none">
      {icon}
    </span>
    <span class="text-[11px] sm:text-xs font-medium tracking-wide text-[#6b7280] uppercase max-w-[28ch]">
      {label}
    </span>
  </div>
</div>
