---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import birdLogo from "../../assets/birdfsl.svg";
import { business, social, mainAgence, toE164 } from "../../config/business";

const year = new Date().getFullYear();

const phoneE164 = toE164(mainAgence.telephone);

// Réseaux sociaux réellement renseignés (les autres ne sont pas rendus).
const socials = [
  {
    key: "facebook",
    label: "Facebook",
    href: social.facebook,
    path: "M22 12a10 10 0 1 0-11.6 9.9V14.9H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12z",
  },
  {
    key: "instagram",
    label: "Instagram",
    href: social.instagram,
    // rendu séparément (icône stroke) plus bas
  },
  {
    key: "linkedin",
    label: "LinkedIn",
    href: social.linkedin,
    path: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.6 4.7 6V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21H9z",
  },
].filter((s) => Boolean(s.href));

const navColumns = [
  {
    title: "Nos produits",
    href: "/solutions/confort-interieur",
    links: [
      { label: "Confort intérieur", href: "/solutions/confort-interieur" },
      { label: "Confort extérieur", href: "/solutions/confort-exterieur" },
      { label: "Portes & Fenêtres", href: "/solutions/portes-fenetres" },
    ],
  },
  {
    title: "Notre histoire",
    href: "/entreprise/notre-histoire",
    links: [
      { label: "L'entreprise", href: "/entreprise/notre-histoire" },
      { label: "Nos agences", href: "/agences" },
      { label: "Showroom 300 m²", href: "/entreprise/notre-histoire#showroom" },
    ],
  },
  {
    title: "Nos partenaires",
    href: "/partenaires",
    links: [
      { label: "MéO", href: "/partenaires/meo" },
      { label: "Bubendorff", href: "/partenaires/bubendorff" },
      { label: "Arcades & Baies", href: "/partenaires/arcades-et-baies" },
      { label: "Nos fournisseurs", href: "/partenaires/nos-fournisseurs" },
    ],
  },
  {
    title: "Nos réalisations",
    href: "/realisations",
    links: [
      { label: "Voir les projets", href: "/realisations" },
      { label: "Devis gratuit", href: "/contact" },
    ],
  },
  {
    title: "Zones d'intervention",
    href: "/zones-intervention",
    links: [
      { label: "Menuisier à Angers", href: "/menuisier-angers" },
      { label: "Menuisier à Saumur", href: "/menuisier-saumur" },
      { label: "Menuisier à Baugé-en-Anjou", href: "/menuisier-bauge-en-anjou" },
      { label: "Menuisier à Doué-en-Anjou", href: "/menuisier-doue-en-anjou" },
      { label: "Toutes nos communes", href: "/zones-intervention" },
    ],
  },
  {
    title: "Conseils & Services",
    href: "/conseils-services",
    links: [
      { label: "Le journal", href: "/conseils-services" },
      { label: "Contact", href: "/contact" },
    ],
  },
];
---

<footer class="relative overflow-hidden bg-[#1a1b1f] text-white/85">
  <!-- Decorative bird (logo FSL stylisé). En mobile : plus petit et opacité réduite
       pour ne pas parasiter le texte mais rester visible. -->
  <Image
    src={birdLogo}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="pointer-events-none absolute -left-16 sm:-left-24 -bottom-10 sm:-bottom-16 w-[280px] sm:w-[520px] h-auto opacity-[0.05] sm:opacity-[0.07] select-none"
  />

  <Container width="wide" class="relative pt-14 sm:pt-16 pb-10">
    <!-- Top nav grid (5 cols on desktop) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 lg:gap-10">
      {
        navColumns.map((col) => (
          <div>
            <a
              href={col.href}
              class="block text-[12px] font-semibold uppercase tracking-[0.16em] text-white mb-4 hover:text-[var(--color-accent)] transition-colors"
            >
              {col.title}
            </a>
            <ul class="space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-white/75 hover:text-white transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Big brand mark -->
    <div class="mt-14 sm:mt-16 lg:mt-20 border-t border-white/10 pt-10 sm:pt-12">
      <div class="grid lg:grid-cols-3 gap-8 lg:gap-10 items-end">
        <div class="lg:col-span-2 min-w-0">
          <p class="font-display text-[clamp(2rem,7vw,5.5rem)] leading-[0.95] italic text-white break-words">
            Fenêtres-sur-loir
          </p>
        </div>
        <address class="not-italic text-sm text-white/75 leading-relaxed lg:text-right space-y-1">
          <p class="text-[11px] uppercase tracking-[0.16em] text-white">© {year}, Fenêtres-sur-loir</p>
          <p class="text-[11px] uppercase tracking-[0.16em] text-white/60">All rights reserved</p>
          <p class="mt-3">{mainAgence.adresse}</p>
          <p>{mainAgence.codePostal} {mainAgence.ville}</p>
          <p>
            <a href={`tel:${phoneE164}`} class="hover:text-white transition-colors">{mainAgence.telephone}</a>
          </p>
          <p>
            <a href={`mailto:${business.email}`} class="hover:text-white transition-colors">{business.email}</a>
          </p>
        </address>
      </div>
    </div>

    <!-- Bottom row : legal + social -->
    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href="/mentions-legales" class="text-sm text-white/70 hover:text-white underline underline-offset-4 decoration-white/30 hover:decoration-white transition-colors">
            Mentions légales
          </a>
        </li>
        <li>
          <a href="/politique-cookies" class="text-sm text-white/70 hover:text-white underline underline-offset-4 decoration-white/30 hover:decoration-white transition-colors">
            Politiques de cookies
          </a>
        </li>
      </ul>

      {
        socials.length > 0 && (
          <div class="flex items-center gap-3">
            {socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                target="_blank"
                rel="noopener noreferrer me"
                class="w-9 h-9 inline-flex items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10 text-white/70 hover:text-white hover:bg-white/10 transition-colors"
              >
                {s.key === "instagram" ? (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
                  </svg>
                ) : (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={s.path} />
                  </svg>
                )}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </Container>
</footer>
