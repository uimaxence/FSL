---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import logoFsl from "../../assets/logo_pp.svg";
import portesImg from "../../assets/porte-1-boisalu.png";
import fenetresImg from "../../assets/porte-fenetre-3.png";
import exterieurImg from "../../assets/carport-1.png";
import interieurImg from "../../assets/hero-1.jpg";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const entrepriseLinks = [
  { label: "Notre histoire", href: "/entreprise/notre-histoire" },
  { label: "Notre showroom", href: "/entreprise/notre-histoire#showroom" },
];

const solutionsColumns = [
  {
    title: "Confort intérieur",
    href: "/solutions/confort-interieur",
    image: interieurImg,
    alt: "Confort intérieur murs de lumière verrières par Fenêtres sur Loir",
    items: [
      { label: "Murs de lumière", href: "/solutions/confort-interieur/murs-de-lumiere" },
      { label: "Puits de lumière", href: "/solutions/confort-interieur/puits-de-lumiere" },
      { label: "Verrières", href: "/solutions/confort-interieur/verrieres" },
    ],
  },
  {
    title: "Confort extérieur",
    href: "/solutions/confort-exterieur",
    image: exterieurImg,
    alt: "Aménagements extérieurs carports marquises sur mesure Fenêtres sur Loir",
    items: [
      { label: "Carports & Marquises", href: "/solutions/confort-exterieur/carports-marquises" },
      { label: "Brise-vues & Claustras", href: "/solutions/confort-exterieur/brise-vues-claustras" },
    ],
  },
  {
    title: "Portes",
    href: "/solutions/portes-fenetres",
    image: portesImg,
    alt: "Portes d'entrée bois-aluminium MéO par Fenêtres sur Loir",
    items: [
      { label: "Porte d'entrée", href: "/solutions/portes-fenetres/portes-entree" },
      { label: "Porte-fenêtre", href: "/solutions/portes-fenetres/porte-fenetre" },
      { label: "Porte de garage", href: "/solutions/portes-fenetres/porte-garage" },
      { label: "Portes intérieures", href: "/solutions/portes-fenetres/portes-interieures" },
    ],
  },
  {
    title: "Fenêtres",
    href: "/solutions/portes-fenetres",
    image: fenetresImg,
    alt: "Fenêtres et baies vitrées sur mesure MéO Arcades & Baies par Fenêtres sur Loir",
    items: [
      { label: "Fenêtres", href: "/solutions/portes-fenetres/fenetres" },
      { label: "Baies vitrées", href: "/solutions/portes-fenetres/baies-vitrees" },
      { label: "Volets", href: "/solutions/portes-fenetres/volets" },
    ],
  },
];

const partenairesLinks = [
  { label: "MéO — Menuisier d'Excellence", href: "/partenaires/meo" },
  { label: "Bubendorff — Point Conseil", href: "/partenaires/bubendorff" },
  { label: "Arcades & Baies", href: "/partenaires/arcades-et-baies" },
  { label: "Nos fournisseurs", href: "/partenaires/nos-fournisseurs" },
];

type NavEntry =
  | { label: string; href: string; menu?: undefined }
  | { label: string; href: string; menu: "entreprise" | "solutions" | "partenaires" };

const navItems: NavEntry[] = [
  { label: "L'entreprise", href: "/entreprise/notre-histoire", menu: "entreprise" },
  { label: "Nos solutions", href: "/solutions/confort-interieur", menu: "solutions" },
  { label: "Nos partenaires", href: "/partenaires", menu: "partenaires" },
  { label: "Réalisations", href: "/realisations" },
  { label: "Zones d'intervention", href: "/zones-intervention" },
  { label: "Conseils & Services", href: "/conseils-services" },
];
---

<header
  class="sticky top-9 z-40 transition-colors duration-300 bg-white"
  data-header
  data-header-state="solid"
>
  <Container width="wide" class="flex items-center justify-between h-20 gap-6">
    <a href="/" class="flex items-center shrink-0" aria-label="Fenêtres-sur-Loir — Accueil">
      <img
        src={logoFsl.src}
        alt="Fenêtres-sur-Loir"
        width={logoFsl.width}
        height={logoFsl.height}
        loading="eager"
        decoding="async"
        class="h-12 w-auto object-contain"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-7" aria-label="Navigation principale">
      {
        navItems.map((item) => (
          <div class="relative">
            <a
              href={item.href}
              class:list={[
                "inline-flex items-center gap-1 py-2 text-[14px] font-medium transition-colors whitespace-nowrap",
                isActive(item.href)
                  ? "text-[var(--color-accent)]"
                  : "text-[var(--color-fg)] hover:text-[var(--color-accent)]",
              ]}
              data-menu-trigger={item.menu ?? undefined}
              aria-expanded={item.menu ? "false" : undefined}
              aria-haspopup={item.menu ? "true" : undefined}
            >
              {item.label}
              {item.menu && (
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="mt-0.5 transition-transform duration-200"
                  data-menu-chevron={item.menu}
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              )}
            </a>
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 shrink-0">
      <a
        href="/contact"
        class="hidden sm:inline-flex items-center rounded-full px-5 py-2.5 text-[14px] font-medium text-white transition-colors shadow-sm"
        style="background: var(--color-accent);"
        onmouseover="this.style.background='var(--color-accent-hover)'"
        onmouseout="this.style.background='var(--color-accent)'"
      >
        Demandez un rendez-vous
      </a>
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-md text-[var(--color-fg)] hover:bg-[var(--color-tint-2)]"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        data-mobile-toggle
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </Container>

  <!-- Drop-down L'entreprise -->
  <div
    class="hidden lg:block absolute left-0 right-0 top-full bg-white opacity-0 invisible transition-all duration-200 pointer-events-none border-t border-[var(--color-border)] shadow-md"
    data-menu-panel="entreprise"
  >
    <Container width="wide" class="py-6">
      <ul class="grid grid-cols-2 gap-2 max-w-md">
        {
          entrepriseLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block px-3 py-2 rounded-md text-sm text-[var(--color-fg)] hover:bg-[var(--color-tint)] hover:text-[var(--color-accent)] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </div>

  <!-- Mega-menu Solutions -->
  <div
    class="hidden lg:block absolute left-0 right-0 top-full bg-white opacity-0 invisible transition-all duration-200 pointer-events-none border-t border-[var(--color-border)] shadow-md"
    data-menu-panel="solutions"
  >
    <Container width="wide" class="pb-8 pt-3">
      <div class="grid grid-cols-4 gap-5">
        {
          solutionsColumns.map((col) => (
            <div class="group">
              <a
                href={col.href}
                class="relative block aspect-[4/3] overflow-hidden rounded-xl"
              >
                <Image
                  src={col.image}
                  alt={col.alt}
                  widths={[300, 500, 800]}
                  sizes="(max-width: 1280px) 22vw, 320px"
                  loading="lazy"
                  decoding="async"
                  format="webp"
                  quality={75}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent" />
                <span class="absolute bottom-3 left-4 text-white text-[15px] font-medium underline underline-offset-4 decoration-1">
                  {col.title}
                </span>
                <span class="absolute bottom-3 right-4 text-white">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="7" y1="17" x2="17" y2="7" />
                    <polyline points="7 7 17 7 17 17" />
                  </svg>
                </span>
              </a>
              <ul class="mt-3 space-y-0.5">
                {col.items.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class="block px-2 py-1.5 rounded-md text-[13px] text-[var(--color-muted)] hover:bg-[var(--color-tint)] hover:text-[var(--color-accent)] transition-colors"
                    >
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Container>
  </div>

  <!-- Drop-down Nos partenaires -->
  <div
    class="hidden lg:block absolute left-0 right-0 top-full bg-white opacity-0 invisible transition-all duration-200 pointer-events-none border-t border-[var(--color-border)] shadow-md"
    data-menu-panel="partenaires"
  >
    <Container width="wide" class="py-6">
      <ul class="grid grid-cols-2 gap-2 max-w-2xl">
        {
          partenairesLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block px-3 py-2 rounded-md text-sm text-[var(--color-fg)] hover:bg-[var(--color-tint)] hover:text-[var(--color-accent)] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-[var(--color-border)] bg-white max-h-[calc(100vh-5rem)] overflow-y-auto"
  >
    <Container width="wide" class="py-4">
      <ul class="flex flex-col gap-1">
        <li>
          <details class="group">
            <summary class="flex items-center justify-between px-3 py-3 text-base font-medium text-[var(--color-fg)] rounded-md cursor-pointer list-none hover:bg-[var(--color-tint)]">
              L'entreprise
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-open:rotate-180" aria-hidden="true">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <ul class="ml-3 mb-1 border-l border-[var(--color-border)]">
              {
                entrepriseLinks.map((sub) => (
                  <li>
                    <a href={sub.href} class="block px-3 py-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)]">
                      {sub.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>

        <li>
          <details class="group">
            <summary class="flex items-center justify-between px-3 py-3 text-base font-medium text-[var(--color-fg)] rounded-md cursor-pointer list-none hover:bg-[var(--color-tint)]">
              Nos solutions
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-open:rotate-180" aria-hidden="true">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="ml-3 mb-2 border-l border-[var(--color-border)]">
              {
                solutionsColumns.map((col) => (
                  <div class="py-2">
                    <a href={col.href} class="block px-3 py-1 text-sm font-semibold text-[var(--color-fg)] hover:text-[var(--color-accent)]">
                      {col.title}
                    </a>
                    <ul>
                      {col.items.map((sub) => (
                        <li>
                          <a href={sub.href} class="block px-3 py-1.5 pl-6 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)]">
                            {sub.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </details>
        </li>

        <li>
          <details class="group">
            <summary class="flex items-center justify-between px-3 py-3 text-base font-medium text-[var(--color-fg)] rounded-md cursor-pointer list-none hover:bg-[var(--color-tint)]">
              Nos partenaires
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-open:rotate-180" aria-hidden="true">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <ul class="ml-3 mb-1 border-l border-[var(--color-border)]">
              {
                partenairesLinks.map((sub) => (
                  <li>
                    <a href={sub.href} class="block px-3 py-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)]">
                      {sub.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>

        <li>
          <a href="/realisations" class="block px-3 py-3 text-base font-medium text-[var(--color-fg)] rounded-md hover:bg-[var(--color-tint)] hover:text-[var(--color-accent)]">
            Réalisations
          </a>
        </li>
        <li>
          <a href="/zones-intervention" class="block px-3 py-3 text-base font-medium text-[var(--color-fg)] rounded-md hover:bg-[var(--color-tint)] hover:text-[var(--color-accent)]">
            Zones d'intervention
          </a>
        </li>
        <li>
          <a href="/conseils-services" class="block px-3 py-3 text-base font-medium text-[var(--color-fg)] rounded-md hover:bg-[var(--color-tint)] hover:text-[var(--color-accent)]">
            Conseils & Services
          </a>
        </li>
        <li class="pt-2">
          <a
            href="/contact"
            class="inline-flex w-full items-center justify-center rounded-full px-6 py-3 text-[15px] font-medium text-white shadow-sm"
            style="background: var(--color-accent);"
          >
            Demandez un rendez-vous
          </a>
        </li>
      </ul>
    </Container>
  </div>
</header>

<script>
  // Header scroll behavior — transparent au-dessus du hero, solide après
  (() => {
    const header = document.querySelector<HTMLElement>("header[data-header]");
    const hero = document.querySelector<HTMLElement>("[data-hero-section]");
    if (!header) return;

    if (!hero) {
      header.setAttribute("data-header-state", "solid");
      return;
    }

    let threshold = hero.offsetHeight / 2;
    let ticking = false;

    const apply = () => {
      ticking = false;
      const y = window.scrollY || window.pageYOffset;
      header.setAttribute("data-header-state", y > threshold ? "solid" : "transparent");
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };

    const onResize = () => {
      threshold = hero.offsetHeight / 2;
      apply();
    };

    apply();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
  })();

  // Mobile menu toggle
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  // Desktop dropdowns (hover + focus, multi-panel)
  const triggers = document.querySelectorAll<HTMLElement>("[data-menu-trigger]");
  const panels = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>("[data-menu-panel]").forEach((p) => {
    const name = p.getAttribute("data-menu-panel");
    if (name) panels.set(name, p);
  });
  const closeTimers = new Map<string, number>();

  const openPanel = (name: string, trigger: HTMLElement) => {
    const panel = panels.get(name);
    if (!panel) return;
    window.clearTimeout(closeTimers.get(name));

    // Close any other open panel
    panels.forEach((p, n) => {
      if (n !== name) {
        p.classList.add("invisible", "pointer-events-none");
        p.style.opacity = "0";
      }
    });
    document.querySelectorAll<HTMLElement>("[data-menu-trigger]").forEach((t) => {
      if (t.getAttribute("data-menu-trigger") !== name) {
        t.setAttribute("aria-expanded", "false");
        const ch = t.querySelector<SVGElement>("[data-menu-chevron]");
        if (ch) ch.style.transform = "";
      }
    });

    panel.classList.remove("invisible", "pointer-events-none");
    panel.style.opacity = "1";
    trigger.setAttribute("aria-expanded", "true");
    const ch = trigger.querySelector<SVGElement>("[data-menu-chevron]");
    if (ch) ch.style.transform = "rotate(180deg)";
  };

  const closePanel = (name: string, trigger: HTMLElement) => {
    const panel = panels.get(name);
    if (!panel) return;
    const t = window.setTimeout(() => {
      panel.classList.add("invisible", "pointer-events-none");
      panel.style.opacity = "0";
      trigger.setAttribute("aria-expanded", "false");
      const ch = trigger.querySelector<SVGElement>("[data-menu-chevron]");
      if (ch) ch.style.transform = "";
    }, 140);
    closeTimers.set(name, t);
  };

  triggers.forEach((trigger) => {
    const name = trigger.getAttribute("data-menu-trigger");
    if (!name) return;
    const panel = panels.get(name);
    if (!panel) return;

    trigger.addEventListener("mouseenter", () => openPanel(name, trigger));
    trigger.addEventListener("focus", () => openPanel(name, trigger));
    panel.addEventListener("mouseenter", () => openPanel(name, trigger));
    trigger.addEventListener("mouseleave", () => closePanel(name, trigger));
    panel.addEventListener("mouseleave", () => closePanel(name, trigger));
  });

  // Close panels on ESC
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      panels.forEach((p, name) => {
        p.classList.add("invisible", "pointer-events-none");
        p.style.opacity = "0";
        const trigger = document.querySelector<HTMLElement>(`[data-menu-trigger="${name}"]`);
        if (trigger) {
          trigger.setAttribute("aria-expanded", "false");
          const ch = trigger.querySelector<SVGElement>("[data-menu-chevron]");
          if (ch) ch.style.transform = "";
        }
      });
    }
  });
</script>
