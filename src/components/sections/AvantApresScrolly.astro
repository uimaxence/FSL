---
// Séquence « avant / après » pilotée au défilement.
//
// Une série d'images (extraites d'une vidéo) est dessinée sur un <canvas>
// épinglé (sticky) pendant que la page défile : la façade passe des anciennes
// menuiseries aux nouvelles, puis le message apparaît à mi-parcours.
//
// Textes, images et boutons sont des props : le composant se réutilise sur
// n'importe quelle page (hero ou section). Deux séries d'images sont servies :
// 1280 px pour les écrans larges, 720 px en dessous de 640 px de large.
// Le chargement démarre quand la section approche de l'écran.
// prefers-reduced-motion : image finale et texte affichés d'emblée.
interface Props {
  /** Surtitre (petit texte en capitales au-dessus du titre) */
  eyebrow?: string;
  /** Première ligne du titre, en plus petit (ex. « Portes et fenêtres sur mesure : ») */
  titrePrefixe?: string;
  /** Titre principal, avant la partie mise en avant */
  titre: string;
  /** Partie du titre en gras italique (ex. « cachet ») */
  titreFort?: string;
  /** Suite du titre après la partie forte */
  titreSuite?: string;
  sousTitre?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Niveau de titre : « h1 » si la section est le hero de la page */
  heading?: "h1" | "h2";
  /** Hero : passe sous le header (rendu transparent) comme sur l'accueil */
  hero?: boolean;
  frameCount?: number;
  /** Préfixe des images écran large (suivi de 001.webp, 002.webp…) */
  framePath?: string;
  /** Préfixe des images mobile (< 640 px) */
  framePathMobile?: string;
  altAvant?: string;
  altApres?: string;
  /** Hauteur de la piste de défilement */
  hauteur?: string;
}

const {
  eyebrow = "Avant / après",
  titrePrefixe,
  titre,
  titreFort,
  titreSuite,
  sousTitre,
  ctaLabel = "Demander un devis gratuit",
  ctaHref = "/contact/",
  secondaryLabel,
  secondaryHref,
  heading = "h2",
  hero = false,
  frameCount = 61,
  framePath = "/avant-apres/frames/frame-",
  framePathMobile = "/avant-apres/frames-mobile/frame-",
  altAvant = "Maison en pierre avant le remplacement de ses menuiseries",
  altApres = "La même maison après la pose de fenêtres, porte d'entrée, volets et pergola sur mesure",
  hauteur = "340vh",
} = Astro.props;

const Heading = heading;
const pad = (i: number) => String(i).padStart(3, "0");
const firstFrame = `${framePath}${pad(1)}.webp`;
const firstFrameMobile = `${framePathMobile}${pad(1)}.webp`;
const lastFrame = `${framePath}${pad(frameCount)}.webp`;
---

<section
  class:list={["relative bg-[var(--color-fg)]", hero && "-mt-[116px]"]}
  style={`height: ${hauteur};`}
  data-scrolly
  data-frame-count={frameCount}
  data-frame-path={framePath}
  data-frame-path-mobile={framePathMobile}
  {...(hero ? { "data-hero-section": true } : {})}
  aria-label="Avant / après : une maison rénovée avec des menuiseries Fenêtres sur Loir"
>
  <div class="sticky top-0 overflow-hidden" style="height: 100vh; height: 100dvh;">
    <!-- Première image en <img> : affichage immédiat, et rendu sans JavaScript -->
    <picture>
      <source media="(max-width: 639px)" srcset={firstFrameMobile} type="image/webp" />
      <img
        src={firstFrame}
        alt={altAvant}
        width="1200"
        height="669"
        class="absolute inset-0 w-full h-full object-cover"
        fetchpriority={hero ? "high" : "auto"}
        loading={hero ? "eager" : "lazy"}
        decoding="async"
      />
    </picture>
    <canvas class="absolute inset-0 w-full h-full" data-scrolly-canvas aria-hidden="true"></canvas>

    <div
      class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-black/60 to-transparent pointer-events-none"
      aria-hidden="true"
    ></div>
    <!-- Voile qui s'assombrit avec l'arrivée du texte -->
    <div class="absolute inset-0 bg-black pointer-events-none" style="opacity: 0;" data-scrolly-veil aria-hidden="true"></div>

    <!-- Message central : apparaît vers le milieu du parcours -->
    <div
      class="absolute inset-0 z-10 flex items-center justify-center px-6 text-center will-change-[opacity,transform]"
      style="opacity: 0; transform: translateY(28px);"
      data-scrolly-text
    >
      <div class="max-w-3xl">
        {eyebrow && (
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">{eyebrow}</p>
        )}
        <Heading
          class="mt-4 font-display text-white text-[clamp(2.25rem,5.5vw,4.25rem)] leading-[1.08] text-balance drop-shadow-[0_2px_18px_rgba(0,0,0,0.5)]"
        >
          {titrePrefixe && (
            <>
              <span class="block text-[0.45em] font-normal tracking-wide text-white/85 mb-3">{titrePrefixe}</span>{" "}
            </>
          )}
          {titre}
          {titreFort && (
            <>
              {" "}<strong class="font-bold italic">{titreFort}</strong>
            </>
          )}
          {titreSuite && <> {titreSuite}</>}
        </Heading>
        {sousTitre && (
          <p class="mt-5 mx-auto max-w-xl text-[15px] sm:text-lg text-white/85 leading-relaxed">{sousTitre}</p>
        )}
        <div
          class="mt-8 flex flex-wrap items-center justify-center gap-3 will-change-[opacity,transform]"
          style="opacity: 0; transform: translateY(16px);"
          data-scrolly-cta
        >
          <a
            href={ctaHref}
            class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[var(--color-accent-hover)]"
          >
            {ctaLabel}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
          {secondaryLabel && secondaryHref && (
            <a
              href={secondaryHref}
              class="inline-flex items-center rounded-full border border-white/60 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-white hover:text-[var(--color-fg)]"
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Barre basse : pastille Avant / Après + invitation à défiler -->
    <div class="absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-4 px-5 pb-6 sm:px-8 sm:pb-8 pointer-events-none">
      <div
        class="relative inline-flex h-9 min-w-[5.5rem] items-center justify-center rounded-full bg-white/15 px-4 text-[12px] font-semibold uppercase tracking-[0.16em] text-white backdrop-blur-sm ring-1 ring-white/25"
        aria-live="polite"
      >
        <span class="absolute inset-0 inline-flex items-center justify-center" data-scrolly-label-avant>Avant</span>
        <span class="absolute inset-0 inline-flex items-center justify-center" style="opacity: 0;" data-scrolly-label-apres>Après</span>
      </div>
      <div class="flex flex-col items-center gap-1.5 text-[12px] font-medium tracking-wide text-white/90" data-scrolly-hint>
        <span class="hidden sm:inline">Faites défiler pour voir la transformation</span>
        <span class="sm:hidden">Faites défiler</span>
        <svg class="animate-bounce" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </div>
      <div class="hidden sm:block min-w-[5.5rem]" aria-hidden="true"></div>
    </div>

    <!-- Progression du chargement des images -->
    <div class="absolute inset-x-0 bottom-0 h-[3px] bg-white/10 transition-opacity duration-500" data-scrolly-loader>
      <div class="h-full bg-[var(--color-accent)] transition-[width] duration-150" style="width: 0%;" data-scrolly-loader-bar></div>
    </div>
  </div>
</section>

<!-- Sans JavaScript : l'image finale -->
<noscript>
  <img src={lastFrame} alt={altApres} class="w-full h-auto" />
</noscript>

<script>
  // Une instance par section [data-scrolly] présente dans la page.
  for (const section of document.querySelectorAll<HTMLElement>("[data-scrolly]")) {
    const canvas = section.querySelector<HTMLCanvasElement>("[data-scrolly-canvas]");
    const ctx = canvas?.getContext("2d");
    const stage = canvas?.parentElement;
    const text = section.querySelector<HTMLElement>("[data-scrolly-text]");
    const cta = section.querySelector<HTMLElement>("[data-scrolly-cta]");
    const veil = section.querySelector<HTMLElement>("[data-scrolly-veil]");
    const hint = section.querySelector<HTMLElement>("[data-scrolly-hint]");
    const labelAvant = section.querySelector<HTMLElement>("[data-scrolly-label-avant]");
    const labelApres = section.querySelector<HTMLElement>("[data-scrolly-label-apres]");
    const loader = section.querySelector<HTMLElement>("[data-scrolly-loader]");
    const loaderBar = section.querySelector<HTMLElement>("[data-scrolly-loader-bar]");

    const count = Number(section.dataset.frameCount ?? 0);
    const mobile = window.matchMedia("(max-width: 639px)").matches;
    const path = (mobile && section.dataset.framePathMobile) || section.dataset.framePath || "";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!canvas || !ctx || !stage || count <= 0) continue;

    const frames: (HTMLImageElement | null)[] = new Array(count).fill(null);
    let loaded = 0;
    let current = -1; // index de l'image actuellement dessinée
    let target = 0; // index souhaité d'après le scroll
    let ticking = false;
    let cw = 0;
    let ch = 0;

    const srcOf = (i: number) => `${path}${String(i + 1).padStart(3, "0")}.webp`;

    const smooth = (a: number, b: number, x: number) => {
      const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cw = stage.clientWidth;
      ch = stage.clientHeight;
      canvas.width = Math.round(cw * dpr);
      canvas.height = Math.round(ch * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      current = -1;
    };

    // Dessine l'image i (ou, si elle n'est pas encore chargée, la plus
    // proche déjà disponible en dessous) en remplissant tout le canvas.
    const draw = (i: number) => {
      let j = Math.min(i, count - 1);
      while (j >= 0 && !frames[j]) j--;
      if (j < 0 || j === current) return;
      const img = frames[j]!;
      const s = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * s;
      const h = img.naturalHeight * s;
      ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
      current = j;
    };

    const update = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const travel = Math.max(1, section.offsetHeight - window.innerHeight);
      const p = reduced ? 1 : Math.min(1, Math.max(0, -rect.top / travel));

      // La séquence complète se joue sur les 70 premiers % du parcours, avec
      // un léger ralenti au début (la transformation occupe le premier tiers
      // de la vidéo) pour qu'elle se termine juste avant l'arrivée du texte.
      target = Math.round(Math.pow(Math.min(1, p / 0.7), 1.5) * (count - 1));
      draw(target);

      const tText = smooth(0.42, 0.58, p);
      if (text) {
        text.style.opacity = String(tText);
        text.style.transform = `translateY(${((1 - tText) * 28).toFixed(1)}px)`;
      }
      const tCta = smooth(0.56, 0.7, p);
      if (cta) {
        cta.style.opacity = String(tCta);
        cta.style.transform = `translateY(${((1 - tCta) * 16).toFixed(1)}px)`;
      }
      if (veil) veil.style.opacity = String((0.42 * tText).toFixed(3));
      if (hint) hint.style.opacity = String(1 - smooth(0.02, 0.1, p));
      if (labelAvant) labelAvant.style.opacity = String(1 - smooth(0.16, 0.28, p));
      if (labelApres) labelApres.style.opacity = String(smooth(0.2, 0.32, p));
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const load = (i: number) =>
      new Promise<void>((resolve) => {
        const img = new Image();
        img.decoding = "async";
        img.onload = () => {
          frames[i] = img;
          loaded++;
          if (loaderBar) loaderBar.style.width = `${(loaded / count) * 100}%`;
          if (loaded === count && loader) loader.style.opacity = "0";
          if (i <= target && i > current) draw(target);
          resolve();
        };
        img.onerror = () => {
          loaded++;
          resolve();
        };
        img.src = srcOf(i);
      });

    const preload = async () => {
      await load(0);
      const batch = 8;
      for (let i = 1; i < count; i += batch) {
        await Promise.all(Array.from({ length: Math.min(batch, count - i) }, (_, k) => load(i + k)));
      }
    };

    if (reduced) section.style.height = "100vh";

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      resize();
      update();
      preload();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", () => {
        resize();
        update();
      });
    };

    // Le chargement des images ne démarre que lorsque la section approche
    // de l'écran (immédiat quand elle est en tête de page).
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            start();
          }
        },
        { rootMargin: "100% 0px" },
      );
      io.observe(section);
    } else {
      start();
    }
  }
</script>
