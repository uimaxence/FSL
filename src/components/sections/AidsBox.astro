---
import Container from "../ui/Container.astro";

interface Props {
  title?: string;
  pdfHref?: string;
  class?: string;
}

const {
  title = "Bénéficiez des aides à la rénovation énergétique",
  pdfHref = "#",
  class: className = "",
} = Astro.props;

const aids = ["MaPrimeRénov'", "TVA réduite 5,5 %", "CEE", "Crédit d'impôt"];
---

<section class:list={["pb-12", className]}>
  <Container width="default">
    <div class="max-w-3xl mx-auto rounded-2xl bg-gradient-to-br from-[var(--color-tint)] via-white to-[var(--color-tint)] ring-1 ring-[var(--color-accent)]/15 shadow-sm p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <span
          class="shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-full bg-white text-[var(--color-accent)]"
          aria-hidden="true"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 1v22"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </span>
        <div class="flex-1">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">
            Fenêtres sur Loir — Certifié RGE Qualibat
          </p>
          <h3 class="mt-1 text-[var(--color-fg)]">{title}</h3>
          <p class="mt-3 text-[14px] text-[var(--color-muted)] leading-relaxed">
            En tant que partenaire certifié, nous vous accompagnons dans les démarches pour obtenir les
            aides de l'État au changement de vos menuiseries extérieures et intérieures.
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              aids.map((aid) => (
                <li class="inline-flex items-center px-2.5 py-1 text-[11px] font-semibold text-[var(--color-accent)] bg-white rounded-full ring-1 ring-[var(--color-accent)]/20">
                  {aid}
                </li>
              ))
            }
          </ul>
          <a
            href={pdfHref}
            class="mt-5 inline-flex items-center gap-1.5 text-[14px] font-medium text-[var(--color-accent)] hover:underline"
            {...pdfHref.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {}}
          >
            Voir la documentation des dispositifs d'aides
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>
