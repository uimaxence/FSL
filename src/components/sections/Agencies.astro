---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import showroomImg from "../../assets/showroom-2.png";
import agenceDoueImg from "../../assets/deventure_doué.png";
import { AGENCES, addressOneLine, openingHoursHuman } from "../../config/business";

const hours = [...openingHoursHuman];

const agencies = [
  {
    name: AGENCES.seiches.ville,
    status: "Showroom ouvert",
    statusTone: "open",
    address: addressOneLine(AGENCES.seiches),
    phone: AGENCES.seiches.telephone,
    hours,
    image: showroomImg,
  },
  {
    name: AGENCES.doue.ville,
    status: "Showroom ouvert",
    statusTone: "open",
    address: addressOneLine(AGENCES.doue),
    phone: AGENCES.doue.telephone,
    hours,
    image: agenceDoueImg,
  },
];
---

<section class="section">
  <Container width="wide">
    <SectionHeading
      eyebrow="Nos agences"
      title="Venez nous rencontrer"
      subtitle="Deux adresses pour échanger sur votre projet, toucher les matières et imaginer vos menuiseries grandeur nature."
      align="center"
      class="mb-14"
    />

    <ul class="grid gap-6 md:grid-cols-2">
      {agencies.map((a) => (
        <li class="bg-white rounded-2xl ring-1 ring-[var(--color-border)] overflow-hidden flex flex-col">
          {a.image ? (
            <Image
              src={a.image}
              alt={`Showroom Fenêtres sur Loir à ${a.name}`}
              widths={[500, 800, 1100]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-video object-cover"
            />
          ) : null}
          <div class="p-6 flex flex-col flex-1">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-3 mb-3">
              <h3 class="text-xl font-semibold order-2 sm:order-1">{a.name}</h3>
              <span class:list={[
                "self-start order-1 sm:order-2 inline-flex items-center gap-1.5 whitespace-nowrap text-xs font-semibold px-2.5 py-1 rounded-full",
                a.statusTone === "open"
                  ? "bg-green-50 text-green-700"
                  : "bg-amber-50 text-amber-700",
              ]}>
                <span class:list={[
                  "w-1.5 h-1.5 rounded-full shrink-0",
                  a.statusTone === "open" ? "bg-green-500" : "bg-amber-500",
                ]} />
                {a.status}
              </span>
            </div>
            <p class="text-sm text-[var(--color-muted)] mb-2">{a.address}</p>
            <p class="text-sm font-medium mb-4">
              <a href={`tel:${a.phone.replace(/\s/g, "")}`} class="hover:text-[var(--color-accent)]">
                {a.phone}
              </a>
            </p>
            <ul class="text-sm text-[var(--color-muted)] space-y-1 mb-6">
              {a.hours.map((h) => <li>{h}</li>)}
            </ul>
            <div class="mt-auto">
              <Button href="/contact/" variant="outline">Demandez un rendez-vous</Button>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </Container>
</section>
