---
// Popup devis. Lecture PostHog du 27/10/2026 : affichée après 15 s sur toutes
// les pages, elle était fermée dans 43 % des sessions (315) pour 5 clics sur
// son bouton. Elle n'apparaît plus que pour un visiteur engagé (temps de
// lecture ET défilement), et BaseLayout ne l'inclut pas sur la page contact,
// les guides et les pages légales.
import { Image } from "astro:assets";
import porteAlu from "../../assets/porte-4-alu.png";

interface Props {
  /** Temps de lecture minimum avant l'apparition (ms). */
  attenteMs?: number;
  /** Part de la page à avoir fait défiler avant l'apparition (0 à 1). */
  seuilScroll?: number;
}

const { attenteMs = 20000, seuilScroll = 0.5 } = Astro.props;
---

<aside
  id="devis-popup"
  class="fixed left-4 bottom-4 sm:left-5 sm:bottom-5 z-50 w-[min(360px,calc(100vw-2rem))] opacity-0 translate-y-4 invisible transition-all duration-500 ease-out pointer-events-none"
  data-devis-popup
  data-attente={attenteMs}
  data-scroll={seuilScroll}
  aria-hidden="true"
  aria-label="Démarrez votre projet de menuiserie"
>
  <div class="relative rounded-2xl bg-white shadow-2xl ring-1 ring-black/5 overflow-hidden">
    <button
      type="button"
      class="absolute top-2.5 right-2.5 z-10 inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/95 ring-1 ring-black/10 text-[var(--color-fg)] hover:bg-[var(--color-tint)] transition-colors"
      data-devis-popup-close
      aria-label="Fermer"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="aspect-[16/10] relative overflow-hidden">
      <Image
        src={porteAlu}
        alt="Démarrez votre projet de menuiserie sur mesure avec Fenêtres sur Loir"
        widths={[360, 600]}
        sizes="360px"
        loading="lazy"
        decoding="async"
        format="webp"
        quality={75}
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>
      <span
        class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-white rounded-full"
        style="background: var(--color-accent);"
      >
        Offert · 48 h
      </span>
      <h3 class="absolute bottom-3 left-4 right-12 text-white text-[18px] leading-tight font-display">
        Où en est votre projet&nbsp;?
      </h3>
    </div>

    <div class="p-5">
      <p class="text-sm text-[var(--color-muted)] leading-relaxed">
        Devis gratuit sous 48 h, conseil personnalisé et visite du showroom à Seiches-sur-le-Loir.
      </p>
      <div class="mt-4 flex flex-col gap-2">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center rounded-full px-5 py-2.5 text-[14px] font-medium text-white shadow-sm transition-colors"
          style="background: var(--color-accent);"
          onmouseover="this.style.background='var(--color-accent-hover)'"
          onmouseout="this.style.background='var(--color-accent)'"
          data-devis-popup-cta
        >
          Demander mon devis
        </a>
        <button
          type="button"
          class="text-[12px] text-[var(--color-muted)] hover:text-[var(--color-fg)] underline underline-offset-2"
          data-devis-popup-later
        >
          Peut-être plus tard
        </button>
      </div>
    </div>
  </div>
</aside>

<script>
  const STORAGE_KEY = "fsl-devis-popup-dismissed";
  // Le stockage peut être indisponible (navigation privée, données bloquées) :
  // dans ce cas la popup se comporte comme pour un premier passage.
  const lire = (stockage: Storage) => {
    try {
      return stockage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  };
  const ecrire = (stockage: Storage) => {
    try {
      stockage.setItem(STORAGE_KEY, "1");
    } catch {
      /* rien : la popup reviendra à la prochaine page */
    }
  };

  const popup = document.getElementById("devis-popup");
  if (popup && !lire(sessionStorage) && !lire(localStorage)) {
    const attente = Number(popup.getAttribute("data-attente") ?? 20000);
    const seuil = Number(popup.getAttribute("data-scroll") ?? 0.5);
    let tempsEcoule = false;
    let scrollAtteint = false;
    let affichee = false;

    const show = () => {
      popup.classList.remove("opacity-0", "translate-y-4", "invisible", "pointer-events-none");
      popup.classList.add("opacity-100", "translate-y-0");
      popup.setAttribute("aria-hidden", "false");
    };

    const hide = (persistent = false) => {
      popup.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
      popup.classList.remove("opacity-100", "translate-y-0");
      popup.setAttribute("aria-hidden", "true");
      window.setTimeout(() => popup.classList.add("invisible"), 500);
      ecrire(persistent ? localStorage : sessionStorage);
    };

    // Apparition quand les deux conditions sont réunies : temps de lecture
    // minimum et moitié de la page défilée (une page trop courte pour défiler
    // compte comme défilée).
    const essayer = () => {
      if (affichee || !tempsEcoule || !scrollAtteint) return;
      affichee = true;
      show();
    };
    const surScroll = () => {
      const hauteur = document.documentElement.scrollHeight - window.innerHeight;
      if (hauteur <= 0 || window.scrollY / hauteur >= seuil) {
        scrollAtteint = true;
        window.removeEventListener("scroll", surScroll);
        essayer();
      }
    };

    window.setTimeout(() => {
      tempsEcoule = true;
      essayer();
    }, attente);
    window.addEventListener("scroll", surScroll, { passive: true });
    surScroll();

    popup.querySelector("[data-devis-popup-close]")?.addEventListener("click", () => hide(true));
    popup.querySelector("[data-devis-popup-later]")?.addEventListener("click", () => hide(false));
    popup.querySelector("[data-devis-popup-cta]")?.addEventListener("click", () => hide(true));
  }
</script>
