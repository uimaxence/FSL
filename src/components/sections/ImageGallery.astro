---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";

import g1 from "../../assets/histoire-3.jpg";
import g2 from "../../assets/verriere-2.png";
import g3 from "../../assets/realisation-pontsdece-3.jpg";
import g4 from "../../assets/murdelumiere-1.png";
import g5 from "../../assets/histoire-6.jpg";
import g6 from "../../assets/realisation-precigne-2.jpg";
import g7 from "../../assets/carport-1.png";
import g8 from "../../assets/histoire-7.jpg";

const items = [
  { src: g1, alt: "Showroom Fenêtres sur Loir à Seiches-sur-le-Loir", wide: true },
  { src: g2, alt: "Verrière intérieure sur mesure MéO" },
  { src: g3, alt: "Réalisation menuiserie aux Ponts-de-Cé" },
  { src: g4, alt: "Mur de lumière bois-alu MéO" },
  { src: g5, alt: "Pose de menuiserie par l'équipe Fenêtres sur Loir", wide: true },
  { src: g6, alt: "Rénovation de menuiseries à Précigné" },
  { src: g7, alt: "Carport aluminium sur mesure" },
  { src: g8, alt: "Conseillère Fenêtres sur Loir en showroom" },
];
---

<section class="section-tight">
  <Container width="wide">
    <ul class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      {
        items.map((item, i) => (
          <li class={item.wide ? "md:col-span-2" : ""}>
            <div class="overflow-hidden rounded-xl ring-1 ring-[var(--color-border)] h-full group">
              <Image
                src={item.src}
                alt={item.alt}
                widths={[400, 700, 1000]}
                sizes={item.wide ? "(max-width: 768px) 100vw, 50vw" : "(max-width: 768px) 50vw, 25vw"}
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
                format="webp"
                quality={78}
                class:list={[
                  "w-full h-full object-cover transition-transform duration-500 group-hover:scale-105",
                  item.wide ? "aspect-[2/1]" : "aspect-square",
                ]}
              />
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
