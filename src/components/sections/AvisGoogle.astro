---
// Section avis Google — alimentée par src/lib/avis.ts (agrégats réels des
// deux fiches + avis textuels). Les cartes se fondent dans le fond en bas
// de section ; le lien « Voir tous les avis » prend le relais.
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import { avisGlobal, avisGoogle } from "../../lib/avis";

import meoLogo from "../../assets/meo-logo.png";

// 2 colonnes quand il y a peu d'avis, 3 dès que l'API en fournit assez —
// et répartition « au plus court » (pondérée par la longueur du texte)
// pour que les colonnes finissent à peu près à la même hauteur.
// Au plus 12 cartes (les avis API, plus récents, passent en premier).
const avisAffiches = avisGoogle.slice(0, 12);
const nbColonnes = avisAffiches.length >= 6 ? 3 : 2;
const colonnes: (typeof avisGoogle)[] = Array.from({ length: nbColonnes }, () => []);
const hauteurs = new Array(nbColonnes).fill(0);
for (const avis of avisAffiches) {
  const i = hauteurs.indexOf(Math.min(...hauteurs));
  colonnes[i].push(avis);
  // ~120 « caractères équivalents » de hauteur fixe par carte (étoiles + pied).
  hauteurs[i] += 120 + avis.texte.length;
}

// Décalages verticaux façon « masonry ».
const offsets = nbColonnes === 3 ? ["md:pt-10", "md:pt-0", "md:pt-16"] : ["md:pt-8", "md:pt-0"];

/** Initiales pour l'avatar (ex. « Julien D. » → « JD »). */
function initiales(nom: string): string {
  return nom
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((m) => m[0].toUpperCase())
    .join("");
}
---

<section class="section bg-white">
  <Container width="wide">
    <!-- Titre + badges de preuve -->
    <div class="text-center max-w-3xl mx-auto">
      <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-[var(--color-accent)] uppercase">
        Avis Google
      </p>
      <h2>
        On n'est pas Menuisiers<br />d'Excellence de France pour rien.
      </h2>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <!-- Badge note Google (lien vers la fiche) -->
        <a
          href={avisGlobal.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 rounded-full border border-black/8 bg-white px-4 py-2 text-[13px] font-medium text-[var(--color-fg)] shadow-sm hover:shadow-md transition-shadow"
          aria-label={`${avisGlobal.noteAffichee} sur 5 étoiles — ${avisGlobal.total} avis Google, voir la fiche`}
        >
          <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3a12 12 0 1 1-3.3-13l5.7-5.7A20 20 0 1 0 44 24c0-1.2-.1-2.4-.4-3.5z"/>
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8A12 12 0 0 1 24 12c3 0 5.7 1.1 7.8 3l5.7-5.7A20 20 0 0 0 6.3 14.7z"/>
            <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3A12 12 0 0 1 12.7 28l-6.5 5A20 20 0 0 0 24 44z"/>
            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3a12 12 0 0 1-4.1 5.5l6.3 5.3C37.2 39.6 44 34.7 44 24c0-1.2-.1-2.4-.4-3.5z"/>
          </svg>
          <span class="flex text-amber-400" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(() => (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </span>
          <span><strong>{avisGlobal.noteAffichee}/5</strong> · {avisGlobal.total} avis Google</span>
        </a>

        <!-- Badge Menuisier d'Excellence MéO -->
        <span
          class="inline-flex items-center gap-2.5 rounded-full border border-black/8 bg-white px-4 py-2 text-[13px] font-medium text-[var(--color-fg)] shadow-sm"
        >
          <Image src={meoLogo} alt="MéO" height={20} loading="lazy" decoding="async" class="h-5 w-auto" />
          <span>Menuisier d'Excellence de France</span>
        </span>
      </div>
    </div>

    <!-- Cartes d'avis : colonnes décalées équilibrées -->
    <div class="mt-12 md:mt-16">
      <div
        class:list={[
          "grid gap-5 lg:gap-6 items-start",
          nbColonnes === 3 ? "md:grid-cols-3" : "md:grid-cols-2",
        ]}
      >
        {
          colonnes.map((col, i) => (
            <div class:list={["flex flex-col gap-5 lg:gap-6", offsets[i]]}>
              {col.map((avis) => (
                <article class="bg-[var(--color-tint)] rounded-2xl p-5 lg:p-6">
                  <div class="flex items-center justify-between">
                    <div
                      class="flex text-amber-400"
                      role="img"
                      aria-label={`${avis.note} sur 5 étoiles`}
                    >
                      {Array.from({ length: avis.note }).map(() => (
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                      ))}
                    </div>
                    <svg width="14" height="14" viewBox="0 0 48 48" aria-hidden="true" class="opacity-80">
                      <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3a12 12 0 1 1-3.3-13l5.7-5.7A20 20 0 1 0 44 24c0-1.2-.1-2.4-.4-3.5z"/>
                      <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8A12 12 0 0 1 24 12c3 0 5.7 1.1 7.8 3l5.7-5.7A20 20 0 0 0 6.3 14.7z"/>
                      <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3A12 12 0 0 1 12.7 28l-6.5 5A20 20 0 0 0 24 44z"/>
                      <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3a12 12 0 0 1-4.1 5.5l6.3 5.3C37.2 39.6 44 34.7 44 24c0-1.2-.1-2.4-.4-3.5z"/>
                    </svg>
                  </div>

                  <p class="mt-3.5 text-[13.5px] leading-relaxed text-[var(--color-fg)]">
                    {avis.texte}
                  </p>

                  <div class="mt-4 flex items-center gap-2.5">
                    <span
                      class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] text-[11px] font-bold"
                      aria-hidden="true"
                    >
                      {initiales(avis.auteur)}
                    </span>
                    <span class="text-[13px] font-semibold text-[var(--color-fg)]">{avis.auteur}</span>
                    <span class="ml-auto text-[11.5px] text-[var(--color-muted)]">
                      {avis.dateRelative ?? avis.localisation}
                    </span>
                  </div>
                </article>
              ))}
            </div>
          ))
        }
      </div>

    </div>

    <!-- Liens vers la fiche Google -->
    <div class="mt-10 md:mt-12 flex flex-wrap items-center justify-center gap-3">
      <a
        href={avisGlobal.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-full px-6 py-2.5 text-[14px] font-medium text-white shadow-md transition-colors"
        style="background: var(--color-accent);"
        onmouseover="this.style.background='var(--color-accent-hover)'"
        onmouseout="this.style.background='var(--color-accent)'"
      >
        Voir les {avisGlobal.total} avis sur Google
      </a>
      <a
        href={avisGlobal.writeReviewUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-full border border-[var(--color-accent)]/30 px-6 py-2.5 text-[14px] font-medium text-[var(--color-accent)] hover:bg-[var(--color-accent)]/5 transition-colors"
      >
        Laisser un avis
      </a>
    </div>
  </Container>
</section>
