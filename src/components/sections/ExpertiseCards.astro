---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import interieurImg from "../../assets/murdelumiere-1.png";
import exterieurImg from "../../assets/carport-1.png";
import portesImg from "../../assets/porte-1-boisalu.png";

const expertises = [
  {
    title: "Confort intérieur",
    description: "Murs et puits de lumière, verrières sur mesure — apportez lumière et isolation à votre intérieur.",
    href: "/solutions/confort-interieur/",
    image: interieurImg,
  },
  {
    title: "Confort extérieur",
    description: "Carports, marquises, brise-vues et claustras : aménagez votre extérieur pour toutes les saisons.",
    href: "/solutions/confort-exterieur/",
    image: exterieurImg,
  },
  {
    title: "Portes & Fenêtres",
    description: "Fenêtres, portes d'entrée, baies vitrées et volets — sur mesure, bois, alu ou PVC.",
    href: "/solutions/portes-fenetres/",
    image: portesImg,
  },
];
---

<section class="section bg-[var(--color-tint)]">
  <Container width="wide">
    <SectionHeading
      eyebrow="Nos domaines d'expertise"
      title="Trois univers, <br/>un seul artisan"
      subtitle="De l'isolation thermique à l'esthétique architecturale, nous couvrons l'ensemble des menuiseries de votre maison."
      align="center"
      class="mb-14"
    />

    <ul class="grid gap-6 md:grid-cols-3">
      {expertises.map((item) => (
        <li class="group">
          <a href={item.href} class="block h-full bg-white rounded-2xl ring-1 ring-[var(--color-border)] p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
            <div class="mb-5 overflow-hidden rounded-xl">
              <Image
                src={item.image}
                alt={`${item.title} — Fenêtres sur Loir`}
                widths={[400, 600, 800]}
                sizes="(max-width: 768px) 100vw, 33vw"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={78}
                class="w-full h-auto aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <h3 class="text-xl font-semibold">{item.title}</h3>
            <p class="mt-3 text-sm text-[var(--color-muted)] leading-relaxed">
              {item.description}
            </p>
            <span class="inline-flex items-center gap-1.5 mt-5 text-sm font-medium text-[var(--color-accent)] group-hover:gap-2.5 transition-all">
              Découvrir
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>
