---
// Encart de fin d'article. Lecture PostHog du 27/10/2026 : les guides faisaient
// un tiers des sessions d'entrée du site (241) pour un seul appel, sans aucun
// pont vers l'entreprise en fin de lecture. Deux variantes selon les tags de
// l'article ; `data-zone` donne sa zone aux événements d'audience (appel_clic,
// devis_clic, cta_clic) pour mesurer ce que l'encart apporte.
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { mainAgence, toE164 } from "../../config/business";

export type VarianteEncart = "depannage" | "projet";

interface Props {
  variante?: VarianteEncart;
}

const { variante = "projet" } = Astro.props;
const telHref = `tel:${toE164(mainAgence.telephone)}`;

const contenus: Record<
  VarianteEncart,
  { eyebrow: string; titre: string; texte: string; cta: string; lienLabel: string; lienHref: string }
> = {
  depannage: {
    eyebrow: "Si le réglage ne suffit pas",
    titre: "Nos menuisiers se déplacent dans le Maine-et-Loire",
    texte:
      "Diagnostic à domicile, réglage, réparation ou remplacement de vos menuiseries, depuis nos agences de Seiches-sur-le-Loir, à vingt minutes d'Angers, et de Doué-en-Anjou. Devis gratuit sous 48 h.",
    cta: "Demander un diagnostic",
    lienLabel: "Nos agences et leurs horaires →",
    lienHref: "/agences/",
  },
  projet: {
    eyebrow: "Votre projet",
    titre: "Parlons de vos menuiseries",
    texte:
      "Conseil personnalisé, devis gratuit sous 48 h et pose par nos propres équipes, certifiées RGE. Le showroom de Seiches-sur-le-Loir est à vingt minutes d'Angers.",
    cta: "Demander un devis gratuit",
    lienLabel: "Voir nos réalisations →",
    lienHref: "/realisations/",
  },
};

const c = contenus[variante];
---

<section class="section-tight" data-zone="fin_de_guide" data-encart-guide={variante}>
  <Container width="narrow">
    <div class="rounded-2xl bg-[var(--color-tint)] p-8 sm:p-10">
      <p class="mb-2 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
        {c.eyebrow}
      </p>
      <h2 class="text-2xl text-balance">{c.titre}</h2>
      <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[var(--color-muted)]">{c.texte}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <Button href="/contact/" variant="primary">{c.cta}</Button>
        <Button href={telHref} variant="outline" arrow={false}>Appeler le {mainAgence.telephone}</Button>
      </div>
      <p class="mt-5 text-sm">
        <a href={c.lienHref} class="font-medium text-[var(--color-accent)] hover:underline underline-offset-4">
          {c.lienLabel}
        </a>
      </p>
    </div>
  </Container>
</section>
