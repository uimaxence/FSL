---
import Container from "../ui/Container.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const items = [
  {
    icon: "calendar",
    title: "Depuis 2003",
    subtitle: "20+ ans d'expertise sur Angers",
  },
  {
    icon: "shield",
    title: "RGE Qualibat",
    subtitle: "Éligible Ma Prime Rénov & TVA 5,5%",
  },
  {
    icon: "star",
    title: "Sur mesure",
    subtitle: "Conseil personnalisé, pose certifiée",
  },
  {
    icon: "award",
    title: "Menuisier d'Excellence",
    subtitle: "Labellisé MéO & Point Conseil Bubendorff",
  },
];
---

<section class:list={["section-tight", className]}>
  <Container width="default">
    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-border)] rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
      {
        items.map((item) => (
          <li class="bg-white p-5 sm:p-6 flex items-start gap-3">
            <span
              class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-tint)] text-[var(--color-accent)]"
              aria-hidden="true"
            >
              {item.icon === "calendar" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              )}
              {item.icon === "shield" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              )}
              {item.icon === "star" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              )}
              {item.icon === "award" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="6"/>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                </svg>
              )}
            </span>
            <div>
              <p class="text-sm font-semibold text-[var(--color-fg)] leading-tight">{item.title}</p>
              <p class="mt-1 text-xs text-[var(--color-muted)] leading-snug">{item.subtitle}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
