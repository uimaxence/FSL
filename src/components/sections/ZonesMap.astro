---
import Container from "../ui/Container.astro";
import { communes } from "../../data/communes";
import { communesGeo } from "../../data/communes-geo";

interface Props {
  /** "full" : carte large pour le hub. "compact" : version accueil. */
  variant?: "full" | "compact";
  class?: string;
}

const { variant = "full", class: className = "" } = Astro.props;

// --- Carte --------------------------------------------------------------
// Contour du Maine-et-Loire + polygones des communes desservies, issus de
// l'open data (france-geojson), simplifiés et projetés sur la MÊME grille
// (viewBox 0 0 1000 782). Voir src/data/communes-geo.ts.
const VIEW_W = 1000;
const VIEW_H = 782;

const DEP_PATH =
  "M68.2 30.9 L74.3 11 L70.2 2 L73 0 L115.3 28.6 L132.4 33.2 L136.7 32.4 L135.1 25.9 L144.3 23.9 L201.8 36.7 L209 29.8 L208.3 34.8 L214.5 40.2 L235.5 45.1 L253.4 40.2 L251 28.7 L241.1 25.3 L247.4 13.4 L253.2 12.5 L264 22.6 L266 15.4 L289 33.1 L290.2 43.2 L324.1 53.7 L323.7 38.8 L338.8 36 L341.8 42.5 L354.9 45.9 L359.3 55.6 L374.5 52.3 L382 65.9 L405.3 60.8 L431.6 63.9 L441.9 70.5 L468 69.1 L484.4 48 L517 55.1 L525.5 42.6 L525.8 21.1 L547.3 27.8 L566.9 49.5 L582.8 39.4 L594.4 41.6 L590.6 27.7 L616.3 46 L612.8 55.5 L617.9 61.5 L616.5 66 L627.8 73.9 L624.3 88.1 L642.6 82 L672.5 84.1 L704.8 99.2 L725.1 78.8 L736.3 88.5 L742.6 87 L726.4 107.2 L716.8 106.1 L713.9 111.9 L729.7 138.1 L728.8 149.7 L752.6 151.5 L767.8 165 L782.4 162.3 L780.6 150.4 L788.4 137.7 L792.9 137.3 L796 148.3 L807.1 139.5 L818.1 150.2 L837 151.8 L839.9 160.7 L849.6 150.9 L858.3 161.4 L856.2 166.8 L860.4 167.9 L857.9 170.9 L861.1 174.7 L875 177.8 L890.5 191.2 L925.3 189.9 L927.1 198 L935.8 198.4 L944.2 212.6 L954.4 200.6 L967.8 198.1 L969.5 179.8 L979.5 182.1 L982.3 192 L985.5 183.8 L993.6 183.8 L998.8 189.8 L997 209.5 L1000 215.7 L987.9 220.3 L981 243.4 L974.2 251.8 L981.9 255.9 L982.6 263.6 L994.8 263.4 L991.1 269.7 L991 286.3 L978.2 303.6 L966.4 331.4 L969.1 358.1 L966.3 366.1 L949.3 382.3 L959.2 385.1 L957.9 394.5 L967.7 399.4 L940.9 416.6 L945.2 431.9 L939.4 440.4 L926.4 444 L923.6 457.4 L902 489 L909.1 491.1 L899.5 509.2 L899.6 522.3 L895.2 523 L899 532.7 L898.1 548.5 L902.4 551.4 L895.4 552.3 L885.8 570 L894.4 576.5 L892.4 589.1 L886.4 600.7 L883.5 595.9 L875.5 603.8 L864.4 589.5 L844.8 607.9 L826.7 647.3 L827.7 652.6 L835.7 654.5 L830.1 672.7 L826.3 665.8 L810.2 666 L810.1 660.5 L798.4 659 L788.6 673.4 L788.2 692.7 L771.3 702.5 L759.7 688.1 L748 692.8 L739.8 687.7 L764 662.7 L763.6 656.5 L756.7 659.1 L739.5 652.5 L722.6 666.3 L700.9 654.6 L687.1 660.7 L687 654.8 L674.5 656.9 L637.5 671.7 L637.9 667.4 L630 664.3 L609.4 671.7 L608.9 667 L603.2 667.8 L600.2 687.1 L596.4 690.6 L584.4 685.3 L564.2 689 L550.1 703 L546.8 692.3 L560.2 683.8 L563.2 676.3 L541.2 675.7 L501.7 693.1 L502.6 713.3 L511 722.8 L498.5 724.4 L496.5 734.8 L484.9 741.6 L477.6 754.8 L446.1 760.2 L430.3 750.2 L426.8 751.1 L424.3 764.4 L412.8 757.9 L401.8 767.9 L384.5 752.2 L384.8 760.4 L372.8 760.2 L368.2 750.2 L356.7 748.1 L342.9 759.6 L343.6 764.4 L341.6 758.1 L326.1 766.1 L321 762.8 L313.1 772.6 L317.9 777.3 L310.6 782 L291 775.4 L287.6 762.5 L283.3 757.7 L276.4 760.1 L273 754.9 L276.6 751.9 L272.9 749.7 L265.4 751 L267.5 745.4 L247.6 757.3 L238.6 744.8 L237.9 736 L234.6 736.1 L234.4 743.1 L221.5 733.1 L213.6 748.5 L188.5 748.8 L181 740.8 L176.3 745.2 L131.5 728.6 L129.4 725.4 L149.3 715.6 L146.5 701.1 L150.2 694.6 L125.4 685.6 L116.3 666.3 L65.8 661.4 L81.6 642.4 L72.6 625.5 L94.1 618.2 L93.5 613.4 L98 614.5 L121.2 587.8 L121.1 578.6 L110.6 573.1 L113.7 568.2 L109.4 560.2 L113.1 553.6 L104.3 548.4 L109 529.1 L98.3 517.8 L79.2 530.1 L63.1 522.7 L48.1 501.1 L49.8 482.7 L36.8 468.5 L10.7 473.7 L0 470.2 L36.1 438.1 L104.8 425.4 L118.1 412.4 L175.1 408.2 L213.4 413.6 L228.5 406.3 L238.8 407.7 L257.1 393.2 L253.9 391.1 L254.2 374.7 L247.5 364.2 L256.5 355.4 L252.5 348.1 L252.8 333.2 L243.1 316.1 L248.7 305.6 L244.7 295.8 L218.9 299.2 L195 283 L198.7 244.2 L191.3 244.3 L184.9 236.1 L190 234.3 L187.9 227.5 L196.6 230.2 L195 225.4 L210.9 216.9 L218.7 205.7 L199.8 192.9 L173.9 189.1 L159.6 176 L136 177.1 L123.9 162.4 L121.8 137.9 L109.2 135 L108.7 125.8 L113.9 119.2 L110.6 112.6 L112.9 107.3 L103.7 103 L108.7 99 L99.4 93 L100.1 82.2 L87.4 84.7 L62.2 73 L62 62.7 L70.8 62.4 L75.3 51.2 L65.8 42.5 L68.2 30.9 Z";

const agenceSlugs = new Set(["seiches-sur-le-loir", "doue-en-anjou"]);
// Labels affichés en permanence : agences + communes isolées (pas de
// chevauchement). Les autres (cluster angevin) n'apparaissent qu'au survol.
const labelsToujours = new Set([
  "seiches-sur-le-loir",
  "doue-en-anjou",
  "angers",
  "saumur",
  "bauge-en-anjou",
  "durtal",
  "brissac-loire-aubance",
  "segre-en-anjou-bleu",
  "cholet",
  "chemille-en-anjou",
  "beaupreau-en-mauges",
  "sevremoine",
  "montrevault-sur-evre",
  "mauges-sur-loire",
  "oree-d-anjou",
  "ombree-d-anjou",
  "le-lion-d-angers",
  "les-hauts-d-anjou",
  "noyant-villages",
  "gennes-val-de-loire",
  "longue-jumelles",
  "montreuil-bellay",
  "chalonnes-sur-loire",
]);

const zones = communes
  .map((c) => {
    const geo = communesGeo[c.slug];
    if (!geo) return null;
    return {
      slug: c.slug,
      nom: c.nom,
      d: geo.d,
      cx: geo.cx,
      cy: geo.cy,
      isAgence: agenceSlugs.has(c.slug),
      permanent: labelsToujours.has(c.slug),
    };
  })
  .filter((z): z is NonNullable<typeof z> => z !== null);
---

<section class:list={["section", className]}>
  <Container width={variant === "full" ? "wide" : "default"}>
    {variant === "compact" && (
      <div class="max-w-2xl mx-auto text-center mb-10">
        <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
          Zones d'intervention
        </p>
        <h2 class="text-balance">Un menuisier près de chez vous en Maine-et-Loire</h2>
        <p class="mt-4 text-base sm:text-lg text-[var(--color-muted)] leading-relaxed">
          De Segré au Saumurois, nous intervenons dans tout le département depuis nos
          agences de Seiches-sur-le-Loir et de Doué-en-Anjou. Cliquez sur votre commune.
        </p>
      </div>
    )}

    <div class="grid lg:grid-cols-[1.6fr_1fr] gap-8 lg:gap-12 items-center">
      <!-- Carte SVG -->
      <div class="relative">
        <svg
          viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
          class="w-full h-auto overflow-visible"
          role="img"
          aria-labelledby="zonesmap-title zonesmap-desc"
        >
          <title id="zonesmap-title">Carte des zones d'intervention de Fenêtres sur Loir en Maine-et-Loire</title>
          <desc id="zonesmap-desc">
            Contour du Maine-et-Loire avec les communes desservies, cliquables, et nos
            deux agences à Seiches-sur-le-Loir et à Doué-en-Anjou.
          </desc>

          <!-- Fond : contour du département -->
          <path
            d={DEP_PATH}
            fill="var(--color-subtle)"
            stroke="var(--color-border)"
            stroke-width="2"
            stroke-linejoin="round"
          />

          <!-- Communes desservies (formes réelles, cliquables) -->
          {zones.map((z) => (
            <a href={`/menuisier-${z.slug}`} class="group" aria-label={`Menuisier à ${z.nom}`}>
              <title>{z.nom}</title>
              <path
                d={z.d}
                fill="var(--color-accent)"
                stroke="white"
                stroke-width="1.5"
                stroke-linejoin="round"
                class:list={[
                  "transition-[fill-opacity] duration-150",
                  z.isAgence
                    ? "[fill-opacity:0.9] group-hover:[fill-opacity:1]"
                    : "[fill-opacity:0.45] group-hover:[fill-opacity:0.85]",
                ]}
              />
              {z.isAgence && (
                <circle cx={z.cx} cy={z.cy} r="6" fill="white" stroke="var(--color-accent)" stroke-width="3" />
              )}
              <text
                x={z.cx}
                y={z.isAgence ? z.cy - 14 : z.cy}
                text-anchor="middle"
                class:list={[
                  "select-none pointer-events-none transition-opacity duration-150",
                  z.permanent ? "opacity-100" : "opacity-0 group-hover:opacity-100",
                ]}
                font-size={z.isAgence ? 19 : 16}
                font-weight={z.isAgence ? 700 : 600}
                fill="var(--color-fg)"
                paint-order="stroke"
                stroke="white"
                stroke-width="4.5"
                stroke-linejoin="round"
              >{z.nom}</text>
            </a>
          ))}
        </svg>
      </div>

      <!-- Légende / liste -->
      <div>
        {variant === "full" && <h2 class="text-balance mb-4">Nos zones d'intervention</h2>}
        <p class="text-[var(--color-muted)] leading-relaxed mb-6">
          Survolez ou touchez une commune pour la sélectionner. Nos équipes rayonnent sur
          tout le Maine-et-Loire depuis deux agences.
        </p>
        <ul class="space-y-3 text-sm mb-6">
          <li class="flex items-center gap-3">
            <span class="inline-flex w-4 h-4 rounded-full bg-[var(--color-accent)] ring-2 ring-white shadow-sm shrink-0"></span>
            <span><strong>Nos agences</strong> — Seiches-sur-le-Loir &amp; Doué-en-Anjou</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="inline-flex w-4 h-4 rounded-sm bg-[var(--color-accent)]/45 ring-1 ring-white shrink-0"></span>
            <span>Communes desservies</span>
          </li>
        </ul>
        <a
          href="/zones-intervention"
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors"
          style="background: var(--color-accent);"
          onmouseover="this.style.background='var(--color-accent-hover)'"
          onmouseout="this.style.background='var(--color-accent)'"
        >
          Voir toutes nos zones d'intervention
        </a>
      </div>
    </div>
  </Container>
</section>
