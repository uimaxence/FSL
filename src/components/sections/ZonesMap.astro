---
import Container from "../ui/Container.astro";
import { communes, communesParAgence, AGENCES } from "../../data/communes";
import type { AgenceRattachement } from "../../data/communes";
import { communesGeo, cantonsGeo, depPath } from "../../data/communes-geo";

// Recherche insensible aux accents/casse (utilisé pour le data-attr mobile).
const normalize = (s: string) =>
  s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

// Liste mobile : communes desservies groupées par agence, triées A→Z.
const groupesMobile = (["seiches", "doue"] as AgenceRattachement[]).map((ag) => ({
  agence: AGENCES[ag],
  communes: communesParAgence(ag)
    .slice()
    .sort((a, b) => a.nom.localeCompare(b.nom, "fr")),
}));

interface Props {
  /** "full" : carte large pour le hub. "compact" : version accueil. */
  variant?: "full" | "compact";
  class?: string;
}

const { variant = "full", class: className = "" } = Astro.props;

// --- Carte --------------------------------------------------------------
// Fond de carte : les CANTONS du 49 (~22 grandes formes, façon choroplèthe)
// plutôt que les ~180 communes — beaucoup moins découpé, plus élégant.
// Chaque canton est teinté selon sa distance à l'agence la plus proche :
// le bleu rayonne depuis Seiches-sur-le-Loir et Doué-en-Anjou.
// Les communes desservies restent des zones cliquables invisibles qui se
// révèlent en bleu plein au survol. Voir src/data/communes-geo.ts (généré).
const VIEW_W = 1000;
const VIEW_H = 782;

const agenceSlugs = new Set(["seiches-sur-le-loir", "doue-en-anjou"]);
// Labels affichés en permanence : volontairement peu nombreux (aération).
// Les autres communes desservies apparaissent au survol.
const labelsToujours = new Set([
  "seiches-sur-le-loir",
  "doue-en-anjou",
  "angers",
  "cholet",
  "saumur",
  "bauge-en-anjou",
  "durtal",
  "montreuil-bellay",
  "gennes-val-de-loire",
]);

// Teinte des cantons : 4 paliers, du plus soutenu (proche d'une agence) au
// plus clair (confins du département). Palier = distance au plus proche des
// deux points d'agence, normalisée. Les valeurs sont des % d'accent dans un
// color-mix avec du blanc (cf. <style>).
const A1 = communesGeo["seiches-sur-le-loir"];
const A2 = communesGeo["doue-en-anjou"];
const distAgence = (x: number, y: number) =>
  Math.min(Math.hypot(x - A1.cx, y - A1.cy), Math.hypot(x - A2.cx, y - A2.cy));
const distances = cantonsGeo.map((c) => distAgence(c.cx, c.cy));
const maxDist = Math.max(...distances);
const cantons = cantonsGeo.map((c, i) => ({
  d: c.d,
  shade: Math.min(3, Math.floor((distances[i] / maxDist) * 4)),
}));

// Communes desservies (avec page dédiée) : zones cliquables + labels.
const zones = communes.map((c) => {
  const geo = communesGeo[c.slug];
  return {
    slug: c.slug,
    nom: c.nom,
    d: geo?.d,
    cx: geo?.cx ?? 0,
    cy: geo?.cy ?? 0,
    isAgence: agenceSlugs.has(c.slug),
    permanent: labelsToujours.has(c.slug),
  };
}).filter((z) => z.d);
---

<section class:list={["section", className]}>
  <Container width={variant === "full" ? "wide" : "default"}>
    {variant === "compact" && (
      <div class="max-w-2xl mx-auto text-center mb-10">
        <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
          Zones d'intervention
        </p>
        <h2 class="text-balance">Un menuisier près de chez vous en Maine-et-Loire</h2>
        <p class="mt-4 text-base sm:text-lg text-[var(--color-muted)] leading-relaxed">
          De Segré au Saumurois, nous intervenons dans tout le département depuis nos
          agences de Seiches-sur-le-Loir et de Doué-en-Anjou. Cliquez sur votre commune.
        </p>
      </div>
    )}

    <div class="grid lg:grid-cols-[1.6fr_1fr] gap-8 lg:gap-12 items-center">
      <!-- Carte SVG — desktop uniquement (illisible / non tappable en mobile) -->
      <div class="relative hidden lg:block">
        <svg
          viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
          class="zm-svg w-full h-auto overflow-visible"
          role="img"
          aria-labelledby="zonesmap-title zonesmap-desc"
          data-zonesmap
        >
          <title id="zonesmap-title">Carte des zones d'intervention de Fenêtres sur Loir en Maine-et-Loire</title>
          <desc id="zonesmap-desc">
            Contour du Maine-et-Loire avec les communes desservies, cliquables, et nos
            deux agences à Seiches-sur-le-Loir et à Doué-en-Anjou.
          </desc>

          <!-- COUCHE 0 — fond : département + cantons teintés selon leur
               proximité à l'agence la plus proche (le bleu rayonne depuis
               Seiches et Doué). Grandes formes = carte apaisée. -->
          <path d={depPath} class="zm-shade-3" />
          <g>
            {cantons.map((c) => (
              <path d={c.d} class:list={["zm-canton", `zm-shade-${c.shade}`]} />
            ))}
          </g>

          <!-- COUCHE 1 — communes desservies : zones cliquables invisibles,
               révélées en bleu plein au survol / focus. -->
          <g>
            {zones.map((z) => (
              <a
                href={`/menuisier-${z.slug}/`}
                class="group"
                data-zone={z.slug}
                aria-label={`Menuisier à ${z.nom}`}
              >
                <title>{z.nom}</title>
                <path d={z.d} class="zm-commune" />
              </a>
            ))}
          </g>

          <!-- Contour du département, net, au-dessus des remplissages. -->
          <path d={depPath} class="zm-outline pointer-events-none" />

          <!-- COUCHE 2 — marqueurs des agences + libellés, toujours au-dessus
               des polygones (jamais tronqués). Les libellés non permanents
               apparaissent au survol/focus de leur commune (voir script). -->
          <g class="pointer-events-none">
            {zones.filter((z) => z.isAgence).map((z) => (
              <g class="zm-agence">
                <circle cx={z.cx} cy={z.cy} r="15" class="zm-halo" />
                <circle cx={z.cx} cy={z.cy} r="5.5" class="zm-dot" />
                <text x={z.cx} y={z.cy - 33} text-anchor="middle" class="zm-eyebrow">Agence</text>
              </g>
            ))}
            {zones.map((z) => (
              <text
                data-zone-label={z.slug}
                x={z.cx}
                y={z.isAgence ? z.cy - 16 : z.cy}
                text-anchor="middle"
                class:list={["zm-label", z.permanent && "is-permanent", z.isAgence && "is-agence"]}
                font-size={z.isAgence ? 19 : 15}
                font-weight={z.isAgence ? 700 : 500}
              >{z.nom}</text>
            ))}
          </g>
        </svg>
      </div>

      <!-- Liste recherchable — mobile / tablette (remplace la carte) -->
      <div class="lg:hidden" data-zones-mobile>
        <label class="relative block">
          <span class="sr-only">Rechercher votre commune</span>
          <svg
            class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[var(--color-muted)]"
            width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="Rechercher votre commune…"
            class="w-full rounded-full border border-[var(--color-border)] bg-white py-3 pl-11 pr-4 text-base text-[var(--color-fg)] shadow-sm outline-none transition-colors focus:border-[var(--color-accent)]"
            data-zones-search
            aria-controls="zones-mobile-results"
          />
        </label>

        <div id="zones-mobile-results" class="mt-6 space-y-7">
          {groupesMobile.map((groupe) => (
            <div data-zones-group>
              <p class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">
                <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true" />
                Agence de {groupe.agence.nom}
              </p>
              <ul class="grid grid-cols-2 gap-2">
                {groupe.communes.map((c) => (
                  <li data-zones-item data-zones-name={normalize(c.nom)}>
                    <a
                      href={`/menuisier-${c.slug}/`}
                      class="flex items-center justify-between gap-1 rounded-xl border border-[var(--color-border)] bg-white px-3.5 py-3 text-sm font-medium text-[var(--color-fg)] transition-colors active:bg-[var(--color-tint)]"
                    >
                      <span class="truncate">{c.nom}</span>
                      <svg class="shrink-0 text-[var(--color-accent)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <p class="hidden py-6 text-center text-sm text-[var(--color-muted)]" data-zones-empty>
            Aucune commune ne correspond. Tout le Maine-et-Loire est desservi —
            <a href="/contact/" class="text-[var(--color-accent)] underline underline-offset-2">contactez-nous</a>.
          </p>
        </div>
      </div>

      <!-- Texte d'accompagnement + CTA -->
      <div>
        {variant === "full" && <h2 class="text-balance mb-4">Nos zones d'intervention</h2>}
        <p class="text-[var(--color-muted)] leading-relaxed mb-6">
          Tout le Maine-et-Loire est desservi depuis nos deux agences de
          Seiches-sur-le-Loir et de Doué-en-Anjou.
          <span class="hidden lg:inline">Survolez ou touchez une commune sur la carte pour ouvrir sa page.</span>
          <span class="lg:hidden">Sélectionnez votre commune dans la liste ci-dessus pour ouvrir sa page.</span>
        </p>
        <a
          href="/zones-intervention/"
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors"
          style="background: var(--color-accent);"
          onmouseover="this.style.background='var(--color-accent-hover)'"
          onmouseout="this.style.background='var(--color-accent)'"
        >
          Voir toutes nos zones d'intervention
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Ombre portée douce et bleutée : la carte "flotte" sur la page. */
  .zm-svg {
    filter: drop-shadow(
      0 24px 44px color-mix(in srgb, var(--color-accent) 24%, transparent)
    );
  }

  /* Choroplèthe : 4 paliers de bleu, du plus soutenu (autour des agences)
     au plus clair (confins du département). Toujours dérivés de l'accent. */
  .zm-shade-0 { fill: color-mix(in srgb, var(--color-accent) 44%, white); }
  .zm-shade-1 { fill: color-mix(in srgb, var(--color-accent) 34%, white); }
  .zm-shade-2 { fill: color-mix(in srgb, var(--color-accent) 26%, white); }
  .zm-shade-3 { fill: color-mix(in srgb, var(--color-accent) 19%, white); }

  /* Découpe des cantons : trait blanc fin, doux (pas de grille dure). */
  .zm-canton {
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  /* Contour départemental net, par-dessus les remplissages. */
  .zm-outline {
    fill: none;
    stroke: color-mix(in srgb, var(--color-accent) 75%, white);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* Communes desservies : invisibles au repos (la carte reste calme),
     bleu plein + contour blanc au survol / focus clavier. */
  .zm-commune {
    fill: var(--color-accent);
    fill-opacity: 0;
    stroke: #fff;
    stroke-width: 1.5;
    stroke-opacity: 0;
    stroke-linejoin: round;
    transition: fill-opacity 0.18s ease, stroke-opacity 0.18s ease;
  }
  .group:hover .zm-commune,
  .group:focus-visible .zm-commune {
    fill-opacity: 1;
    stroke-opacity: 1;
  }

  /* Marqueurs d'agence : point blanc cerclé d'accent + halo qui respire. */
  .zm-dot {
    fill: #fff;
    stroke: var(--color-accent);
    stroke-width: 3;
  }
  .zm-halo {
    fill: var(--color-accent);
    opacity: 0.18;
    transform-box: fill-box;
    transform-origin: center;
    animation: zm-pulse 3.2s ease-in-out infinite;
  }
  @keyframes zm-pulse {
    0%, 100% { transform: scale(1); opacity: 0.18; }
    50% { transform: scale(1.35); opacity: 0.08; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zm-halo { animation: none; }
  }
  .zm-eyebrow {
    fill: color-mix(in srgb, var(--color-accent) 80%, var(--color-fg));
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  /* Libellés (couche du dessus) : halo blanc pour rester lisibles sur le
     bleu, masqués par défaut, révélés via .is-permanent ou au survol (JS). */
  .zm-label {
    fill: var(--color-fg);
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 4px;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity 0.15s ease;
    -webkit-user-select: none;
    user-select: none;
  }
  .zm-label.is-permanent {
    opacity: 1;
  }
  .zm-label:not(.is-agence) {
    fill: color-mix(in srgb, var(--color-fg) 78%, var(--color-accent));
  }

  /* Focus au survol : la commune survolée prend la lumière, les autres
     libellés s'estompent (évite toute collision de textes). */
  svg.zm-hovering .zm-label.is-permanent:not(.is-hover) {
    opacity: 0.1;
  }
  .zm-eyebrow {
    transition: opacity 0.15s ease;
  }
  svg.zm-hovering .zm-eyebrow {
    opacity: 0.1;
  }
</style>

<script>
  // Révèle le libellé d'une commune au survol / focus, et estompe les
  // autres libellés pendant ce temps (classe zm-hovering sur le svg) pour
  // que le nom survolé reste seul et lisible.
  for (const svg of document.querySelectorAll<SVGSVGElement>("[data-zonesmap]")) {
    for (const link of svg.querySelectorAll<SVGAElement>("[data-zone]")) {
      const slug = link.getAttribute("data-zone");
      const label = svg.querySelector<SVGTextElement>(
        `[data-zone-label="${slug}"]`
      );
      if (!label) continue;
      const show = () => {
        label.style.opacity = "1";
        label.classList.add("is-hover");
        svg.classList.add("zm-hovering");
      };
      const hide = () => {
        label.style.opacity = "";
        label.classList.remove("is-hover");
        svg.classList.remove("zm-hovering");
      };
      link.addEventListener("mouseenter", show);
      link.addEventListener("mouseleave", hide);
      link.addEventListener("focus", show);
      link.addEventListener("blur", hide);
    }
  }

  // Filtre de la liste mobile des communes (insensible aux accents/casse).
  for (const root of document.querySelectorAll<HTMLElement>("[data-zones-mobile]")) {
    const input = root.querySelector<HTMLInputElement>("[data-zones-search]");
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-zones-item]"));
    const groups = Array.from(root.querySelectorAll<HTMLElement>("[data-zones-group]"));
    const empty = root.querySelector<HTMLElement>("[data-zones-empty]");
    if (!input) continue;

    const norm = (s: string) =>
      s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();

    input.addEventListener("input", () => {
      const q = norm(input.value);
      let visible = 0;
      for (const item of items) {
        const match = !q || (item.dataset.zonesName ?? "").includes(q);
        item.hidden = !match;
        if (match) visible++;
      }
      // Masque un groupe dont toutes les communes sont filtrées.
      for (const group of groups) {
        const any = group.querySelector("[data-zones-item]:not([hidden])");
        group.hidden = !any;
      }
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    });
  }
</script>
