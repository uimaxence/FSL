---
import Container from "../ui/Container.astro";
import { communes } from "../../data/communes";
import { communesGeo, depPath } from "../../data/communes-geo";

interface Props {
  /** "full" : carte large pour le hub. "compact" : version accueil. */
  variant?: "full" | "compact";
  class?: string;
}

const { variant = "full", class: className = "" } = Astro.props;

// --- Carte --------------------------------------------------------------
// Contour du Maine-et-Loire + polygones de TOUTES les communes du 49, issus
// de l'open data (france-geojson), simplifiés et projetés sur la MÊME grille
// (viewBox 0 0 1000 782). Voir src/data/communes-geo.ts (généré).
const VIEW_W = 1000;
const VIEW_H = 782;

const agenceSlugs = new Set(["seiches-sur-le-loir", "doue-en-anjou"]);
// Labels affichés en permanence : agences + communes isolées (pas de
// chevauchement). Les autres (cluster angevin) n'apparaissent qu'au survol.
const labelsToujours = new Set([
  "seiches-sur-le-loir",
  "doue-en-anjou",
  "angers",
  "saumur",
  "bauge-en-anjou",
  "durtal",
  "brissac-loire-aubance",
  "segre-en-anjou-bleu",
  "cholet",
  "chemille-en-anjou",
  "beaupreau-en-mauges",
  "sevremoine",
  "montrevault-sur-evre",
  "mauges-sur-loire",
  "oree-d-anjou",
  "ombree-d-anjou",
  "le-lion-d-angers",
  "les-hauts-d-anjou",
  "noyant-villages",
  "gennes-val-de-loire",
  "longue-jumelles",
  "montreuil-bellay",
  "chalonnes-sur-loire",
]);

// Communes desservies (avec page dédiée) indexées par slug.
const servedBySlug = new Map(communes.map((c) => [c.slug, c]));

// On dessine TOUTES les communes du département (découpe complète, plus
// aucune grande zone vide). Celles qui ont une page dédiée sont cliquables
// et reconnaissables à leur libellé.
const zones = Object.entries(communesGeo).map(([slug, geo]) => {
  const c = servedBySlug.get(slug);
  return {
    slug,
    nom: c?.nom ?? geo.nom,
    d: geo.d,
    cx: geo.cx,
    cy: geo.cy,
    served: !!c,
    isAgence: agenceSlugs.has(slug),
    permanent: !!c && labelsToujours.has(slug),
  };
});
---

<section class:list={["section", className]}>
  <Container width={variant === "full" ? "wide" : "default"}>
    {variant === "compact" && (
      <div class="max-w-2xl mx-auto text-center mb-10">
        <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
          Zones d'intervention
        </p>
        <h2 class="text-balance">Un menuisier près de chez vous en Maine-et-Loire</h2>
        <p class="mt-4 text-base sm:text-lg text-[var(--color-muted)] leading-relaxed">
          De Segré au Saumurois, nous intervenons dans tout le département depuis nos
          agences de Seiches-sur-le-Loir et de Doué-en-Anjou. Cliquez sur votre commune.
        </p>
      </div>
    )}

    <div class="grid lg:grid-cols-[1.6fr_1fr] gap-8 lg:gap-12 items-center">
      <!-- Carte SVG -->
      <div class="relative">
        <svg
          viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
          class="w-full h-auto overflow-visible"
          role="img"
          aria-labelledby="zonesmap-title zonesmap-desc"
        >
          <title id="zonesmap-title">Carte des zones d'intervention de Fenêtres sur Loir en Maine-et-Loire</title>
          <desc id="zonesmap-desc">
            Contour du Maine-et-Loire avec les communes desservies, cliquables, et nos
            deux agences à Seiches-sur-le-Loir et à Doué-en-Anjou.
          </desc>

          <!-- Fond : contour du département, d'un bleu uni — tout le
               Maine-et-Loire est desservi, aucune zone blanche. -->
          <path
            d={depPath}
            class="zm-fill"
            stroke="var(--color-accent)"
            stroke-width="2"
            stroke-linejoin="round"
          />

          <!-- Toutes les communes du 49, même bleu uni, découpées par le
               trait blanc. Celles non desservies par une page : simple
               polygone (non cliquable). -->
          {zones.filter((z) => !z.served).map((z) => (
            <path
              d={z.d}
              stroke="white"
              stroke-width="1"
              stroke-linejoin="round"
              class="zm-fill"
            >
              <title>{z.nom}</title>
            </path>
          ))}

          <!-- Communes desservies : cliquables, reconnaissables au libellé. -->
          {zones.filter((z) => z.served).map((z) => (
            <a href={`/menuisier-${z.slug}`} class="group" aria-label={`Menuisier à ${z.nom}`}>
              <title>{z.nom}</title>
              <path
                d={z.d}
                stroke="white"
                stroke-width="1.5"
                stroke-linejoin="round"
                class="zm-commune"
              />
              {z.isAgence && (
                <circle cx={z.cx} cy={z.cy} r="6" fill="white" stroke="var(--color-accent)" stroke-width="3" />
              )}
              <text
                x={z.cx}
                y={z.isAgence ? z.cy - 14 : z.cy}
                text-anchor="middle"
                class:list={[
                  "select-none pointer-events-none transition-opacity duration-150",
                  z.permanent ? "opacity-100" : "opacity-0 group-hover:opacity-100",
                ]}
                font-size={z.isAgence ? 19 : 16}
                font-weight={z.isAgence ? 700 : 600}
                fill="var(--color-fg)"
                paint-order="stroke"
                stroke="white"
                stroke-width="4.5"
                stroke-linejoin="round"
              >{z.nom}</text>
            </a>
          ))}
        </svg>
      </div>

      <!-- Texte d'accompagnement + CTA -->
      <div>
        {variant === "full" && <h2 class="text-balance mb-4">Nos zones d'intervention</h2>}
        <p class="text-[var(--color-muted)] leading-relaxed mb-6">
          Tout le Maine-et-Loire est desservi depuis nos deux agences de
          Seiches-sur-le-Loir et de Doué-en-Anjou (repérées par un point).
          Survolez ou touchez une commune avec un libellé pour ouvrir sa page.
        </p>
        <a
          href="/zones-intervention"
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors"
          style="background: var(--color-accent);"
          onmouseover="this.style.background='var(--color-accent-hover)'"
          onmouseout="this.style.background='var(--color-accent)'"
        >
          Voir toutes nos zones d'intervention
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Bleu uni partout : le fond du département et les communes partagent
     exactement la même couleur (solide, donc aucune surimpression ne
     fonce les zones). Les communes ne se distinguent que par leur découpe
     blanche ; la commune survolée passe en bleu plein. */
  .zm-fill,
  .zm-commune {
    fill: color-mix(in srgb, var(--color-accent) 34%, white);
  }
  .zm-commune {
    transition: fill 0.15s ease;
  }
  .group:hover .zm-commune {
    fill: var(--color-accent);
  }
</style>
