---
import Container from "../ui/Container.astro";
---

<section class="section bg-[var(--color-accent)] text-white text-center">
  <Container width="default">
    <p class="text-xs font-semibold tracking-[0.18em] uppercase text-white/70 mb-5">
      La signature Fenêtres sur Loir
    </p>
    <p class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight text-balance italic">
      L'<strong class="font-bold not-italic">excellence française</strong> au service de votre habitat,<br />
      depuis Seiches-sur-le-Loir.
    </p>
  </Container>
</section>
