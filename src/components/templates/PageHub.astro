---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Container from "../ui/Container.astro";
import Card from "../ui/Card.astro";
import fallbackHero from "../../assets/hero-1.jpg";

type Ratio = "16-9" | "4-3" | "1-1" | "3-4";

interface HubCard {
  title: string;
  description?: string;
  href: string;
  placeholderLabel: string;
  ratio?: Ratio;
  image?: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  heroPlaceholderLabel?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  cards: HubCard[];
  ctaHref?: string;
  ctaLabel?: string;
  ctaText?: string;
}

const {
  eyebrow,
  title,
  intro,
  heroPlaceholderLabel,
  heroImage,
  heroImageAlt,
  cards,
  ctaHref = "/contact",
  ctaLabel = "Demander un devis gratuit",
  ctaText,
} = Astro.props;
---

<section class="pt-12 pb-16 lg:pt-16 lg:pb-20">
  <Container width="wide">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        {eyebrow && (
          <p class="mb-4 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
            {eyebrow}
          </p>
        )}
        <h1 class="text-balance">{title}</h1>
        {intro && (
          <p class="mt-7 max-w-2xl text-[17px] leading-relaxed text-[var(--color-fg)]">
            {intro}
          </p>
        )}
      </div>
      {heroImage ? (
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={heroImage}
              alt={heroImageAlt ?? heroPlaceholderLabel ?? ""}
              widths={[400, 700, 1000]}
              sizes="(max-width: 1024px) 100vw, 40vw"
              loading="eager"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
        </div>
      ) : heroPlaceholderLabel ? (
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={fallbackHero}
              alt={heroImageAlt ?? heroPlaceholderLabel}
              widths={[400, 700, 1000]}
              sizes="(max-width: 1024px) 100vw, 40vw"
              loading="eager"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
        </div>
      ) : null}
    </div>
  </Container>
</section>

<slot name="before-cards" />

<section class="section-tight">
  <Container width="wide">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        cards.map((c) => (
          <Card
            title={c.title}
            description={c.description}
            href={c.href}
            placeholderLabel={c.placeholderLabel}
            ratio={c.ratio ?? "3-4"}
            image={c.image}
            imageAlt={c.imageAlt}
          />
        ))
      }
    </div>
  </Container>
</section>

<slot name="after-cards" />

{(ctaText || ctaLabel) && (
  <section class="section-tight">
    <Container width="wide" class="text-center">
      {ctaText && (
        <p class="max-w-2xl mx-auto mb-6 text-[15px] text-[var(--color-muted)]">
          {ctaText}
        </p>
      )}
      {ctaLabel && (
        <a
          href={ctaHref}
          class="inline-flex items-center rounded-full px-7 py-3 text-[15px] font-medium text-white shadow-sm transition-colors"
          style="background: var(--color-accent);"
          onmouseover="this.style.background='var(--color-accent-hover)'"
          onmouseout="this.style.background='var(--color-accent)'"
        >
          {ctaLabel}
        </a>
      )}
    </Container>
  </section>
)}
