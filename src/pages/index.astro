---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import VideoSection from "../components/sections/VideoSection.astro";
import Stats from "../components/sections/Stats.astro";
import RealisationsGrid from "../components/sections/RealisationsGrid.astro";
import ExpertiseCards from "../components/sections/ExpertiseCards.astro";
import ImageGallery from "../components/sections/ImageGallery.astro";
import HistoireParallax from "../components/sections/HistoireParallax.astro";
import AvisGoogle from "../components/sections/AvisGoogle.astro";
import Agencies from "../components/sections/Agencies.astro";
import ZonesMap from "../components/sections/ZonesMap.astro";
import ContactForm from "../components/sections/ContactForm.astro";
import { siteGraph } from "../lib/schema";

const title = "Fenêtres sur Loir — Menuisier RGE à Seiches-sur-le-Loir, près d'Angers";
const description =
  "Fenêtres sur Loir, artisan menuisier à Seiches-sur-le-Loir (49). Fenêtres, portes, volets, verrières et aménagements extérieurs sur mesure. Partenaire MéO, Bubendorff, Arcades & Baies.";

// Graphe d'entité unique et relié (Organization + WebSite + 2 agences).
const schema = siteGraph();
---

<BaseLayout title={title} description={description} schemaJsonLd={schema}>
  <Hero />
  <ExpertiseCards />
  <VideoSection />
  <Stats />
  <RealisationsGrid />
  <ImageGallery />
  <HistoireParallax />
  <AvisGoogle />
  <Agencies />
  <ZonesMap variant="compact" />
  <ContactForm />
</BaseLayout>
