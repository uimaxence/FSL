---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import { business, mainAgence, addressOneLine, toE164 } from "../config/business";
---

<BaseLayout
  title="Mentions légales — Fenêtres-sur-Loir"
  description="Mentions légales du site fenetres-sur-loir.fr."
>
  <section class="section pt-16 lg:pt-20">
    <Container width="narrow">
      <h1>Mentions légales</h1>

      <div class="mt-10 space-y-8 text-[var(--color-muted)] leading-relaxed">
        <div>
          <h2 class="text-2xl font-semibold text-[var(--color-fg)]">Éditeur</h2>
          <p class="mt-3">
            {business.legalName}<br />
            {addressOneLine(mainAgence)}<br />
            {/* TODO client : SIRET, forme juridique et capital social pour compléter les mentions légales. */}
            Téléphone : <a href={`tel:${toE164(mainAgence.telephone)}`} class="text-[var(--color-accent)] hover:underline">{mainAgence.telephone}</a>
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold text-[var(--color-fg)]">Hébergement</h2>
          <p class="mt-3">À compléter (hébergeur, adresse, contact).</p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold text-[var(--color-fg)]">Propriété intellectuelle</h2>
          <p class="mt-3">
            L'ensemble du contenu du site (textes, images, vidéos, marques) est protégé par le droit d'auteur et le droit des marques. Toute reproduction sans autorisation préalable est interdite.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold text-[var(--color-fg)]">Données personnelles</h2>
          <p class="mt-3">
            Les informations recueillies via les formulaires de contact sont utilisées exclusivement pour traiter votre demande. Conformément au RGPD, vous disposez d'un droit d'accès, de rectification et de suppression de vos données.
          </p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
