---
// Page marque MéO : le partenariat, le concept bois-aluminium expliqué en coupe
// (animée au défilement), la gamme, les finitions, les performances, le club
// des Menuisiers d'Excellence, une FAQ et un bloc « transmettre cette page »
// (lien, e-mail, WhatsApp, impression) : c'est la page à envoyer à un client
// intéressé par le bois-alu.
//
// Faits produits : uniquement ce qui est publié sur fenetremeo.com, relevé le
// 12/10/2026 (pages « L'alliance bois-aluminium », fiches fenêtres, baies
// coulissantes, verrières & murs rideaux, portes d'entrée, « Qu'est-ce que
// l'effet bilame ? », « À quoi correspondent les niveaux de performance »,
// « Des menuiseries bois-aluminium à la qualité certifiée », « Quel vitrage
// choisir », FAQ, « MéO, créateur depuis 1983 », « Menuisiers d'Excellence »).
// Aucun prix (choix client) : le catalogue MéO en affiche, pas cette page.
//
// Images : src/assets/meo/* sont des illustrations générées (fal.ai,
// 12/10/2026), jamais à présenter comme des chantiers ; porte-1-boisalu,
// porte-2-boisalu et verriere-boisalu-1 sont des visuels MéO.
//
// SEO : la requête locale « fenêtre bois alu angers » reste sur
// /fenetres-bois-alu-angers/ ; cette page est la page marque et y renvoie.
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import ReponseDirecte from "../../components/ui/ReponseDirecte.astro";
import CTASection from "../../components/sections/CTASection.astro";
import ConseilsLies from "../../components/sections/ConseilsLies.astro";
import { organizationNode, agencyNode, agencyId } from "../../lib/schema";
import { SITE_URL } from "../../config/business";
import meoLogo from "../../assets/meo-logo.png";
import tropheePortes from "../../assets/trophee-meo-2025-portes-entree.png";
import tropheePerformance from "../../assets/trophee-meo-2025-performance.png";
import heroImg from "../../assets/meo/hero-coin-fenetre.jpg";
import profilImg from "../../assets/meo/profil-ecorche.jpg";
import baieImg from "../../assets/meo/baie-coulissante.jpg";
import facadeImg from "../../assets/meo/facade-tuffeau.jpg";
import murRideauImg from "../../assets/meo/mur-rideau.jpg";
import porteExt from "../../assets/porte-1-boisalu.png";
import porteInt from "../../assets/porte-2-boisalu.png";

const title = "MéO : le bois-alu expliqué par votre Menuisier d'Excellence";
const description =
  "Bois dedans, aluminium dehors : le concept MéO expliqué en coupe, performances, finitions, garanties. Fenêtres sur Loir, Menuisier d'Excellence MéO près d'Angers.";

const PAGE_URL = `${SITE_URL}/partenaires/meo/`;

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Nos partenaires", href: "/partenaires/" },
  { label: "MéO" },
];

const reponseDirecte =
  "MéO est le fabricant vendéen qui a créé le concept de menuiserie bois-aluminium en 1983 : une structure en bois, visible à l'intérieur, et une structure en aluminium à l'extérieur, assemblées par plots. Fenêtres sur Loir est Menuisier d'Excellence MéO : l'entreprise conseille, mesure et pose ces fenêtres, baies, portes d'entrée et verrières dans tout le Maine-et-Loire, avec ses propres équipes, depuis ses agences de Seiches-sur-le-Loir et Doué-en-Anjou.";

// Chiffres animés (count-up). Tous publiés par MéO.
const chiffres = [
  { target: 40, prefix: "+", suffix: " ans", label: "de bois-aluminium : concept créé en 1983" },
  { target: 28, label: "teintes d'aluminium à l'extérieur" },
  { target: 13, label: "finitions de bois à l'intérieur" },
  { target: 82, label: "modèles de portes d'entrée" },
  { target: 5, label: "brevets déposés sur la fenêtre" },
  { target: 10, suffix: " ans", label: "de garantie fabricant, au maximum" },
];

// Étapes de la coupe animée. `layer` = groupe SVG mis en avant.
const coupe = [
  {
    layer: "bois",
    titre: "Le bois, côté pièce",
    texte:
      "La structure porteuse est en bois lamellé, abouté et collé, recouvert d'un placage de pin ou de chêne. Le bois est naturellement le matériau le plus isolant : ses cellules enferment de l'air. C'est lui que vous voyez et que vous touchez, sur le dormant comme sur l'ouvrant.",
    detail: "2 essences · 13 finitions · lasure en phase aqueuse",
  },
  {
    layer: "alu",
    titre: "L'aluminium, côté façade",
    texte:
      "Un capotage en aluminium thermolaqué habille toute la face extérieure du dormant et de l'ouvrant. Il encaisse la pluie, les UV et les chocs et garde sa teinte dans le temps : il n'y a rien à repeindre ni à lasurer côté rue.",
    detail: "28 teintes · thermolaquage certifié Qualimarine",
  },
  {
    layer: "plots",
    titre: "Les plots : deux structures, pas de pont thermique",
    texte:
      "Bois et aluminium ne sont pas collés l'un à l'autre : ils sont assemblés par un système de plots, avec une lame d'air entre les deux. MéO parle de rupture totale de pont thermique. Au soleil, l'aluminium se dilate sans déformer l'ouvrant : c'est ce qui écarte l'effet bilame, même en teinte foncée exposée au sud.",
    detail: "Assemblage par plots · dilatation libre · 5 brevets",
  },
  {
    layer: "vitrage",
    titre: "Le vitrage, collé au cadre bois",
    texte:
      "De série, un double vitrage 4/20/TBE 4 : deux verres de 4 mm, une lame de 20 mm, une couche à très basse émissivité (TBE) et un intercalaire « warm-edge » qui limite le froid en bord de vitre. Le vitrage est collé au cadre bois, ce qui rigidifie l'ouvrant. Triple vitrage possible.",
    detail: "Double vitrage de série · triple en option · vitrage certifié CEKAL",
  },
  {
    layer: "joints",
    titre: "Les joints : air, eau, vent",
    texte:
      "Des joints d'étanchéité entre dormant et ouvrant arrêtent l'air, l'eau et le vent. La fenêtre à frappe MéO est classée A*4 E*7A V*A2 : A*4 est la classe la plus élevée pour la perméabilité à l'air.",
    detail: "A*4 · E*7A · V*A2",
  },
  {
    layer: "tout",
    titre: "Le résultat : Uw 1,2 en double vitrage",
    texte:
      "Ouvrant de 67 mm en design plat ou 75 mm en design galbé. Coefficient Uw de 1,2 W/m²·K en double vitrage et 0,7 en triple : plus il est bas, plus la fenêtre isole. Les valeurs de votre projet dépendent de ses dimensions et de son vitrage : elles figurent sur le devis.",
    detail: "Uw 1,2 · Sw 0,47 · TLw 0,58 · 28 dB",
  },
];

const legende = [
  { layer: "bois", label: "Bois", couleur: "#E4C79A" },
  { layer: "alu", label: "Aluminium", couleur: "#3A3F45" },
  { layer: "plots", label: "Plots", couleur: "#1a1b1f" },
  { layer: "vitrage", label: "Vitrage", couleur: "#9CCDF0" },
  { layer: "joints", label: "Joints", couleur: "#6b6b6b" },
];

const avantages = [
  {
    titre: "Le bois isole, l'aluminium protège",
    texte:
      "Uw 1,2 en double vitrage, 0,7 en triple, pour la fenêtre à frappe. MéO rappelle qu'un Uw inférieur ou égal à 1,3 est devenu le standard d'une rénovation performante.",
  },
  {
    titre: "Un bois sans entretien",
    texte:
      "À l'intérieur, le bois reçoit un traitement insecticide et fongicide puis une lasure de finition en phase aqueuse : un dépoussiérage au chiffon doux suffit.",
  },
  {
    titre: "Une façade qui ne bouge pas",
    texte:
      "L'aluminium thermolaqué, certifié Qualimarine, résiste aux intempéries, aux chocs et aux UV. Une éponge non abrasive et de l'eau savonneuse pour le nettoyer.",
  },
  {
    titre: "Sur mesure, jusqu'au détail",
    texte:
      "13 finitions de bois, 28 teintes d'aluminium, 7 formes d'ouverture, petits-bois en applique ou intégrés, poignées, entrées d'air, volet roulant ou brise-soleil intégrés.",
  },
  {
    titre: "Éco-conçu, fabriqué en Vendée",
    texte:
      "Bois certifié PEFC, finitions sans solvant classées A+, fiches environnementales (FDES) publiées. L'usine de Cugand produit 42 % de son électricité et de son gaz.",
  },
  {
    titre: "Des qualités certifiées",
    texte:
      "Origine France Garantie, NF (certifiée par le FCBA), CEKAL pour le vitrage, Qualimarine pour le laquage, PEFC pour le bois. Garantie fabricant jusqu'à 10 ans.",
  },
];

// Palettes : codes et noms publiés par MéO. Les couleurs affichées sont des
// repères indicatifs (RAL pour l'aluminium), pas un nuancier contractuel.
const aluSatine = [
  ["9016 S", "#F1F0EA"], ["9001 S", "#E9E0D2"], ["8019 S", "#3D3635"], ["7039 S", "#6B695F"],
  ["7035 S", "#C5C7C4"], ["7024 S", "#45494E"], ["7021 S", "#2F3234"], ["6021 S", "#86A47C"],
  ["5023 S", "#42698C"], ["Canon", "#4A4E55"],
];
const aluTexture = [
  ["9011 T", "#27292B"], ["9007 T", "#878581"], ["9006 T", "#A1A1A0"], ["8011 T", "#5A3A29"],
  ["7030 T", "#8B8C7A"], ["7022 T", "#4B4D46"], ["7016 T", "#383E42"], ["6005 T", "#0F4336"],
  ["5003 T", "#1F3855"], ["3004 T", "#6B1C23"], ["1015 T", "#E6D2B5"],
];
const aluSable = [
  ["Gris 2900 sablé", "#55585C"], ["Gris 2800 sablé", "#75797E"], ["Bleu 2700 sablé", "#3E4C60"],
  ["Mars 2525 sablé", "#7D3F2A"], ["Noir 2100 sablé", "#1E1F21"],
];
const aluAutres = [["Anodisé naturel", "#B9BDC1"], ["Ton bois", "#8A5A32"]];
const boisPin = [
  ["Naturel", "#D9B98A"], ["Miel", "#C9924E"], ["Dune", "#C8B493"], ["Cendré", "#A89F94"],
  ["Blanc", "#F0ECE4"], ["Ardoise", "#5D6268"], ["Taupe", "#8C7B6E"],
];
const boisChene = [
  ["Naturel", "#C9A676"], ["Moyen", "#A87A4A"], ["Champagne", "#D9C7A6"], ["Polaire", "#E7E1D6"],
  ["Ébène", "#2E2622"], ["Blanchi", "#E2D7C6"],
];

// Valeurs publiées par MéO (double vitrage, formats Acotherm).
const performances = [
  ["Isolation thermique (Uw)", "1,2 W/m²·K", "1,4 W/m²·K"],
  ["Apports solaires (Sw)", "0,47", "0,53"],
  ["Lumière naturelle (TLw)", "0,58", "0,65"],
  ["Affaiblissement acoustique", "28 dB", "27 dB"],
  ["Étanchéité air, eau, vent", "A*4 E*7A V*A2", "A*4 E*6B V*A2"],
  ["Épaisseur de l'ouvrant", "67 mm (plat) ou 75 mm (galbé)", "57 mm (plat)"],
];

const engagements = [
  ["Installateur certifié", "Reconnu par MéO pour son expertise et la qualité de ses réalisations."],
  ["Pose dans les règles de l'art", "Installation soignée, conforme aux prescriptions du fabricant et aux normes en vigueur."],
  ["Spécialiste du bois-aluminium", "Connaissance de toute la gamme MéO, équipes formées régulièrement."],
  ["Interlocuteur unique", "Devis rapide, suivi du chantier et respect des délais."],
  ["Service après-vente", "En lien direct avec les équipes MéO."],
  ["Extension de garantie", "Gratuite, réservée aux poses par un Menuisier d'Excellence, à activer sous 14 jours."],
];

// FAQ : source unique pour le bloc visible et le FAQPage JSON-LD.
const faq = [
  {
    question: "Qui est MéO ?",
    reponse:
      "MéO est un fabricant français de menuiseries bois-aluminium sur mesure, installé à Cugand, en Vendée, à 30 km au sud de Nantes. L'entreprise est née en 1976 sous le nom de Menuiserie Clissonnaise, a créé le concept bois-aluminium en 1983, a rejoint le groupe familial vendéen Liébot en 1990 et porte la marque MéO depuis 2020. Elle fabrique des fenêtres et portes-fenêtres, des baies coulissantes, des portes d'entrée, des verrières et des murs rideaux, vendus et posés par des professionnels installateurs.",
  },
  {
    question: "Pourquoi du bois à l'intérieur et de l'aluminium à l'extérieur ?",
    reponse:
      "Chaque matériau est placé là où il est le meilleur. Le bois, naturellement le plus isolant, reste côté pièce : il apporte la chaleur d'une menuiserie traditionnelle et ne demande aucun entretien. L'aluminium, inaltérable, fait face aux intempéries et garde sa teinte : rien à repeindre côté façade. Les deux structures sont assemblées par plots, sans pont thermique.",
  },
  {
    question: "Qu'est-ce que l'effet bilame, et pourquoi les menuiseries MéO n'y sont pas sujettes ?",
    reponse:
      "Par forte chaleur, le profilé extérieur d'une menuiserie monte en température et s'allonge alors que le profilé intérieur reste à température ambiante : cette différence peut déformer provisoirement un coulissant et gêner sa fermeture. C'est l'effet bilame, un phénomène réversible. Sur les menuiseries MéO, bois et aluminium sont assemblés par plots : l'aluminium se dilate librement sans déformer l'ouvrant, ce qui permet les grandes baies de teinte foncée, même exposées au sud ou à l'ouest.",
  },
  {
    question: "Double ou triple vitrage ?",
    reponse:
      "Le double vitrage 4/20/TBE 4 de série donne un Uw de 1,2 sur la fenêtre à frappe ; le triple vitrage descend à 0,7 mais laisse entrer un peu moins de chaleur solaire gratuite en hiver. MéO conseille de raisonner sur le bilan thermique global du logement : le triple vitrage a surtout un intérêt dans une maison déjà bien isolée en toiture et en murs, ou dans les régions aux hivers très froids. Nous en parlons au moment du devis.",
  },
  {
    question: "Quel entretien pour des menuiseries bois-aluminium MéO ?",
    reponse:
      "À l'intérieur, un dépoussiérage du bois avec un chiffon doux. À l'extérieur, un nettoyage de l'aluminium à l'eau claire avec un savon doux et une éponge non abrasive. Il n'y a ni peinture ni lasure à refaire : le bois est protégé en usine par un traitement insecticide et fongicide et une lasure en phase aqueuse.",
  },
  {
    question: "Quelle garantie sur des menuiseries MéO posées par Fenêtres sur Loir ?",
    reponse:
      "Les menuiseries MéO sont garanties jusqu'à 10 ans par le fabricant, selon les conditions de sa notice de garantie. La pose est couverte par notre garantie décennale. Comme nous sommes Menuisier d'Excellence MéO, vous pouvez en plus activer gratuitement l'extension de garantie proposée par MéO, dans les 14 jours qui suivent la signature du procès-verbal de fin de chantier.",
  },
  {
    question: "Qu'est-ce qu'un Menuisier d'Excellence MéO ?",
    reponse:
      "MéO ne vend pas aux particuliers : ses menuiseries sont posées par des professionnels installateurs. Le Club des Menuisiers d'Excellence, fondé en 2012, réunit ceux que le fabricant reconnaît pour leur maîtrise de ses produits, la qualité de leur pose et leur service après-vente. Fenêtres sur Loir en fait partie et a reçu en 2025 deux Trophées d'or MéO : meilleure vente de portes d'entrée et meilleure performance.",
  },
  {
    question: "Peut-on peindre le bois intérieur ?",
    reponse:
      "Oui, si vous choisissez la finition pin blanc : MéO indique qu'elle peut être recouverte d'une couleur de votre choix pour s'accorder à votre décoration. Les autres finitions sont des lasures qui laissent voir le veinage ; certaines l'estompent, comme le pin taupe ou le pin ardoise.",
  },
  {
    question: "De quoi dépend le prix d'une menuiserie MéO ?",
    reponse:
      "De l'essence (pin ou chêne) et de la finition, des dimensions et de la forme, du type d'ouverture, du vitrage (double ou triple, acoustique, feuilleté), des options (petits-bois, volet roulant intégré, poignée) et du mode de pose, en rénovation ou en dépose totale. Le bois-alu se situe au-dessus du PVC et de l'aluminium à dimensions égales. Le devis est gratuit, détaillé et remis sous 48 h après une prise de mesures à domicile.",
  },
];

const partageSujet = encodeURIComponent("Les menuiseries bois-aluminium MéO, expliquées par Fenêtres sur Loir");
const partageCorps = encodeURIComponent(
  `Bonjour,\n\nVoici la page qui explique les menuiseries bois-aluminium MéO que nous posons : le concept en coupe, les performances, les finitions et les garanties.\n${PAGE_URL}\n\nFenêtres sur Loir, Menuisier d'Excellence MéO`,
);
const partageWhatsapp = encodeURIComponent(`Les menuiseries bois-aluminium MéO expliquées par Fenêtres sur Loir : ${PAGE_URL}`);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationNode(),
    agencyNode("seiches"),
    {
      "@type": "Brand",
      "@id": `${PAGE_URL}#meo`,
      name: "MéO",
      url: "https://www.fenetremeo.com/",
      description:
        "Créateur du concept de menuiserie bois-aluminium en 1983, fabricant français de fenêtres, baies coulissantes, portes d'entrée, verrières et murs rideaux bois-aluminium sur mesure, à Cugand (Vendée).",
    },
    {
      "@type": "Service",
      "@id": `${PAGE_URL}#service`,
      serviceType: "Fourniture et pose de menuiseries bois-aluminium MéO",
      name: "Menuiseries bois-aluminium MéO",
      description,
      provider: { "@id": agencyId("seiches") },
      brand: { "@id": `${PAGE_URL}#meo` },
      areaServed: { "@type": "AdministrativeArea", name: "Maine-et-Loire" },
    },
    {
      "@type": "FAQPage",
      "@id": `${PAGE_URL}#faq`,
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.reponse },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} ogImage="/og/meo-bois-alu.jpg" schemaJsonLd={schema}>
  <!-- Posé avant le rendu pour que les états « masqué avant apparition » ne
       s'appliquent qu'avec JavaScript (voir global.css, data-reveal). -->
  <script is:inline>document.documentElement.setAttribute("data-js", "");</script>

  <!-- Hero : header transparent (data-hero-section), image en parallaxe -->
  <section
    class="meo-hero relative isolate overflow-hidden text-white -mt-[116px]"
    data-hero-section
    style="min-height: clamp(640px, 92vh, 960px);"
  >
    <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <Image
        src={heroImg}
        alt=""
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        format="webp"
        quality={78}
        class="w-full h-full object-cover will-change-transform"
        data-parallax-img
      />
    </div>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-black/70 via-black/45 to-black/70 sm:bg-gradient-to-r sm:from-black/80 sm:via-black/45 sm:to-black/15"
      aria-hidden="true"
    ></div>

    <Container width="wide" class="relative flex flex-col min-h-[inherit] pt-36 sm:pt-44 pb-10 lg:pb-12">
      <Breadcrumb items={breadcrumb} class="meo-hero-crumb" />

      <div class="mt-auto pt-10 max-w-3xl">
        <div class="flex items-center gap-4 mb-6" data-rise style="--rise: 0">
          <span class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-white p-2 shadow-lg">
            <Image src={meoLogo} alt="Logo MéO" widths={[56, 112]} sizes="56px" loading="eager" decoding="async" format="webp" quality={90} class="max-w-full max-h-full object-contain" />
          </span>
          <p class="text-[12px] font-semibold tracking-[0.18em] uppercase text-white/85">
            Nos partenaires · Menuisier d'Excellence MéO
          </p>
        </div>
        <h1
          class="font-display text-white text-balance text-[clamp(2.1rem,4.8vw,3.75rem)] leading-[1.08] drop-shadow-[0_2px_18px_rgba(0,0,0,0.5)]"
          data-rise
          style="--rise: 1"
        >
          MéO : le bois à l'intérieur, l'aluminium à l'extérieur.
          <strong class="font-bold italic">Sans compromis.</strong>
        </h1>
        <p class="mt-6 max-w-2xl text-[16px] sm:text-[18px] leading-relaxed text-white/90" data-rise style="--rise: 2">
          Le fabricant vendéen a créé la fenêtre bois-aluminium en 1983. Fenêtres sur Loir la
          pose depuis plus de vingt ans. Cette page explique comment elle est faite, ce qu'elle
          apporte et ce que vous pouvez choisir.
        </p>
        <div class="mt-8 flex flex-wrap gap-3" data-rise style="--rise: 3">
          <a
            href="#coupe"
            class="inline-flex items-center gap-2 rounded-full px-7 py-3 text-[14px] font-medium text-white shadow-sm transition-colors bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)]"
          >
            Voir la fenêtre en coupe
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium text-white border border-white/50 hover:bg-white hover:text-[var(--color-fg)] transition-colors"
          >
            Demander un devis gratuit
          </a>
        </div>
      </div>

      <!-- Bas du hero : repères puis trophées, à gauche pour laisser le coin
           bas droit au dock des boutons flottants -->
      <div class="mt-12 flex flex-col gap-6 max-w-3xl lg:pr-56" data-rise style="--rise: 4">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-white/85" aria-label="Repères MéO">
          <li class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>Créateur du concept bois-alu en 1983</li>
          <li class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>Fabriqué à Cugand, en Vendée</li>
          <li class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>Garantie fabricant jusqu'à 10 ans</li>
        </ul>
        <ul class="flex flex-wrap items-end gap-x-8 gap-y-4" aria-label="Distinctions MéO 2025 décernées à Fenêtres sur Loir">
          <li>
            <Image src={tropheePortes} alt="Trophée d'or MéO 2025, meilleure vente de portes d'entrée, décerné à Fenêtres sur Loir" widths={[300, 600]} sizes="240px" loading="eager" decoding="async" format="webp" quality={90} class="h-12 sm:h-14 w-auto object-contain" style="filter: drop-shadow(0 1px 6px rgba(0,0,0,0.55));" />
          </li>
          <li>
