                    <span class="w-3 h-3 rounded-sm ring-1 ring-black/10" style={`background:${l.couleur}`} aria-hidden="true"></span>
                    {l.label}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Étapes -->
        <ol class="meo-coupe-steps">
          {coupe.map((c, i) => (
            <li class="meo-coupe-step" data-coupe-step={c.layer}>
              <div class="flex items-start gap-4">
                <span class="meo-coupe-num shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full ring-1 ring-[var(--color-border)] bg-white font-display text-[15px] font-bold text-[var(--color-fg)]">
                  {i + 1}
                </span>
                <div>
                  <h3 class="text-[1.25rem] leading-snug">{c.titre}</h3>
                  <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-muted)]">{c.texte}</p>
                  <p class="mt-3 text-[12px] font-semibold tracking-[0.08em] uppercase text-[var(--color-accent)]">{c.detail}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <p class="mt-10 max-w-3xl text-[13px] text-[var(--color-muted)]" data-reveal>
        Sources : MéO, fiche « Fenêtres bois-aluminium » (concept produit et caractéristiques
        techniques de la fenêtre à frappe double vitrage, 2 vantaux en pin au format Acotherm),
        pages « L'alliance bois-aluminium » et « Qu'est-ce que l'effet bilame ? », relevées le
        12 octobre 2026 sur fenetremeo.com.
      </p>
    </Container>
  </section>

