<style is:global>
  /* Fil d'Ariane posé dans le hero sombre */
  .meo-hero .meo-hero-crumb ol,
  .meo-hero .meo-hero-crumb a,
  .meo-hero .meo-hero-crumb span {
    color: rgba(255, 255, 255, 0.72) !important;
  }
  .meo-hero .meo-hero-crumb a:hover,
  .meo-hero .meo-hero-crumb [aria-current="page"] {
    color: #fff !important;
  }

  /* Hero : titre, texte et boutons montent à l'arrivée */
  @media (prefers-reduced-motion: no-preference) {
    .meo-hero [data-rise] {
      animation: meo-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(120ms + var(--rise, 0) * 110ms);
    }
    @keyframes meo-rise {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* Coupe animée */
  .meo-coupe-svg text {
    font-family: var(--font-body);
  }
  .meo-coupe-halo {
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .meo-coupe-svg [data-layer] {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.4s ease;
  }
  .meo-coupe-svg [data-layer].is-active {
    filter: drop-shadow(0 0 7px rgba(108, 177, 230, 0.85));
  }
  .meo-coupe-svg [data-layer="plots"] .meo-coupe-hint {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .meo-coupe-svg [data-layer="plots"].is-active .meo-coupe-hint {
    opacity: 1;
  }
  .meo-coupe-svg [data-callout] {
    transition: opacity 0.5s ease;
  }
  .meo-coupe-svg [data-callout] circle {
    fill: #fff;
    stroke: #1a1b1f;
    stroke-width: 1.2;
    transition: fill 0.3s ease, stroke 0.3s ease;
  }
  .meo-coupe-svg [data-callout] text {
    fill: #1a1b1f;
    transition: fill 0.3s ease;
  }
  .meo-coupe-svg [data-callout].is-active circle {
    fill: var(--color-accent);
    stroke: var(--color-accent);
  }
  .meo-coupe-svg [data-callout].is-active text {
    fill: #fff;
  }
  /* États « pas encore posé » : seulement avec JavaScript */
  [data-coupe][data-js] .meo-coupe-svg [data-layer]:not([data-layer="mur"]):not(.is-built) {
    opacity: 0.12;
  }
  [data-coupe][data-js] .meo-coupe-svg [data-callout]:not(.is-built) {
    opacity: 0;
  }
  /* Joints et cote : invisibles tant qu'ils ne sont pas posés (même
     spécificité que la règle générale ci-dessus, déclarés après). */
  [data-coupe][data-js] .meo-coupe-svg [data-layer="joints"]:not([data-layer="mur"]):not(.is-built),
  [data-coupe][data-js] .meo-coupe-svg [data-layer="tout"]:not([data-layer="mur"]):not(.is-built) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-coupe][data-js] .meo-coupe-svg [data-layer="alu"]:not(.is-built) {
      transform: translateX(-70px);
    }
    [data-coupe][data-js] .meo-coupe-svg [data-layer="plots"]:not(.is-built) {
      transform: scale(0.6);
    }
    [data-coupe][data-js] .meo-coupe-svg [data-layer="vitrage"]:not(.is-built) {
      transform: translateY(-60px);
    }
  }

  .meo-coupe-stage {
    z-index: 1;
  }
  @media (max-width: 1023px) {
    /* Scène épinglée sous le header ; `top` est mesuré en JS (hauteur réelle
       du header), 84px en secours. */
    .meo-coupe-stage {
      position: sticky;
      top: 84px;
      background: var(--color-subtle);
      padding-bottom: 0.5rem;
    }
    .meo-coupe-stage .meo-coupe-svg {
      max-height: 34vh;
    }
  }
  .meo-coupe-steps {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 1rem 2rem;
  }
  .meo-coupe-step {
    transition: opacity 0.45s ease;
  }
  @media (min-width: 1024px) {
    /* La scène tient sous le header (top 96 px) : SVG limité en hauteur, la
       liste garde de l'air en bas pour que la scène reste visible quand la
       dernière étape est au centre de l'écran. */
    .meo-coupe-stage .meo-coupe-svg {
      width: auto;
      max-width: 100%;
      max-height: min(640px, calc(100vh - 270px));
    }
    .meo-coupe-steps {
      gap: 0;
      padding-block: 0 24vh;
    }
    .meo-coupe-step {
      min-height: 58vh;
      display: flex;
      align-items: center;
      padding-block: 2rem;
    }
    .meo-coupe-step:first-child {
      min-height: 46vh;
      align-items: flex-start;
    }
    .meo-coupe-step:last-child {
      min-height: 46vh;
    }
  }
  [data-coupe][data-js] .meo-coupe-step {
    opacity: 0.38;
  }
  [data-coupe][data-js] .meo-coupe-step.is-active {
    opacity: 1;
  }
  .meo-coupe-step.is-active .meo-coupe-num {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  /* Impression : page lisible, sans navigation ni éléments flottants, coupe complète */
  @media print {
    [data-topbar],
    header[data-header],
    footer,
    [data-devis-popup],
    [data-annonce],
    .fixed,
    .meo-no-print {
      display: none !important;
    }
    .meo-hero {
      margin-top: 0 !important;
      min-height: 0 !important;
      color: #000 !important;
      background: #fff !important;
    }
    .meo-hero [data-parallax-img],
    .meo-hero .absolute {
      display: none !important;
    }
    .meo-hero h1,
    .meo-hero p,
    .meo-hero li {
      color: #000 !important;
      text-shadow: none !important;
    }
    .meo-hero img {
      filter: invert(1) !important;
    }
    .meo-hero [data-rise],
    .meo-coupe-svg [data-layer],
    .meo-coupe-svg [data-callout],
    .meo-coupe-step {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
    .meo-coupe-stage {
      position: static !important;
    }
    .meo-coupe-step {
      min-height: 0 !important;
      break-inside: avoid;
    }
    .section,
    .section-tight {
      padding-block: 1.5rem !important;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Apparition au défilement (data-reveal / data-reveal-group)
  {
    const groups = document.querySelectorAll<HTMLElement>("[data-reveal-group]");
    for (const g of groups) {
      const kids = g.querySelectorAll<HTMLElement>(":scope > * [data-reveal], :scope > [data-reveal]");
      kids.forEach((el, i) => {
        if (!el.style.getPropertyValue("--reveal-delay")) el.style.setProperty("--reveal-delay", String(Math.min(i, 12) * 80));
      });
    }
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if ("IntersectionObserver" in window && targets.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
      );
      targets.forEach((t) => io.observe(t));
    } else {
      targets.forEach((t) => t.classList.add("is-in"));
    }
  }

  // Parallaxe douce de l'image du hero
  {
    const img = document.querySelector<HTMLElement>("[data-parallax-img]");
    if (img && !reduced) {
      let ticking = false;
      const apply = () => {
        ticking = false;
        const y = Math.min(window.scrollY, window.innerHeight);
        img.style.transform = `translate3d(0, ${(y * 0.22).toFixed(1)}px, 0) scale(1.08)`;
      };
      img.style.transform = "scale(1.08)";
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(apply);
        },
        { passive: true },
      );
    }
  }

  // Chiffres qui se comptent
  {
    const section = document.querySelector<HTMLElement>("[data-count-section]");
    if (section) {
      const counters = section.querySelectorAll<HTMLElement>("[data-count]");
      const animate = (el: HTMLElement, target: number, duration = 1500) => {
        if (reduced) {
          el.textContent = String(target);
          return;
        }
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            counters.forEach((el) => animate(el, Number(el.dataset.target ?? 0)));
            io.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      io.observe(section);
    }
  }

  // Coupe animée : l'étape au centre de l'écran pose sa couche
  {
    const root = document.querySelector<HTMLElement>("[data-coupe]");
    if (root) {
      const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-coupe-step]"));
      const layers = Array.from(root.querySelectorAll<SVGGElement>("[data-layer]"));
      const callouts = Array.from(root.querySelectorAll<SVGGElement>("[data-callout]"));
      const order = steps.map((s) => s.dataset.coupeStep ?? "");

      const setStep = (i: number) => {
        const current = order[i];
        const last = i === order.length - 1;
        steps.forEach((s, k) => s.classList.toggle("is-active", k === i));
        for (const l of layers) {
          const name = l.dataset.layer ?? "";
          if (name === "mur") continue;
          const idx = order.indexOf(name);
          const built = idx !== -1 && (idx <= i || last);
          l.classList.toggle("is-built", built);
          l.classList.toggle("is-active", name === current && !last);
        }
        for (const c of callouts) {
          const name = c.dataset.callout ?? "";
          const idx = order.indexOf(name);
          c.classList.toggle("is-built", idx !== -1 && (idx <= i || last));
          c.classList.toggle("is-active", name === current);
        }
      };

      root.setAttribute("data-js", "");
      setStep(0);

      // Sous 1024 px, la scène est épinglée en haut : elle doit coller au
      // header (hauteur mesurée) et l'étape « active » est celle qui passe
      // dans la zone visible sous la scène, pas au centre de l'écran.
      const stage = root.querySelector<HTMLElement>(".meo-coupe-stage");
      const header = document.querySelector<HTMLElement>("header[data-header]");
      const narrow = () => window.innerWidth < 1024;
      // Valeur `top` de l'écran large (inline dans le HTML), à restaurer
      const wideTop = stage?.style.top ?? "";
      let topTick = false;
      const placeStage = () => {
        topTick = false;
        if (!stage) return;
        if (narrow()) {
          const bottom = header ? Math.max(0, header.getBoundingClientRect().bottom) : 0;
          stage.style.top = `${Math.round(bottom)}px`;
        } else {
          stage.style.top = wideTop;
        }
      };
      // La barre supérieure se montre ou se cache avec une transition selon
      // le sens du défilement : on remesure aussi une fois la transition finie.
      let later1 = 0;
      let later2 = 0;
      const schedulePlace = () => {
        if (!narrow()) return;
        if (!topTick) {
          topTick = true;
          requestAnimationFrame(placeStage);
        }
        window.clearTimeout(later1);
        window.clearTimeout(later2);
        later1 = window.setTimeout(placeStage, 240);
        later2 = window.setTimeout(placeStage, 520);
      };
      placeStage();
      window.addEventListener("scroll", schedulePlace, { passive: true });
      window.addEventListener("resize", placeStage);

      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) setStep(steps.indexOf(e.target as HTMLElement));
            }
          },
          { rootMargin: narrow() ? "-58% 0px -22% 0px" : "-42% 0px -42% 0px", threshold: 0 },
        );
        steps.forEach((s) => io.observe(s));
      } else {
        setStep(order.length - 1);
      }

      // Légende cliquable : amène l'étape correspondante au centre
      root.querySelectorAll<HTMLButtonElement>("[data-coupe-goto]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = steps.find((s) => s.dataset.coupeStep === btn.dataset.coupeGoto);
          target?.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "center" });
        });
      });
    }
  }

  // Transmettre : copier le lien, imprimer
  {
    const box = document.querySelector<HTMLElement>("[data-share]");
    if (box) {
      const copyBtn = box.querySelector<HTMLButtonElement>("[data-share-copy]");
      const label = box.querySelector<HTMLElement>("[data-share-copy-label]");
      copyBtn?.addEventListener("click", async () => {
        const url = window.location.origin + window.location.pathname;
        try {
          await navigator.clipboard.writeText(url);
          if (label) label.textContent = "Lien copié";
        } catch {
          window.prompt("Copiez ce lien :", url);
        }
        window.setTimeout(() => {
          if (label) label.textContent = "Copier le lien";
        }, 2200);
      });
      box.querySelector<HTMLButtonElement>("[data-share-print]")?.addEventListener("click", () => window.print());
    }
  }
</script>
