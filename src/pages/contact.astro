---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import ContactForm from "../components/sections/ContactForm.astro";
import showroomImg from "../assets/showroom-1.png";

const title = "Contact & devis gratuit | Fenêtres sur Loir — Menuisier à Seiches-sur-le-Loir";
const description = "Contactez Fenêtres sur Loir à Seiches-sur-le-Loir (49). Devis gratuit, conseil personnalisé, visite du showroom de 300 m². Intervention à Angers et dans tout le Maine-et-Loire.";

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Contact" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Fenêtres sur Loir",
  telephone: "+33241770408",
  email: "contacts@fenetres-sur-loir.fr",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ZA de la Suzerolle",
    postalCode: "49140",
    addressLocality: "Seiches-sur-le-Loir",
    addressCountry: "FR",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+33241770408",
    contactType: "customer service",
    areaServed: "FR",
    availableLanguage: "French",
  },
};

const zoneVilles = [
  "Angers",
  "Durtal",
  "Baugé",
  "Tiercé",
  "Châteauneuf-sur-Sarthe",
  "Le Lion-d'Angers",
  "Beaufort-en-Anjou",
];
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb} schemaJsonLd={schema}>
  <section class="section-tight">
    <Container width="default">
      <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
        Contact
      </p>
      <h1 class="text-balance max-w-3xl">
        Parlons de votre projet : devis gratuit et personnalisé
      </h1>
      <p class="mt-6 max-w-2xl text-[16px] text-[var(--color-fg)] leading-relaxed">
        Fenêtre, porte d'entrée, baie vitrée, volet ou carport : décrivez-nous votre projet et
        <strong>notre équipe vous recontacte sous 48 h ouvrées</strong> pour un premier échange.
      </p>
      <p class="mt-3 max-w-2xl text-[15px] text-[var(--color-muted)] leading-relaxed">
        Le devis est <strong class="text-[var(--color-fg)]">gratuit et sans engagement</strong>.
        Conseil sur-mesure, étude technique, visite à domicile et accompagnement
        sur les <strong class="text-[var(--color-fg)]">aides à la rénovation énergétique</strong> grâce à
        notre certification RGE Qualibat.
      </p>

      <!-- Raccourcis tactiles : utile en mobile -->
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="tel:+33241770408"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-[14px] font-medium text-white shadow-sm transition-colors"
          style="background: var(--color-accent);"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.35 1.84.59 2.8.72A2 2 0 0 1 22 16.92z"/>
          </svg>
          02 41 77 04 08
        </a>
        <a
          href="mailto:contacts@fenetres-sur-loir.fr"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-[14px] font-medium border border-[var(--color-fg)]/15 text-[var(--color-fg)] hover:bg-[var(--color-tint)] transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <polyline points="3 7 12 13 21 7" />
          </svg>
          contacts@fenetres-sur-loir.fr
        </a>
      </div>
    </Container>
  </section>

  <section class="pb-12">
    <Container width="default">
      <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
        <Image
          src={showroomImg}
          alt="Showroom Fenêtres sur Loir à Seiches-sur-le-Loir — accueil et conseil"
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 1280px) 100vw, 1280px"
          loading="lazy"
          decoding="async"
          format="webp"
          quality={80}
          class="w-full h-auto aspect-[16/9] object-cover"
        />
      </div>
    </Container>
  </section>

  <ContactForm withHeading={false} />

  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <h2 class="mb-4">Visitez notre showroom de 300 m²</h2>
          <address class="not-italic text-[15px] text-[var(--color-muted)] leading-relaxed space-y-3">
            <p>
              <strong class="text-[var(--color-fg)]">Adresse</strong><br />
              ZA de la Suzerolle<br />
              49140 Seiches-sur-le-Loir
            </p>
            <p>
              <strong class="text-[var(--color-fg)]">Téléphone</strong><br />
              <a href="tel:+33241770408" class="text-[var(--color-accent)] hover:underline">02 41 77 04 08</a>
            </p>
            <p>
              <strong class="text-[var(--color-fg)]">Email</strong><br />
              <a href="mailto:contacts@fenetres-sur-loir.fr" class="text-[var(--color-accent)] hover:underline">contacts@fenetres-sur-loir.fr</a>
            </p>
            <p>
              <strong class="text-[var(--color-fg)]">Horaires</strong><br />
              Lundi – Vendredi : 9 h – 18 h<br />
              Samedi : sur rendez-vous<br />
              Dimanche : fermé
            </p>
          </address>
        </div>
        <div>
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)] h-full min-h-[300px]">
            <iframe
              title="Localisation du showroom Fenêtres sur Loir à Seiches-sur-le-Loir"
              src="https://www.google.com/maps?q=ZA+de+la+Suzerolle,+49140+Seiches-sur-le-Loir&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full h-full min-h-[300px] border-0"
            ></iframe>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="section-tight">
    <Container width="default">
      <h2 class="mb-4">Zone d'intervention</h2>
      <p class="text-[15px] text-[var(--color-muted)] leading-relaxed mb-6">
        Fenêtres sur Loir intervient à <strong class="text-[var(--color-fg)]">Seiches-sur-le-Loir</strong> et dans tout le <strong class="text-[var(--color-fg)]">Maine-et-Loire</strong> :
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          zoneVilles.map((ville) => (
            <li class="inline-flex items-center px-3 py-1.5 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full">
              {ville}
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</BaseLayout>
