<script>
  document.querySelectorAll<HTMLButtonElement>("[data-cmp-print]").forEach((b) =>
    b.addEventListener("click", () => window.print()),
  );
  const box = document.querySelector<HTMLElement>("[data-share]");
  if (box) {
    const label = box.querySelector<HTMLElement>("[data-share-copy-label]");
    box.querySelector<HTMLButtonElement>("[data-share-copy]")?.addEventListener("click", async () => {
      const url = window.location.origin + window.location.pathname;
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = "Lien copié";
      } catch {
        window.prompt("Copiez ce lien :", url);
      }
      window.setTimeout(() => {
        if (label) label.textContent = "Copier le lien";
      }, 2200);
    });
  }
</script>
