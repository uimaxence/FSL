---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import CTASection from "../../components/sections/CTASection.astro";
import { getRealisationMedia } from "../../lib/realisations-media";

const realisations = (await getCollection("realisations")).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0),
);

const title = "Nos réalisations | Fenêtres sur Loir — Projets menuiserie à Angers et dans le Maine-et-Loire";
const description = "Découvrez les plus belles réalisations Fenêtres sur Loir : menuiseries, portes, verrières et volets signés MéO, Bubendorff, Arcades & Baies. Vidéos et photos professionnelles.";

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Réalisations" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: "Réalisations Fenêtres sur Loir",
  author: { "@type": "LocalBusiness", name: "Fenêtres sur Loir" },
};
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb} schemaJsonLd={schema}>
  <section class="section-tight">
    <Container width="default">
      <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
        Réalisations
      </p>
      <h1 class="text-balance max-w-4xl">
        Nos plus belles <strong class="font-bold italic">réalisations</strong> en menuiserie sur mesure
      </h1>
      <p class="mt-6 max-w-2xl text-[16px] text-[var(--color-muted)] leading-relaxed">
        Chaque projet est une rencontre, une histoire et un savoir-faire mis en œuvre. À travers ces photos, découvrez comment Fenêtres sur Loir transforme chaque maison en un lieu unique, lumineux et confortable.
      </p>
    </Container>
  </section>

  <section class="pb-16">
    <Container width="wide">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          realisations.map((r, i) => {
            const media = getRealisationMedia(r.id);
            return (
              <li>
                <a href={`/realisations/${r.id}/`} class="group block rounded-2xl overflow-hidden bg-white ring-1 ring-[var(--color-border)] hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                  <div class="relative aspect-[4/3] overflow-hidden">
                    <Image
                      src={media.cover}
                      alt={`${r.data.title} à ${r.data.location} — Fenêtres sur Loir`}
                      widths={[400, 700, 1000]}
                      sizes="(max-width: 1024px) 50vw, 33vw"
                      loading={i < 3 ? "eager" : "lazy"}
                      decoding="async"
                      format="webp"
                      quality={78}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
                  </div>
                  <div class="p-6">
                    <p class="text-[11px] uppercase tracking-[0.14em] text-[var(--color-accent)] font-semibold">
                      {r.data.location}{r.data.year ? ` · ${r.data.year}` : ""}
                    </p>
                    <h3 class="mt-2 text-[var(--color-fg)] group-hover:text-[var(--color-accent)] transition-colors">
                      {r.data.title}
                    </h3>
                    {r.data.description && (
                      <p class="mt-3 text-sm text-[var(--color-muted)] leading-relaxed line-clamp-3">
                        {r.data.description}
                      </p>
                    )}
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </Container>
  </section>

  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Derrière chaque image, une histoire d'artisanat</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Nos projets mêlent <strong class="text-[var(--color-fg)]">performance énergétique</strong>, <strong class="text-[var(--color-fg)]">design durable</strong> et <strong class="text-[var(--color-fg)]">respect du patrimoine</strong>. Les matériaux choisis — bois, aluminium, PVC — sont toujours sélectionnés pour durer et valoriser l'habitat.
        </p>
      </div>
    </Container>
  </section>

  <CTASection
    eyebrow="Votre projet"
    title="Et si votre maison était la prochaine ?"
    text="Vous avez un projet de rénovation, d'aménagement ou de construction neuve ? Venez nous parler de vos envies — devis gratuit sous 48 h."
    secondaryLabel="Visiter le showroom"
    secondaryHref="/entreprise/notre-histoire/#showroom"
  />
</BaseLayout>
