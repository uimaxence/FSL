---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageProduit from "../../../components/templates/PageProduit.astro";
import Container from "../../../components/ui/Container.astro";
import fenetreHero from "../../../assets/porte-fenetre-1.png";

const title = "Fenêtres sur mesure | Fenêtres sur Loir près d'Angers";
const description = "[À RÉDIGER — Meta description Fenêtres : bois, alu, PVC, mixte, performance thermique, partenaires MéO et Arcades & Baies]";

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Nos solutions", href: "/solutions/confort-interieur" },
  { label: "Portes & Fenêtres", href: "/solutions/portes-fenetres" },
  { label: "Fenêtres" },
];
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb}>
  <PageProduit
    eyebrow="Portes & Fenêtres"
    title="[À RÉDIGER — H1 page Fenêtres]"
    heroPlaceholderLabel="Fenêtre bois-alu MéO en gros plan"
    heroImage={fenetreHero}
    heroImageAlt="Fenêtre bois-aluminium MéO sur mesure installée par Fenêtres sur Loir"
  >
    <p class="italic">
      [À RÉDIGER — Intro : présentation du savoir-faire Fenêtres sur Loir sur les fenêtres,
      partenariats MéO et Arcades & Baies, certifications RGE Qualibat.]
    </p>

    <h2>[À RÉDIGER — Pourquoi choisir vos fenêtres avec nous ?]</h2>
    <p class="italic">[À RÉDIGER — Bénéfices principaux : performance énergétique, esthétique, durabilité.]</p>

    <h2>[À RÉDIGER — Matériaux disponibles]</h2>
    <ul>
      <li>[À RÉDIGER — Bois]</li>
      <li>[À RÉDIGER — Aluminium]</li>
      <li>[À RÉDIGER — PVC]</li>
      <li>[À RÉDIGER — Mixte bois-alu]</li>
    </ul>

    <h2>[À RÉDIGER — Performance thermique et acoustique]</h2>
    <p class="italic">[À RÉDIGER — Vitrages, normes RE2020, Acotherm, conformité aides RGE.]</p>
  </PageProduit>

  <section class="pb-20">
    <Container width="default">
      <div class="max-w-3xl mx-auto flex flex-wrap gap-3 justify-center">
        <a href="/contact" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium text-white shadow-sm" style="background: var(--color-accent);">
          Demander un devis
        </a>
        <a href="/partenaires/meo" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium border border-[var(--color-fg)] text-[var(--color-fg)]">
          Découvrir MéO
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
