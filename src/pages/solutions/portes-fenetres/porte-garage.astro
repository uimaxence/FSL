---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/ui/Container.astro";
import CTASection from "../../../components/sections/CTASection.astro";
import CertificationsBanner from "../../../components/sections/CertificationsBanner.astro";
import ConseilsLies from "../../../components/sections/ConseilsLies.astro";

import garageHero from "../../../assets/carport-1.png";
import garageSectionnelle from "../../../assets/porte-1-boisalu.png";
import garageLaterale from "../../../assets/porte-2-boisalu.png";
import garageEnroulable from "../../../assets/porte-4-alu.png";

// SEO (14/09/2026) : GSC cumule ~540 impressions/12 mois sur « porte de garage
// angers / 49 / maine et loire » en positions 30-60 (KD 0), et l'ancienne URL
// /fr/16/… (portes sectionnelles) en recevait 495 de plus en 404. La SERP locale
// est tenue par des pages produit localisées (Janneau, Fermetures Angevines,
// Ateliers Michel…) et les « autres questions » portent toutes sur le prix et
// les aides → mot-clé + ville en tête de title/H1, section aides/TVA, FAQ visible +
// FAQPage, zone d'intervention explicite. Pas de prix affichés (choix client).
const title = "Porte de garage à Angers (49) — Sectionnelle, enroulable";
const description =
  "Portes de garage sectionnelles, enroulables et latérales posées à Angers et en Maine-et-Loire : motorisation, isolation, sur mesure. Installateur depuis 2003.";

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Nos solutions", href: "/solutions/confort-interieur/" },
  { label: "Portes & Fenêtres", href: "/solutions/portes-fenetres/" },
  { label: "Porte de garage" },
];

// FAQ : source unique pour le bloc visible ET le FAQPage JSON-LD.
// Questions calquées sur les « autres questions posées » de la SERP
// « porte de garage angers » (prix posé, budget, aides/impôts) + choix du type.
const faq = [
  {
    question: "De quoi dépend le prix d'une porte de garage posée ?",
    reponse:
      "D'abord du type de porte — sectionnelle, enroulable ou latérale —, puis des dimensions, de l'épaisseur et de l'isolation des panneaux, de la motorisation et des finitions (hublots, portillon intégré, coloris). La dépose de l'ancienne porte et l'état de la baie comptent aussi. Nous établissons un devis détaillé et gratuit après une prise de mesures à domicile, pour comparer les options à budget égal.",
  },
  {
    question: "Une porte de garage est-elle éligible aux aides à la rénovation énergétique ?",
    reponse:
      "Non : la porte de garage ne fait pas partie des travaux couverts par MaPrimeRénov', les primes CEE ou la TVA à 5,5 %, réservés aux postes de performance énergétique (fenêtres, isolation, chauffage), et le crédit d'impôt a disparu depuis 2021. En revanche, dans un logement achevé depuis plus de deux ans, la fourniture et la pose bénéficient de la TVA réduite à 10 %. Si vous changez vos fenêtres en même temps, ces postes-là restent éligibles aux aides avec un artisan RGE comme Fenêtres sur Loir.",
  },
  {
    question: "Porte de garage sectionnelle ou enroulable : laquelle choisir ?",
    reponse:
      "La sectionnelle, dont les panneaux coulissent au plafond, offre la meilleure isolation et le plus grand choix de finitions : c'est le standard pour un garage attenant à la maison. L'enroulable, dont les lames s'enroulent dans un coffre, libère totalement le plafond et les murs, idéale pour un garage bas de plafond, encombré ou utilisé comme atelier. La sectionnelle latérale s'ouvre sur le côté et permet un passage piéton sans ouvrir toute la porte.",
  },
  {
    question: "Peut-on motoriser une porte de garage existante ?",
    reponse:
      "Oui dans la plupart des cas, à condition que la porte soit en bon état mécanique et correctement équilibrée. Nous installons des motorisations avec arrêt sur obstacle, déverrouillage manuel en cas de coupure de courant et commande à distance, compatibles avec les systèmes domotiques courants. Si la porte est ancienne ou déformée, le remplacement complet est souvent plus sûr et plus économique qu'une motorisation seule.",
  },
  {
    question: "Quels sont les délais pour une porte de garage sur mesure ?",
    reponse:
      "Comptez en général 4 à 8 semaines entre la validation du devis et la pose, le temps de la fabrication sur mesure. La pose elle-même prend une journée, réalisée par nos équipes salariées, avec dépose et évacuation de l'ancienne porte.",
  },
  {
    question: "Intervenez-vous en dehors d'Angers ?",
    reponse:
      "Oui : nos deux agences de Seiches-sur-le-Loir et Doué-en-Anjou couvrent tout le Maine-et-Loire — Angers et son agglomération (Avrillé, Beaucouzé, Trélazé, Les Ponts-de-Cé, Saint-Barthélemy-d'Anjou), Saumur, Cholet, Baugé-en-Anjou, Durtal — ainsi que le sud de la Sarthe autour de La Flèche.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    provider: { "@id": "https://www.fenetres-sur-loir.fr/#organization" },
    name: "Porte de garage sur mesure : sectionnelle, latérale, enroulable",
    serviceType: "Installation de porte de garage",
    description,
    areaServed: ["Angers", "Maine-et-Loire", "Saumur", "Cholet", "Doué-en-Anjou", "Seiches-sur-le-Loir"],
    brand: { "@type": "Organization", name: "Fenêtres sur Loir" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.reponse },
    })),
  },
];
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb} schemaJsonLd={schema}>
  <!-- Hero -->
  <section class="section-tight">
    <Container width="wide">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-6">
          <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
            Portes & Fenêtres → Porte de garage
          </p>
          <h1 class="text-balance">
            Porte de garage <strong class="font-bold">sur mesure à Angers</strong> et en Maine-et-Loire : sectionnelle, latérale ou enroulable
          </h1>
          <p class="mt-5 text-[15px] leading-relaxed text-[var(--color-muted)]">
            Votre garage est une véritable extension de votre maison : il mérite une isolation sérieuse et une sécurité optimale. Chaque garage est unique — étroit, bas de plafond, encombré de tuyauterie — et chaque porte doit s'y adapter.
          </p>
          <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-muted)]">
            <strong class="text-[var(--color-fg)]">Fenêtres sur Loir</strong>, installateur de portes de garage depuis 2003 à <a href="/entreprise/notre-histoire/#showroom" class="text-[var(--color-accent)] underline underline-offset-4">Seiches-sur-le-Loir près d'Angers</a> et à Doué-en-Anjou, vous propose des portes de garage sur mesure, motorisées et isolantes, posées par ses propres équipes dans tout le Maine-et-Loire.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/contact/" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium text-white shadow-sm" style="background: var(--color-accent);">
              Demander un devis gratuit
            </a>
            <a href="#types" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium border border-[var(--color-fg)] text-[var(--color-fg)]">
              Voir les types
            </a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={garageHero}
              alt="Porte de garage sectionnelle sur mesure installée par Fenêtres sur Loir près d'Angers"
              widths={[500, 800, 1100]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              loading="eager"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <CertificationsBanner />

  <!-- Types de portes de garage -->
  <section id="types" class="section-tight bg-[var(--color-subtle)] scroll-mt-28">
    <Container width="default">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2>Trois types de portes de garage adaptés à votre maison</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Selon vos contraintes d'espace, vos besoins de motorisation et votre style architectural, nous vous orientons vers la meilleure option — à comparer dans notre showroom de Seiches-sur-le-Loir.
        </p>
      </div>

      <div class="max-w-5xl mx-auto space-y-12">
        <!-- Sectionnelle -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={garageSectionnelle}
              alt="Porte de garage sectionnelle motorisée — gris anthracite avec hublots"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={82}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div>
            <h3 class="text-[var(--color-accent)]">Porte de garage sectionnelle à Angers</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              <strong class="text-[var(--color-fg)]">Gain d'espace et design contemporain.</strong> Ses panneaux isolants coulissent sous le plafond : elle convient aux garages de taille réduite, colle au plus près des parois et n'empiète ni sur l'allée ni sur l'intérieur.
            </p>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Panneaux isolants : la meilleure isolation thermique des trois familles</li>
              <li>• Motorisation pour ouverture rapide et silencieuse</li>
              <li>• Large choix de coloris, de rainurages, de hublots et de portillon intégré</li>
              <li>• Sécurisée, robuste, esthétique</li>
            </ul>
          </div>
        </article>

        <!-- Latérale -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2 rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={garageLaterale}
              alt="Porte de garage sectionnelle latérale — ouverture coulissante sur le côté"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={82}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div class="md:order-1">
            <h3 class="text-[var(--color-accent)]">Porte de garage sectionnelle latérale</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              Idéale si vous souhaitez <strong class="text-[var(--color-fg)]">conserver vos rangements en hauteur</strong> ou contourner une contrainte de plafond : les panneaux coulissent le long du mur latéral.
            </p>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Accès piéton facile sans ouverture complète</li>
              <li>• Pratique pour récupérer un objet ou sortir un vélo</li>
              <li>• Compatible avec les motorisations standard</li>
              <li>• Choix de finitions et coloris personnalisés</li>
            </ul>
          </div>
        </article>

        <!-- Enroulable -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={garageEnroulable}
              alt="Porte de garage enroulable — coffre compact, lames métalliques verticales"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={82}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div>
            <h3 class="text-[var(--color-accent)]">Porte de garage enroulable, maximum de gain d'espace</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              Équipée d'un <strong class="text-[var(--color-fg)]">coffre dans lequel s'enroulent les lames</strong>, comme un volet roulant. Ouverture verticale : elle ne déborde ni à l'intérieur, ni à l'extérieur, et libère entièrement le plafond.
            </p>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Design sobre et épuré</li>
              <li>• Large choix de coloris classiques ou originaux</li>
              <li>• Motorisation discrète, enroulement silencieux</li>
              <li>• Lames aluminium isolées, coffre compact</li>
            </ul>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <!-- Motorisation -->
  <section class="section-tight">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Motorisation de votre porte de garage</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Spécialiste des ouvertures de la maison, Fenêtres sur Loir installe la <strong class="text-[var(--color-fg)]">motorisation</strong> de votre porte de garage neuve — et, lorsque la porte existante est en bon état, celle d'une porte déjà en place.
        </p>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Toutes nos portes motorisées sont équipées d'un <strong class="text-[var(--color-fg)]">arrêt sur obstacle avec remontée automatique</strong> et d'un <strong class="text-[var(--color-fg)]">déverrouillage manuel</strong> en cas de coupure de courant, pour une protection optimale de vos proches et de votre véhicule.
        </p>

        <div class="mt-6 grid sm:grid-cols-3 gap-4">
          <div class="bg-[var(--color-tint)] rounded-xl p-4 text-center">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-white text-[var(--color-accent)]" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <p class="mt-2 text-sm font-semibold text-[var(--color-fg)]">Sécurité maximale</p>
            <p class="mt-1 text-xs text-[var(--color-muted)]">Arrêt sur obstacle + remontée auto</p>
          </div>
          <div class="bg-[var(--color-tint)] rounded-xl p-4 text-center">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-white text-[var(--color-accent)]" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/>
                <line x1="22" x2="16" y1="9" y2="15"/>
                <line x1="16" x2="22" y1="9" y2="15"/>
              </svg>
            </span>
            <p class="mt-2 text-sm font-semibold text-[var(--color-fg)]">Silencieuse</p>
            <p class="mt-1 text-xs text-[var(--color-muted)]">Motorisation discrète</p>
          </div>
          <div class="bg-[var(--color-tint)] rounded-xl p-4 text-center">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-white text-[var(--color-accent)]" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                <path d="M12 18h.01"/>
              </svg>
            </span>
            <p class="mt-2 text-sm font-semibold text-[var(--color-fg)]">Connectée</p>
            <p class="mt-1 text-xs text-[var(--color-muted)]">Compatible domotique</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Prix & zone d'intervention -->
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="prose-fsl max-w-3xl mx-auto">
        <h2>Aides et TVA pour une porte de garage</h2>
        <p>
          La porte de garage seule n'ouvre pas droit aux aides à la rénovation énergétique (MaPrimeRénov', primes CEE), mais elle bénéficie de la <strong>TVA réduite à 10 %</strong> dans un logement de plus de deux ans. Si vous changez aussi vos <a href="/solutions/portes-fenetres/fenetres/">fenêtres</a> ou votre <a href="/solutions/portes-fenetres/portes-entree/">porte d'entrée</a>, nous étudions le projet dans son ensemble pour mobiliser les aides sur les postes éligibles.
        </p>

        <h2>Un installateur de portes de garage près de chez vous</h2>
        <p>
          Depuis nos agences de <strong>Seiches-sur-le-Loir</strong> et de <strong>Doué-en-Anjou</strong>, nous posons des portes de garage à <a href="/menuisier-angers/">Angers</a> et dans toute son agglomération (Avrillé, Beaucouzé, Trélazé, Saint-Barthélemy-d'Anjou, Les Ponts-de-Cé), à <a href="/menuisier-saumur/">Saumur</a>, <a href="/menuisier-cholet/">Cholet</a>, Baugé-en-Anjou, Durtal, La Flèche et dans tout le <a href="/zones-intervention/">Maine-et-Loire</a>. La prise de mesures se fait à domicile, le devis est gratuit, et la pose est réalisée par nos équipes salariées, certifiées RGE Qualibat — jamais en sous-traitance.
        </p>
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="section-tight">
    <Container width="default">
      <div class="prose-fsl max-w-3xl mx-auto">
        <h2>Questions fréquentes sur les portes de garage</h2>
        {faq.map((f) => (
          <>
            <h3>{f.question}</h3>
            <p>{f.reponse}</p>
          </>
        ))}
      </div>
    </Container>
  </section>

  <!-- Découvrir aussi -->
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)] mb-4">
        Découvrir aussi
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-3">
        <li><a href="/solutions/portes-fenetres/portes-entree/" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Porte d'entrée</a></li>
        <li><a href="/solutions/confort-exterieur/portails-portillons/" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Portails & portillons</a></li>
        <li><a href="/solutions/confort-exterieur/carports-marquises/" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Carports & marquises</a></li>
        <li><a href="/solutions/portes-fenetres/volets/" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Volets roulants</a></li>
      </ul>
    </Container>
  </section>

  <ConseilsLies
    slugs={["volet-roulant-bloque-que-faire", "changer-fenetres-avant-hiver", "aides-changer-fenetres-2026"]}
    titre="Nos conseils pour vos fermetures"
  />

  <CTASection
    title="Une porte de garage adaptée à votre maison"
    text="Sectionnelle, latérale ou enroulable : nos conseillers étudient les contraintes de votre garage et vous proposent la meilleure solution, devis gratuit à l'appui."
    secondaryLabel="Visiter le showroom"
    secondaryHref="/entreprise/notre-histoire/#showroom"
  />
</BaseLayout>
