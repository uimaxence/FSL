---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/ui/Container.astro";
import CTASection from "../../../components/sections/CTASection.astro";
import CertificationsBanner from "../../../components/sections/CertificationsBanner.astro";
import AidsBox from "../../../components/sections/AidsBox.astro";

import garageHero from "../../../assets/carport-1.png";
import garageSectionnelle from "../../../assets/porte-1-boisalu.png";
import garageLaterale from "../../../assets/porte-2-boisalu.png";
import garageEnroulable from "../../../assets/porte-4-alu.png";

const title = "Porte de garage sectionnelle, latérale, enroulable | Fenêtres sur Loir près d'Angers";
const description = "Installateur de portes de garage sur Angers et environs depuis 2003. Sectionnelles, latérales, enroulables avec motorisation, isolation thermique et sécurité.";

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Nos solutions", href: "/solutions/confort-interieur" },
  { label: "Portes & Fenêtres", href: "/solutions/portes-fenetres" },
  { label: "Porte de garage" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Porte de garage sur mesure",
  description,
  brand: { "@type": "Organization", name: "Fenêtres sur Loir" },
};
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb} schemaJsonLd={schema}>
  <!-- Hero -->
  <section class="section-tight">
    <Container width="wide">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-6">
          <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
            Portes & Fenêtres → Porte de garage
          </p>
          <h1 class="text-balance">
            Portes de garage <strong class="font-bold">sur mesure</strong> : sectionnelle, latérale ou enroulable
          </h1>
          <p class="mt-5 text-[15px] leading-relaxed text-[var(--color-muted)]">
            Votre garage est une véritable extension de votre maison, méritant ainsi une isolation adéquate et une sécurité optimale. Chaque garage est unique : certains sont étroits, d'autres bas de plafond ou encombrés de tuyauterie.
          </p>
          <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-muted)]">
            <strong class="text-[var(--color-fg)]">Fenêtres sur Loir</strong>, basé à <a href="/entreprise/notre-histoire#showroom" class="text-[var(--color-accent)] underline underline-offset-4">Seiches-sur-le-Loir près d'Angers</a>, vous propose des portes de garage adaptées à toutes les configurations, conçues pour durer.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/contact" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium text-white shadow-sm" style="background: var(--color-accent);">
              Demander un devis
            </a>
            <a href="#types" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium border border-[var(--color-fg)] text-[var(--color-fg)]">
              Voir les types
            </a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={garageHero}
              alt="Porte de garage sectionnelle sur mesure installée par Fenêtres sur Loir près d'Angers"
              widths={[500, 800, 1100]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              loading="eager"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <CertificationsBanner />

  <!-- Types de portes de garage -->
  <section id="types" class="section-tight bg-[var(--color-subtle)] scroll-mt-28">
    <Container width="default">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2>Trois types de portes de garage adaptés à votre maison</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Selon vos contraintes d'espace, vos besoins de motorisation et votre style architectural, nous vous orientons vers la meilleure option.
        </p>
      </div>

      <div class="max-w-5xl mx-auto space-y-12">
        <!-- Sectionnelle -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={garageSectionnelle}
              alt="Porte de garage sectionnelle motorisée — gris anthracite avec hublots"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={82}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div>
            <h3 class="text-[var(--color-accent)]">Porte de garage sectionnelle près d'Angers</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              <strong class="text-[var(--color-fg)]">Gain d'espace et design contemporain.</strong> Parfaitement adaptée aux garages de taille réduite, elle colle au plus près des parois et occupe très peu d'espace.
            </p>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Très bonne isolation thermique</li>
              <li>• Motorisation pour ouverture rapide et simple</li>
              <li>• Large choix d'accessoires, coloris, formes de hublots</li>
              <li>• Sécurisée, robuste, esthétique</li>
            </ul>
          </div>
        </article>

        <!-- Latérale -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2 rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={garageLaterale}
              alt="Porte de garage sectionnelle latérale — ouverture coulissante sur le côté"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={82}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div class="md:order-1">
            <h3 class="text-[var(--color-accent)]">Porte de garage sectionnelle latérale</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              Idéale si vous souhaitez <strong class="text-[var(--color-fg)]">conserver vos rangements en hauteur</strong> ou contourner une contrainte de plafond.
            </p>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Accès piéton facile sans ouverture complète</li>
              <li>• Pratique pour récupérer un objet ou sortir la tondeuse</li>
              <li>• Compatible avec les motorisations standard</li>
              <li>• Choix de finitions et coloris personnalisés</li>
            </ul>
          </div>
        </article>

        <!-- Enroulable -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={garageEnroulable}
              alt="Porte de garage enroulable — coffre compact, lames métalliques verticales"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={82}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div>
            <h3 class="text-[var(--color-accent)]">Porte de garage enroulable, maximum de gain d'espace</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              Équipée d'un <strong class="text-[var(--color-fg)]">coffre dans lequel s'enroulent les lames</strong>. Ouverture verticale : ne déborde ni à l'intérieur, ni à l'extérieur.
            </p>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Design sobre et épuré</li>
              <li>• Large choix de coloris classiques ou originaux</li>
              <li>• Motorisation discrète, enroulement silencieux</li>
              <li>• Isolation très performante</li>
            </ul>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <!-- Motorisation -->
  <section class="section-tight">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Motorisation de vos portes de garage</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Spécialiste des ouvertures de votre maison, Fenêtres sur Loir est le partenaire incontournable de votre projet. Pour un maximum de confort et de sécurité, nous installons la <strong class="text-[var(--color-fg)]">motorisation</strong> de votre porte de garage.
        </p>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Toutes nos portes sont équipées d'un <strong class="text-[var(--color-fg)]">système d'arrêt sur obstacle avec remontée automatique</strong>, garantissant une protection optimale pour vos proches.
        </p>

        <div class="mt-6 grid sm:grid-cols-3 gap-4">
          <div class="bg-[var(--color-tint)] rounded-xl p-4 text-center">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-white text-[var(--color-accent)]" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <p class="mt-2 text-sm font-semibold text-[var(--color-fg)]">Sécurité maximale</p>
            <p class="mt-1 text-xs text-[var(--color-muted)]">Arrêt sur obstacle + remontée auto</p>
          </div>
          <div class="bg-[var(--color-tint)] rounded-xl p-4 text-center">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-white text-[var(--color-accent)]" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/>
                <line x1="22" x2="16" y1="9" y2="15"/>
                <line x1="16" x2="22" y1="9" y2="15"/>
              </svg>
            </span>
            <p class="mt-2 text-sm font-semibold text-[var(--color-fg)]">Silencieux</p>
            <p class="mt-1 text-xs text-[var(--color-muted)]">Motorisation discrète</p>
          </div>
          <div class="bg-[var(--color-tint)] rounded-xl p-4 text-center">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-white text-[var(--color-accent)]" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                <path d="M12 18h.01"/>
              </svg>
            </span>
            <p class="mt-2 text-sm font-semibold text-[var(--color-fg)]">Connectée</p>
            <p class="mt-1 text-xs text-[var(--color-muted)]">Compatible domotique</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <AidsBox />

  <!-- Conclusion -->
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-[15px] text-[var(--color-muted)] leading-relaxed">
          Vous hésitez encore sur le type de porte de garage pour votre maison ? L'équipe de Fenêtres sur Loir se fera un plaisir d'imaginer et concrétiser le projet avec vous. Certifiés <strong class="text-[var(--color-fg)]">RGE Qualibat</strong>, vous aurez peut-être droit à des aides financières dans le cadre du dispositif pour le changement des menuiseries extérieures.
        </p>
      </div>
    </Container>
  </section>

  <!-- Découvrir aussi -->
  <section class="section-tight">
    <Container width="default">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)] mb-4">
        Découvrir aussi
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-3">
        <li><a href="/solutions/portes-fenetres/portes-entree" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Porte d'entrée</a></li>
        <li><a href="/solutions/portes-fenetres/porte-fenetre" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Porte-fenêtre</a></li>
        <li><a href="/solutions/portes-fenetres/portes-interieures" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Portes intérieures</a></li>
      </ul>
    </Container>
  </section>

  <CTASection
    title="Une porte de garage adaptée à votre maison"
    text="Sectionnelle, latérale ou enroulable : nos conseillers étudient les contraintes de votre garage et vous proposent la meilleure solution."
    secondaryLabel="Visiter le showroom"
    secondaryHref="/entreprise/notre-histoire#showroom"
  />
</BaseLayout>
