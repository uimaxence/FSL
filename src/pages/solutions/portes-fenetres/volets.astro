---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageProduit from "../../../components/templates/PageProduit.astro";
import Container from "../../../components/ui/Container.astro";
import ConseilsLies from "../../../components/sections/ConseilsLies.astro";
import voletHero from "../../../assets/realisation-pontsdece-1.png";

// SEO (14/09/2026) : « volet roulant angers » / « volets roulants angers »
// (90 rech./mois chacun, KD 0) + « volet roulant maine et loire ». La page ne
// sortait que sur 27 impressions/12 mois. La SERP locale mêle installateurs et
// réparateurs (Repar'Stores, Removo, Dokteur Store), et les « autres questions »
// portent sur le prix, la durée de vie et la déductibilité → title/H1 avec
// ville + département, section dépannage/SAV reliée au guide « volet bloqué »,
// FAQ visible + FAQPage.
const title = "Volets roulants à Angers & 49 — Point Conseil Bubendorff";
const description =
  "Pose de volets roulants solaires, électriques et battants à Angers et en Maine-et-Loire. Point Conseil Bubendorff, SAV direct, artisan RGE Qualibat. Devis gratuit.";

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Nos solutions", href: "/solutions/confort-interieur/" },
  { label: "Portes & Fenêtres", href: "/solutions/portes-fenetres/" },
  { label: "Volets" },
];

// FAQ : source unique pour le bloc visible ET le FAQPage JSON-LD.
const faq = [
  {
    question: "De quoi dépend le prix d'un volet roulant posé ?",
    reponse:
      "Des dimensions de la baie, du type de coffre (rénovation, tunnel ou bloc-baie), du matériau des lames, de la motorisation — filaire, radio ou solaire — et des options de commande (télécommande, connecté). Le solaire Bubendorff évite tout travail électrique, pas de saignée ni de raccordement au tableau, ce qui compense en grande partie son surcoût à l'achat. Le devis avec prise de mesures à domicile est gratuit.",
  },
  {
    question: "Quelle est la durée de vie d'un volet roulant électrique ?",
    reponse:
      "Un volet roulant motorisé de qualité dure 15 à 25 ans. Les volets Bubendorff sont testés sur 30 000 cycles d'ouverture-fermeture et garantis 7 ans, moteur et batterie compris. Les pièces d'usure — attaches de tablier, condensateur sur les moteurs filaires, batterie sur les solaires — se remplacent sans changer le volet, ce qui prolonge encore sa durée de vie.",
  },
  {
    question: "Les volets roulants sont-ils éligibles aux aides ou déductibles des impôts ?",
    reponse:
      "Posés seuls, non : les volets roulants ne sont plus couverts par MaPrimeRénov' ni par les primes CEE, et le crédit d'impôt a disparu depuis 2021. Dans un logement de plus de deux ans, la fourniture et la pose bénéficient de la TVA réduite à 10 %. Posés en même temps que des fenêtres éligibles par un artisan RGE, ils peuvent sous conditions entrer dans le périmètre de la TVA à 5,5 % au titre des travaux induits et s'intégrer à un éco-prêt à taux zéro : nous étudions le montage financier global de votre projet.",
  },
  {
    question: "Volet roulant solaire ou électrique : lequel choisir ?",
    reponse:
      "En rénovation, le solaire s'impose dans la grande majorité des cas : aucun câblage ni saignée, pose en quelques heures par fenêtre, fonctionnement maintenu en cas de coupure de courant. L'électrique filaire reste pertinent en construction neuve, où les gaines sont prévues, et pour les centralisations complexes. Dans les deux cas, la commande radio et le pilotage par application sont possibles.",
  },
  {
    question: "Mon volet roulant est bloqué, que faire ?",
    reponse:
      "Commencez par les vérifications simples, sans jamais forcer : piles de la télécommande, disjoncteur des volets, protection thermique du moteur (il repart de lui-même après 15 à 30 minutes), lame sortie de sa coulisse. Notre guide « Volet roulant bloqué : que faire ? » détaille le diagnostic panne par panne. Pour les volets Bubendorff que nous avons posés, appelez directement notre SAV à Seiches-sur-le-Loir.",
  },
  {
    question: "Combien de temps dure la pose d'un volet roulant ?",
    reponse:
      "Une demi-journée par fenêtre pour un volet roulant en rénovation, coffre compris ; une maison complète se pose en général en une à deux journées. Nos équipes salariées réalisent la pose, le raccordement ou la mise en service solaire, le paramétrage des télécommandes et le test de chaque commande avec vous.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    provider: { "@id": "https://www.fenetres-sur-loir.fr/#organization" },
    name: "Volets roulants solaires, électriques et connectés Bubendorff",
    serviceType: "Installation de volets roulants",
    brand: { "@type": "Brand", name: "Bubendorff" },
    description,
    areaServed: ["Angers", "Maine-et-Loire", "Saumur", "Doué-en-Anjou", "Seiches-sur-le-Loir"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.reponse },
    })),
  },
];
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb} schemaJsonLd={schema}>
  <PageProduit
    eyebrow="Portes & Fenêtres"
    title="Volets roulants à Angers et en Maine-et-Loire : solaires, électriques, connectés et battants"
    heroPlaceholderLabel="Volet roulant Bubendorff en façade"
    heroImage={voletHero}
    heroImageAlt="Façade équipée de menuiseries et volets roulants posés par Fenêtres sur Loir près d'Angers"
    lead="Point Conseil Bubendorff officiel à Seiches-sur-le-Loir et Doué-en-Anjou, Fenêtres sur Loir installe vos volets roulants, battants et connectés à Angers, Saumur et partout dans le Maine-et-Loire — avec SAV direct, sans intermédiaire."
  >
    <p>
      Le volet est <strong>l'allié quotidien</strong> de votre maison : il protège du froid, du
      soleil, du bruit et des intrusions, tout en habillant votre façade. Chez
      <strong>Fenêtres sur Loir</strong>, nous sommes <strong>Point Conseil officiel Bubendorff</strong>
      — le fabricant français leader des volets roulants — et nous installons toute la gamme
      à Angers, Doué-en-Anjou, Tiercé, Baugé-en-Anjou et dans tout le Maine-et-Loire.
    </p>

    <h2>Tous les types de volets, posés à Angers et dans le 49</h2>
    <ul>
      <li>
        <strong>Volets roulants solaires Bubendorff</strong> — <strong>Aucun raccordement
        électrique nécessaire</strong>. Le panneau solaire intégré au coffre alimente le moteur
        et la batterie. Idéal en <strong>rénovation</strong> : pas de saignée dans les murs, pas
        de tableau électrique à modifier. Installation en quelques heures par fenêtre. Garantie
        7 ans pièces, moteur et batterie.
      </li>
      <li>
        <strong>Volets roulants électriques filaires</strong> — La solution classique pour les
        <strong>constructions neuves</strong> ou les rénovations avec passage de gaines. Moteur
        radio ou filaire, commandes locales ou centralisées, intégration domotique possible.
      </li>
      <li>
        <strong>Volets roulants connectés Bubendorff iD</strong> — Pilotage par smartphone (iOS,
        Android), <strong>compatibles Google Assistant, Alexa et Somfy TaHoma</strong>.
        Programmation horaire, scénarios "départ en vacances", gestion par pièce. Idéal pour
        les maisons RE2020 et les seniors qui veulent automatiser la fermeture du soir.
      </li>
      <li>
        <strong>Volets battants alu et bois</strong> — Pour les maisons de caractère, les
        longères et les biens situés en <strong>zone Architectes des Bâtiments de France</strong>
        (centre historique d'Angers, Saumur, Doué-en-Anjou, secteurs sauvegardés du Maine-et-Loire).
        Disponibles à <strong>persiennes, panneaux pleins ou à barres et écharpes</strong>, en
        aluminium très basse maintenance ou en bois exotique traité.
      </li>
      <li>
        <strong>Volets coulissants alu</strong> — Solution contemporaine pour les baies vitrées
        et grandes ouvertures. Style architectural fort, occultation totale ou partielle selon
        le remplissage choisi.
      </li>
    </ul>

    <h2>Pourquoi nous choisissons Bubendorff</h2>
    <p>
      Notre statut de <strong>Point Conseil Bubendorff</strong> n'est pas un simple label
      commercial : il nous engage à former régulièrement nos équipes au catalogue, aux nouveautés
      et aux gestes techniques de pose. Concrètement, cela signifie pour vous :
    </p>
    <ul>
      <li>
        <strong>Fabrication 100 % française</strong> en Alsace, dans des usines automatisées —
        délais maîtrisés (3 à 5 semaines selon la saison) et qualité constante.
      </li>
      <li>
        <strong>Garantie 7 ans</strong> sur la totalité du volet, moteur et batterie inclus. C'est
        la plus longue garantie du marché sur ce type de produit.
      </li>
      <li>
        <strong>SAV direct par Fenêtres sur Loir</strong> : nous intervenons nous-mêmes sur tous
        les volets Bubendorff que nous avons installés. Pas de centre d'appel, pas d'intermédiaire —
        un numéro, une équipe locale qui connaît votre installation.
      </li>
      <li>
        Compatible avec <strong>toutes nos menuiseries MéO et Arcades & Baies</strong> :
        un coffre unique cohérent sur l'ensemble de la façade.
      </li>
    </ul>
    <p>
      Pour aller plus loin sur la marque, consultez notre <a href="/partenaires/bubendorff/">page
      partenariat Bubendorff</a>.
    </p>

    <h2>Pose et SAV : la promesse Fenêtres sur Loir</h2>
    <p>
      Tous nos volets sont posés par <strong>nos équipes salariées certifiées RGE Qualibat</strong>,
      jamais en sous-traitance. La pose d'un volet roulant standard prend une demi-journée par
      fenêtre, le temps d'intégrer proprement le coffre, de raccorder le moteur (filaire ou solaire)
      et de tester chaque commande avec vous avant de quitter le chantier.
    </p>
    <p>
      <strong>Après la pose</strong>, nous restons votre interlocuteur unique : si une lame se
      voile, si un moteur faiblit, si la batterie solaire baisse, vous appelez Seiches-sur-le-Loir,
      et c'est l'un de nos techniciens qui passe — pas un sous-traitant national. Ce service de
      proximité est l'une des raisons pour lesquelles nos clients d'Angers, des Ponts-de-Cé, de
      Saumur ou de Tiercé nous recommandent depuis plus de 20 ans.
    </p>

    <h2>Volet roulant bloqué ou en panne : que faire ?</h2>
    <p>
      Un volet qui ne remonte plus, qui ne descend plus ou qui se bloque à mi-hauteur n'est pas
      forcément à remplacer. Piles de télécommande, disjoncteur, protection thermique du moteur,
      lame sortie de sa coulisse : une partie des pannes se règle en quelques minutes, à condition
      de <strong>ne jamais forcer</strong>. Nous avons rassemblé le diagnostic complet, panne par
      panne, dans notre guide
      <a href="/blog/volet-roulant-bloque-que-faire/">Volet roulant bloqué : que faire ?</a>
    </p>
    <p>
      Pour les <strong>volets Bubendorff posés par Fenêtres sur Loir</strong>, notre SAV prend le
      relais : diagnostic, pièces, batterie ou moteur sous garantie 7 ans. Pour un volet ancien
      d'une autre marque, nous vous disons honnêtement si une réparation vaut le coup ou si un
      remplacement — souvent par un volet solaire, sans travaux électriques — est plus raisonnable.
    </p>

    <h2>Aides à la rénovation pour vos volets</h2>
    <p>
      Le remplacement de volets seul n'est pas éligible à MaPrimeRénov' ni aux primes CEE, qui
      ciblent les menuiseries vitrées et l'isolation. Il bénéficie en revanche de la
      <strong>TVA réduite à 10 %</strong> dans un logement de plus de deux ans. Et un
      <strong>changement combiné fenêtres + volets</strong> permet d'aller plus loin :
    </p>
    <ul>
      <li><strong>TVA à 5,5 %</strong>, sous conditions, sur la fourniture et la pose des volets réalisées en même temps que vos fenêtres dans une logique d'amélioration énergétique (travaux induits).</li>
      <li><strong>Certificats d'Économies d'Énergie (CEE)</strong> sur les fenêtres de l'opération globale.</li>
      <li>Éco-prêt à taux zéro inclus dans un bouquet de travaux RGE.</li>
    </ul>
    <p>
      Nous étudions votre projet dans son ensemble pour optimiser le montage financier — n'hésitez
      pas à demander un devis combiné, et consultez notre
      <a href="/blog/aides-changer-fenetres-2026/">guide des aides 2026</a>.
    </p>

    <h2>Notre zone d'intervention</h2>
    <p>
      Nos équipes interviennent à <a href="/menuisier-angers/">Angers</a> et dans son agglomération (Avrillé,
      Beaucouzé, Trélazé, Saint-Barthélemy-d'Anjou, Les Ponts-de-Cé), à <strong>Doué-en-Anjou</strong>,
      <a href="/menuisier-saumur/">Saumur</a>, <strong>Tiercé</strong>, <strong>Baugé-en-Anjou</strong>,
      <strong>Durtal</strong>, <strong>Châteauneuf-sur-Sarthe</strong>,
      <strong>Le Lion-d'Angers</strong>, <strong>Beaufort-en-Anjou</strong>,
      <strong>La Flèche</strong> et dans toutes les communes du <a href="/zones-intervention/">Maine-et-Loire</a>
      et du sud-Sarthe. Notre <a href="/agences/doue-en-anjou/">agence de Doué-en-Anjou</a> couvre le sud
      du département et le Saumurois.
    </p>

    <h2>Questions fréquentes sur les volets roulants</h2>
    {faq.map((f) => (
      <>
        <h3>{f.question}</h3>
        <p>{f.reponse}</p>
      </>
    ))}
  </PageProduit>

  <section class="pb-20">
    <Container width="default">
      <div class="max-w-3xl mx-auto flex flex-wrap gap-3 justify-center">
        <a href="/contact/" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium text-white shadow-sm" style="background: var(--color-accent);">
          Demander un devis gratuit
        </a>
        <a href="/partenaires/bubendorff/" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium border border-[var(--color-fg)] text-[var(--color-fg)]">
          Découvrir Bubendorff
        </a>
      </div>
    </Container>
  </section>
  <ConseilsLies
    slugs={["volet-roulant-bloque-que-faire", "reinitialiser-volet-roulant-bubendorff", "aides-changer-fenetres-2026"]}
    titre="Nos conseils sur les volets roulants"
  />

</BaseLayout>
