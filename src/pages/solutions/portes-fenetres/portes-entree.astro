---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/ui/Container.astro";
import CTASection from "../../../components/sections/CTASection.astro";
import CertificationsBanner from "../../../components/sections/CertificationsBanner.astro";
import AidsBox from "../../../components/sections/AidsBox.astro";

import porteHero from "../../../assets/porte-1-boisalu.png";
import porteMixte from "../../../assets/porte-1-boisalu.png";
import porteMixte2 from "../../../assets/porte-2-boisalu.png";
import portePvc from "../../../assets/porte-3-PVC.png";
import porteAlu from "../../../assets/porte-4-alu.png";
import porteAlu2 from "../../../assets/porte-5-alu.png";
import porteBois from "../../../assets/porte-6-bois.png";

// Mot-clé en tête de title (l'ancien libellé commençait par la marque, le
// mot-clé arrivait au 46ᵉ caractère — page bloquée pos. ~27 sur
// « porte d'entrée angers »).
const title = "Porte d'entrée sur mesure à Angers — Alu, bois, PVC & mixte";
const description =
  "Portes d'entrée sur mesure aluminium, bois, PVC et bois-alu à Angers et en Maine-et-Loire. Serrures multipoints, isolation renforcée, marques françaises MéO et Arcades & Baies. Devis gratuit.";

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Nos solutions", href: "/solutions/confort-interieur/" },
  { label: "Portes & Fenêtres", href: "/solutions/portes-fenetres/" },
  { label: "Porte d'entrée" },
];

// FAQ : source unique alimentant le bloc visible ET le FAQPage JSON-LD.
// Cible « prix porte d'entrée », « alu ou pvc », sécurité, délais — requêtes
// PAA constatées sur la SERP et fortes en réponses IA (GEO).
const faq = [
  {
    question: "Combien coûte une porte d'entrée sur mesure posée ?",
    reponse:
      "Comptez généralement de 1 500 à 3 000 € pour une porte PVC ou aluminium d'entrée de gamme posée, et de 3 000 à 6 000 € et plus pour une porte aluminium, bois ou mixte bois-alu haut de gamme MéO. Le prix dépend du matériau, du vitrage, du niveau de sécurité et des dimensions. Nous remettons un devis gratuit et détaillé après prise de mesures à domicile.",
  },
  {
    question: "Porte d'entrée aluminium, PVC ou bois : que choisir ?",
    reponse:
      "L'aluminium domine le marché : rigide, sans entretien, disponible dans de nombreux designs contemporains. Le PVC est le plus économique et convient aux budgets maîtrisés. Le bois reste incontournable en secteur protégé (ABF) et pour les maisons de caractère. Le mixte bois-alu combine chaleur intérieure du bois et résistance extérieure de l'aluminium : c'est notre solution haut de gamme MéO.",
  },
  {
    question: "Une porte d'entrée sur mesure est-elle plus sûre ?",
    reponse:
      "Oui. Nos portes sont équipées de série de serrures multipoints (3 à 5 points), de paumelles renforcées et, en option, de vitrages feuilletés retardateurs d'effraction 44.6. Une porte bien posée, sans jeu dans le dormant, est le premier facteur de résistance à l'effraction — c'est pourquoi la pose est réalisée par nos propres équipes.",
  },
  {
    question: "Quelles aides pour changer sa porte d'entrée en 2026 ?",
    reponse:
      "Les aides à la rénovation énergétique (MaPrimeRénov', CEE) ciblent aujourd'hui en priorité les fenêtres ; la porte d'entrée seule n'y est plus éligible. En rénovation d'un logement de plus de deux ans, vous bénéficiez en revanche de la TVA réduite sur la fourniture et la pose. Nous faisons le point sur les dispositifs applicables à votre projet lors du devis.",
  },
  {
    question: "Quel délai entre la commande et la pose d'une porte d'entrée ?",
    reponse:
      "Une porte sur mesure MéO ou Arcades & Baies est fabriquée en France en 6 à 10 semaines selon la gamme et les options. La pose elle-même prend une demi-journée à une journée, dépose de l'ancienne porte et finitions comprises, dans tout le Maine-et-Loire.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    provider: { "@id": "https://www.fenetres-sur-loir.fr/#organization" },
    name: "Porte d'entrée sur mesure",
    brand: [
      { "@type": "Brand", name: "MéO" },
      { "@type": "Brand", name: "Arcades & Baies" },
    ],
    description,
    image: porteHero.src,
    areaServed: ["Angers", "Maine-et-Loire", "Doué-en-Anjou", "Seiches-sur-le-Loir", "Saumur"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.reponse },
    })),
  },
];
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb} schemaJsonLd={schema}>
  <!-- Hero -->
  <section class="section-tight">
    <Container width="wide">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-6">
          <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
            Portes & Fenêtres → Porte d'entrée
          </p>
          <h1 class="text-balance">
            <strong class="font-bold">Porte d'entrée sur mesure à Angers</strong> : aluminium, bois, PVC et mixte
          </h1>
          <p class="mt-5 text-[15px] leading-relaxed text-[var(--color-muted)]">
            Fenêtres sur Loir conseille, fournit et pose vos portes d'entrée sur mesure à Angers, Saumur et dans tout le Maine-et-Loire. Sécurité, isolation et design : chaque porte est une promesse de qualité, choisie en showroom et posée par nos propres équipes.
          </p>
          <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-muted)]">
            Nous avons fait le choix de grandes marques françaises — <a href="/partenaires/meo/" class="text-[var(--color-accent)] underline underline-offset-4">MéO</a> et <a href="/partenaires/arcades-et-baies/" class="text-[var(--color-accent)] underline underline-offset-4">Arcades & Baies</a> — pour leur qualité et leurs possibilités de personnalisation sur-mesure. Certifiés <strong class="text-[var(--color-fg)]">RGE Qualibat</strong>, nous vous accompagnons à chaque étape depuis plus de 20 ans.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/contact/" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium text-white shadow-sm" style="background: var(--color-accent);">
              Demander un devis
            </a>
            <a href="#modeles" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium border border-[var(--color-fg)] text-[var(--color-fg)]">
              Voir les modèles
            </a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={porteHero}
              alt="Porte d'entrée bois massif sur mesure MéO installée par Fenêtres sur Loir près d'Angers"
              widths={[500, 800, 1100]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              loading="eager"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/5] object-cover"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <CertificationsBanner />

  <!-- Quelle porte d'entrée choisir ? -->
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Quelle porte d'entrée choisir ?</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Quatre critères clés guident votre choix. Nos conseillers vous orientent vers la solution la mieux adaptée à votre habitat.
        </p>

        <div class="mt-8 grid sm:grid-cols-2 gap-5">
          <div class="bg-white rounded-xl p-5 ring-1 ring-[var(--color-border)]">
            <h3 class="text-base">🌡️ Isolation</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">
              Thermique et phonique : régulez la température intérieure, réduisez vos factures d'énergie et préservez votre tranquillité.
            </p>
          </div>
          <div class="bg-white rounded-xl p-5 ring-1 ring-[var(--color-border)]">
            <h3 class="text-base">🔒 Sécurité</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">
              Matériaux robustes (aluminium, bois massif) et systèmes de verrouillage fiables : serrures multipoints, vitrages anti-effraction.
            </p>
          </div>
          <div class="bg-white rounded-xl p-5 ring-1 ring-[var(--color-border)]">
            <h3 class="text-base">☀️ Luminosité</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">
              Vitrages clairs ou vitraux contemporains : laissez entrer la lumière naturelle et créez une atmosphère accueillante.
            </p>
          </div>
          <div class="bg-white rounded-xl p-5 ring-1 ring-[var(--color-border)]">
            <h3 class="text-base">🎨 Design</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">
              Finitions personnalisées, couleurs et accessoires (poignée, vantaux, cadre apparent, vitrage) — votre style, votre projet.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Choix des matériaux -->
  <section class="section-tight">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Choix des matériaux : bois-alu, alu, PVC, bois</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Le matériau influence non seulement l'esthétique, mais aussi la durabilité et l'efficacité énergétique. Chaque option a ses propres avantages.
        </p>
      </div>

      <div class="max-w-5xl mx-auto mt-10 space-y-12">
        <!-- Bois-Alu -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={porteMixte}
              alt="Porte d'entrée mixte bois-aluminium MéO chaleur du bois intérieur et résistance alu extérieur"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div>
            <h3 class="text-[var(--color-accent)]">Les portes mixte Bois-Aluminium</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              Combinant le charme du bois à l'intérieur et la résistance de l'aluminium à l'extérieur, elles offrent le meilleur des deux mondes. Esthétique chaleureuse, durabilité, faible entretien et performance énergétique optimisée.
            </p>
            <p class="mt-3 text-sm text-[var(--color-muted)]">
              Idéal pour les projets <strong class="text-[var(--color-fg)]">RE2020 et BBC</strong>.
            </p>
          </div>
        </article>

        <!-- PVC -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2 rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={portePvc}
              alt="Porte d'entrée PVC blanc Fenêtres sur Loir économique et fonctionnelle"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div class="md:order-1">
            <h3 class="text-[var(--color-accent)]">Les portes PVC</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              Option économique et très fonctionnelle. Léger, facile à entretenir, bonne isolation, disponible dans de nombreuses couleurs et finitions. Particulièrement adapté aux environnements humides — ni corrosion, ni déformation.
            </p>
            <p class="mt-3 text-sm text-[var(--color-muted)]">
              Excellent <strong class="text-[var(--color-fg)]">rapport qualité-prix</strong>.
            </p>
          </div>
        </article>

        <!-- Alu -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={porteAlu}
              alt="Porte d'entrée aluminium design contemporain Arcades & Baies sur mesure"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div>
            <h3 class="text-[var(--color-accent)]">Les portes Aluminium</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              Reconnu pour sa robustesse et sa résistance aux intempéries, l'aluminium est facile à entretenir, ne rouille pas et conserve sa couleur dans le temps. Une grande variété de styles modernes et de couleurs pour une esthétique contemporaine.
            </p>
            <p class="mt-3 text-sm text-[var(--color-muted)]">
              Souvent utilisé pour des <strong class="text-[var(--color-fg)]">ouvrants larges</strong> et lumineux.
            </p>
          </div>
        </article>

        <!-- Bois -->
        <article class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2 rounded-2xl overflow-hidden ring-1 ring-[var(--color-border)]">
            <Image
              src={porteBois}
              alt="Porte d'entrée bois massif sur mesure chaleur et élégance Fenêtres sur Loir"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={80}
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </div>
          <div class="md:order-1">
            <h3 class="text-[var(--color-accent)]">Les portes bois</h3>
            <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed">
              Le bois est un choix classique qui apporte chaleur et élégance. Personnalisable (teinté, peint), excellent isolant naturel thermique et phonique. Nos solutions techniques permettent de remplacer vos menuiseries en <strong class="text-[var(--color-fg)]">zones classées Bâtiments de France</strong>.
            </p>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <!-- Isolation & RGE -->
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Le choix de la porte d'entrée pour une bonne isolation, avec un artisan certifié RGE</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          L'isolation est un aspect crucial. Chaque porte que nous proposons est dotée d'un <strong class="text-[var(--color-fg)]">système d'isolation thermique et acoustique de pointe</strong> : préservation de la chaleur en hiver, fraîcheur en été, réduction significative des nuisances sonores.
        </p>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Grâce à des matériaux innovants et une conception soignée, nos portes minimisent les pertes de chaleur et contribuent à l'efficacité énergétique de votre maison. Résultat : économies d'énergie et impact réduit sur l'environnement.
        </p>
      </div>
    </Container>
  </section>

  <AidsBox />

  <!-- Installation pro -->
  <section class="section-tight">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Installation professionnelle et suivi de chantier</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          La qualité de nos produits se reflète dans leur installation. Notre service d'installation est assuré par nos <strong class="text-[var(--color-fg)]">poseurs qualifiés</strong>, qui s'assurent que chaque porte est posée avec précision pour garantir son bon fonctionnement et sa durabilité.
        </p>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Nous restons disponibles même après l'installation pour toute question ou besoin d'assistance — votre satisfaction est notre priorité.
        </p>
      </div>
    </Container>
  </section>

  <!-- 3 modèles à la Une -->
  <section id="modeles" class="section-tight bg-[var(--color-subtle)] scroll-mt-28">
    <Container width="wide">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
          Sélection MéO
        </p>
        <h2>Quelques modèles à la Une</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Trois portes signature de notre partenaire <a href="/partenaires/meo/" class="text-[var(--color-accent)] underline underline-offset-4">MéO</a> que vous pouvez découvrir en showroom.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Manoir -->
        <article class="bg-white rounded-2xl ring-1 ring-[var(--color-border)] overflow-hidden flex flex-col">
          <Image src={porteMixte2} alt="Modèle MéO Privilège Manoir — porte d'entrée monobloc traditionnelle bois-alu" widths={[400, 600, 800]} sizes="(max-width: 768px) 100vw, 33vw" loading="lazy" decoding="async" format="webp" quality={80} class="w-full h-auto aspect-[4/3] object-cover" />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">Traditionnelle · Gamme Privilège</p>
            <h3 class="mt-2 text-lg">MéO Manoir — Monobloc</h3>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Monobloc 89 mm</li>
              <li>• Double ou triple vitrage 44.6 retardateur d'effraction</li>
              <li>• Acoustique jusqu'à 33 dB · Ud jusqu'à 0,7 W/m².K</li>
              <li>• 10 finitions bois · 27 couleurs aluminium</li>
              <li>• Options : grille intégrée, cintre, motif gravé, 1/2 vantaux</li>
            </ul>
          </div>
        </article>

        <!-- Phèdre -->
        <article class="bg-white rounded-2xl ring-1 ring-[var(--color-border)] overflow-hidden flex flex-col">
          <Image src={porteBois} alt="Modèle MéO Légende Phèdre — porte d'entrée bois à cadre apparent" widths={[400, 600, 800]} sizes="(max-width: 768px) 100vw, 33vw" loading="lazy" decoding="async" format="webp" quality={80} class="w-full h-auto aspect-[4/3] object-cover" />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">Traditionnelle · Gamme Légende</p>
            <h3 class="mt-2 text-lg">MéO Phèdre — Cadre apparent</h3>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Cadre apparent 67 mm</li>
              <li>• Double vitrage 44.6 retardateur d'effraction</li>
              <li>• Acoustique jusqu'à 33 dB · Ud 1,4 W/m².K</li>
              <li>• 10 finitions bois · 27 couleurs aluminium</li>
              <li>• Options : vitrage motif décor, petit-bois en applique</li>
            </ul>
          </div>
        </article>

        <!-- Apparence -->
        <article class="bg-white rounded-2xl ring-1 ring-[var(--color-border)] overflow-hidden flex flex-col">
          <Image src={porteAlu2} alt="Modèle MéO Utopie Apparence — porte d'entrée contemporaine aluminium motif gravé" widths={[400, 600, 800]} sizes="(max-width: 768px) 100vw, 33vw" loading="lazy" decoding="async" format="webp" quality={80} class="w-full h-auto aspect-[4/3] object-cover" />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">Contemporaine · Gamme Utopie</p>
            <h3 class="mt-2 text-lg">MéO Apparence — Monobloc</h3>
            <ul class="mt-4 space-y-1 text-sm text-[var(--color-muted)]">
              <li>• Monobloc 89 mm</li>
              <li>• Double ou triple vitrage 44.6 retardateur d'effraction</li>
              <li>• Acoustique jusqu'à 33 dB · Ud jusqu'à 0,8 W/m².K</li>
              <li>• 10 finitions bois (avec motif décor gravé)</li>
              <li>• 27 couleurs aluminium · disponible en cintres</li>
            </ul>
          </div>
        </article>
      </div>

      <p class="text-center mt-8 text-sm text-[var(--color-muted)]">
        Catalogue complet visible en showroom ·
        <a href="https://www.meomenuiserie.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] underline underline-offset-4">
          meomenuiserie.com
        </a>
      </p>
    </Container>
  </section>

  <!-- Découvrir aussi -->
  <section class="section-tight">
    <Container width="default">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)] mb-4">
        Découvrir aussi
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-3">
        <li><a href="/solutions/portes-fenetres/porte-fenetre/" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Porte-fenêtre</a></li>
        <li><a href="/solutions/portes-fenetres/porte-garage/" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Porte de garage</a></li>
        <li><a href="/solutions/portes-fenetres/portes-interieures/" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Portes intérieures</a></li>
        <li><a href="/partenaires/meo/" class="inline-flex items-center px-4 py-2 text-sm bg-white ring-1 ring-[var(--color-border)] rounded-full hover:ring-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">Notre partenariat MéO</a></li>
      </ul>
    </Container>
  </section>

  <!-- FAQ — même source que le FAQPage JSON-LD -->
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Questions fréquentes sur les portes d'entrée</h2>
        <div class="mt-8 space-y-8">
          {faq.map((f) => (
            <div>
              <h3 class="text-base">{f.question}</h3>
