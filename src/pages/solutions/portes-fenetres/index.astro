---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/ui/Container.astro";
import Card from "../../../components/ui/Card.astro";
import CTASection from "../../../components/sections/CTASection.astro";
import CertificationsBanner from "../../../components/sections/CertificationsBanner.astro";
import AidsBox from "../../../components/sections/AidsBox.astro";
import VillesMaillage from "../../../components/sections/VillesMaillage.astro";
import AvantApresScrolly from "../../../components/sections/AvantApresScrolly.astro";

// Photos : une par famille, choisies pour montrer le produit de la carte.
// TODO client : aucune photo de porte de garage dans les ressources du site,
// la carte utilise en attendant un carport aluminium (même univers).
import porteEntreeImg from "../../../assets/porte-1-boisalu.png";
import porteFenetreImg from "../../../assets/porte-fenetre-2.png";
import porteGarageImg from "../../../assets/carport-1.png";
import porteInterieureImg from "../../../assets/porte-2-boisalu.png";
import fenetreImg from "../../../assets/porte-fenetre-5-oscillo.png";
import baieImg from "../../../assets/porte-fenetre-6-gallandage.png";
import voletImg from "../../../assets/hero-3.jpg";

const title = "Portes & fenêtres sur mesure — Angers & Maine-et-Loire (49)";
const description = "Portes d'entrée, porte-fenêtres, portes de garage, fenêtres, baies vitrées et volets sur mesure. Showroom à Seiches-sur-le-Loir, pose dans tout le Maine-et-Loire.";

const breadcrumb = [
  { label: "Accueil", href: "/" },
  { label: "Nos solutions", href: "/solutions/confort-interieur/" },
  { label: "Portes & Fenêtres" },
];

const portes = [
  {
    title: "Porte d'entrée",
    description: "Bois, aluminium, mixte ou PVC — sécurité, isolation et personnalisation infinie.",
    href: "/solutions/portes-fenetres/portes-entree/",
    placeholderLabel: "Porte d'entrée bois-alu sur mesure",
    image: porteEntreeImg,
    imageAlt: "Porte d'entrée contemporaine bois-aluminium posée par Fenêtres sur Loir",
  },
  {
    title: "Porte-fenêtre",
    description: "Classique, moderne, oscillo-battante ou à galandage. Lumière et accès vers l'extérieur.",
    href: "/solutions/portes-fenetres/porte-fenetre/",
    placeholderLabel: "Porte-fenêtre sur mesure",
    image: porteFenetreImg,
    imageAlt: "Porte-fenêtre à petits carreaux ouvrant sur le jardin, posée par Fenêtres sur Loir",
  },
  {
    title: "Porte de garage",
    description: "Sectionnelle, latérale ou enroulable. Motorisation, sécurité et isolation thermique.",
    href: "/solutions/portes-fenetres/porte-garage/",
    placeholderLabel: "Porte de garage sur mesure",
    image: porteGarageImg,
    imageAlt: "Abri aluminium pour véhicule posé par Fenêtres sur Loir",
  },
  {
    title: "Portes intérieures",
    description: "Bois massif, vitrées ou modernes. Confort acoustique et thermique entre les pièces.",
    href: "/solutions/portes-fenetres/portes-interieures/",
    placeholderLabel: "Porte intérieure vitrée moderne",
    image: porteInterieureImg,
    imageAlt: "Porte intérieure bois vitrée installée par Fenêtres sur Loir",
  },
];

const fenetres = [
  {
    title: "Fenêtres",
    description: "Bois, alu, PVC ou mixte. Hautes performances thermiques et acoustiques.",
    href: "/solutions/portes-fenetres/fenetres/",
    placeholderLabel: "Fenêtre sur mesure",
    image: fenetreImg,
    imageAlt: "Fenêtre d'angle bois oscillo-battante sur mesure posée par Fenêtres sur Loir",
  },
  {
    title: "Baies vitrées",
    description: "Grandes ouvertures coulissantes ou à galandage. Seuils PMR sur demande.",
    href: "/solutions/portes-fenetres/baies-vitrees/",
    placeholderLabel: "Baie vitrée coulissante alu",
    image: baieImg,
    imageAlt: "Baie vitrée à galandage grande ouverture sur le jardin, posée par Fenêtres sur Loir",
  },
  {
    title: "Volets",
    description: "Roulants solaires, électriques, connectés ou battants. Partenaire Bubendorff.",
    href: "/solutions/portes-fenetres/volets/",
    placeholderLabel: "Volets sur mesure",
    image: voletImg,
    imageAlt: "Volets battants sur une maison ancienne, posés par Fenêtres sur Loir",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Portes & Fenêtres sur mesure",
  provider: { "@type": "LocalBusiness", name: "Fenêtres sur Loir" },
  itemListElement: [...portes, ...fenetres].map((p) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: p.title, description: p.description },
    url: `https://www.fenetres-sur-loir.fr${p.href}`,
  })),
};
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb} schemaJsonLd={schema}>
  <!-- Hero : séquence « avant / après » pilotée au défilement (textes
       modifiables via les props du composant AvantApresScrolly) -->
  <AvantApresScrolly
    hero
    heading="h1"
    eyebrow="Portes & fenêtres sur mesure · Maine-et-Loire"
    titrePrefixe="Fenêtres, porte d'entrée, volets, pergola :"
    titre="redonnez du"
    titreFort="cachet"
    titreSuite="à votre maison"
    sousTitre="Des menuiseries sur mesure qui transforment une façade sans la dénaturer. Fabriquées en France, posées par nos équipes à Angers, Saumur et dans tout le Maine-et-Loire."
    ctaLabel="Demander un devis gratuit"
    ctaHref="/contact/"
    secondaryLabel="Voir nos réalisations"
    secondaryHref="/realisations/"
  />

  <!-- Intro -->
  <section class="section-tight">
    <Container width="default">
      <div class="max-w-3xl">
        <p class="mb-3 text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-accent)]">
          Portes & Fenêtres
        </p>
        <h2 class="text-balance">
          Fenêtres sur Loir, expert de la menuiserie <strong class="font-bold">sur mesure</strong> depuis 2003
        </h2>
        <p class="mt-5 text-[15px] leading-relaxed text-[var(--color-muted)]">
          Depuis Seiches-sur-le-Loir et Doué-en-Anjou, notre équipe écoute, conseille et installe chaque porte et chaque fenêtre avec un souci du détail qui fait notre signature. Une façade, c'est d'abord ses ouvertures : des menuiseries fatiguées vieillissent toute la maison, les remplacer est le geste de rénovation le plus visible et l'un des plus sensibles au quotidien.
        </p>
        <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-muted)]">
          Nous sélectionnons les meilleures marques françaises — <a href="/partenaires/meo/" class="text-[var(--color-accent)] underline underline-offset-4">MéO</a>, <a href="/partenaires/arcades-et-baies/" class="text-[var(--color-accent)] underline underline-offset-4">Arcades & Baies</a>, <a href="/partenaires/bubendorff/" class="text-[var(--color-accent)] underline underline-offset-4">Bubendorff</a> — pour vous offrir des produits robustes, beaux et durables, posés par nos propres équipes certifiées RGE Qualibat.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact/" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium text-white shadow-sm" style="background: var(--color-accent);">
            Demander un devis
          </a>
          <a href="/entreprise/notre-histoire/#showroom" class="inline-flex items-center rounded-full px-6 py-3 text-[14px] font-medium border border-[var(--color-fg)] text-[var(--color-fg)]">
            Visiter le showroom
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Certifications -->
  <CertificationsBanner />

  <!-- Un type de porte pour chaque espace -->
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2>Un type de porte pour chaque espace de vie</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Chaque porte joue un rôle spécifique dans votre habitat : accueillir, isoler, sécuriser, embellir. Découvrez nos quatre familles de portes et trouvez la solution adaptée à votre projet.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          portes.map((c) => (
            <Card
              title={c.title}
              description={c.description}
              href={c.href}
              placeholderLabel={c.placeholderLabel}
              ratio="4-3"
              image={c.image}
              imageAlt={c.imageAlt}
            />
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Fenêtres & ouvertures -->
  <section class="section-tight">
    <Container width="default">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2>Fenêtres, baies vitrées et volets</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Pour compléter votre projet, Fenêtres sur Loir installe également vos fenêtres, baies vitrées et volets sur mesure — avec les mêmes exigences de qualité.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {
          fenetres.map((c) => (
            <Card
              title={c.title}
              description={c.description}
              href={c.href}
              placeholderLabel={c.placeholderLabel}
              ratio="4-3"
              image={c.image}
              imageAlt={c.imageAlt}
            />
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Showroom & accessoires -->
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="default">
      <div class="max-w-3xl mx-auto">
        <h2>Choix des accessoires visibles dans notre showroom</h2>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          Pour jouer la personnalisation jusqu'au bout, nous proposons un large choix d'accessoires : poignées classiques, pommeaux ou heurtoirs, vitrages imprimés ou décoratifs, portes en simple ou double vantaux, finitions et coloris à l'infini.
        </p>
        <p class="mt-4 text-[15px] text-[var(--color-muted)] leading-relaxed">
          En visitant notre <a href="/entreprise/notre-histoire/#showroom" class="text-[var(--color-accent)] underline underline-offset-4">showroom de 300 m² à quelques pas d'Angers</a>, vous pourrez visualiser les différents modèles et options que nous vous proposons.
        </p>
      </div>
    </Container>
  </section>

  <!-- RGE Qualibat / aides -->
  <AidsBox />

  <VillesMaillage produit="Fenêtres, portes & baies vitrées" />

  <CTASection
    eyebrow="Votre projet"
    title="Discutons de vos portes & fenêtres"
    text="Devis gratuit, conseil personnalisé, visite du showroom : nos équipes vous accompagnent du premier croquis à la pose finale."
    secondaryLabel="Voir nos réalisations"
    secondaryHref="/realisations/"
  />
</BaseLayout>
